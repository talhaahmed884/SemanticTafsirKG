        <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.1/9/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L127" ;
    st:hasText "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ دُونَ نَصْبِهَا الَّذِي يُؤَدِّي إِلَى الدَّلالَةِ عَلَى أَنَّ مَعْنَى تَالِيهِ كَذَلِكَ : أَحْمَدُ اللَّهَ حَمْدًا ، وَلَوْ قَرَأَ قَارِئٌ ذَلِكَ بِالنَّصْبِ ، لَكَانَ عِنْدِي مُحِيلا مَعْنَاهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/bb69f8b3de74> .

