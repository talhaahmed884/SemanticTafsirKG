<http://www.semantictafsir.com/resource/hadith/165/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1437" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/165/text/1/segment/1> ;
    st:hasText "\" اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ : هُوَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَصَاحِبَاهُ مِنْ بَعْدِهِ ؛ أَبُو بَكْرٍ وَعُمَرُ \""@ar ;
    st:references <http://www.semantictafsir.com/resource/hadith/165/text/1/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6> .

<http://www.semantictafsir.com/resource/hadith/165/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1439" ;
    st:hasText "هُوَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَصَاحِبَاهُ مِنْ بَعْدِهِ ؛ أَبُو بَكْرٍ وَعُمَرُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/0bb986bab107>,
        <http://www.semantictafsir.com/resource/entity/person/30096e942778> .

