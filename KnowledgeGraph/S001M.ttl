<http://www.semantictafsir.com/resource/commentary/0.12/3/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L192" ;
    st:hasText """نَأْتِ بِسُعَادَ عَنْكَ نَوَى شَطُونُ
فَبَانَتْ وَالْفُؤَادُ بِهَا رَهِينُ"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.12/3/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L203" ;
    st:hasText """أَيُّمَا شَاطِنٍ عَصَاهُ عَكَاهُ
ثُمَّ يُلْقَى فِي السِّجْنِ وَالأَكبْالِ ."""@ar .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L185" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.12/3/segment/1/segment/1> ;
    st:hasText "سُمِّيَ الْمُتَمَرِّدُ مِنْ كُلِّ شَيْءٍ شَيْطَانًا ؛ لِمُفَارَقَةِ أَخْلاقِهِ وَأَفْعَالِهِ أَخْلاقَ سَائِرِ جِنْسِهِ وَأَفْعَالَهُ ، وَبُعْدِهِ من الْخَيْرِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/khairshar>,
        <http://www.semantictafsir.com/resource/theme/lughawi>,
        <http://www.semantictafsir.com/resource/theme/razail> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/307e1cfa10c8> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L186" ;
    st:hasText "شَيْطَانًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/10> a st:Segment ;
    rdfs:label "Segment 10" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L224" ;
    st:hasText "جبريل"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/mlak> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/11> a st:Segment ;
    rdfs:label "Segment 11" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L225" ;
    st:hasText "الاستعاذة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/asghalamal> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L190" ;
    st:hasText "شَطَنْتُ دَارِي مِنْ دَارِكَ ، يُرِيدُ بِذَلِكَ : بَعُدْتُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L197" ;
    st:hasText "النَّوَى : الْوَجْهُ الَّذِي نَوَتْهُ وَقَصَدَتْهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L198" ;
    st:hasText "الشَّطُونُ : الْبَعِيدُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L200" ;
    st:hasText "الشَّيْطَانَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L208" ;
    st:hasText "لَوْ كَانَ فَعْلانُ مِنْ : شَاطَ يَشِيطُ ، لَقَالَ : أَيُّمَا شَائِطٍ . وَلَكِنَّهُ قَالَ : أَيُّمَا شَاطِنٍ ؛ لأَنَّهُ مِنْ : شَطَنَ يَشْطُنُ ، فَهُوَ شَاطِنٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/7> a st:Segment ;
    rdfs:label "Segment 7" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L211" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.12/3/segment/7/segment/1> ;
    st:hasText "تأويل قوله : الرَّجِيمِ . وأما الرجيم فهو فعيل بمعنى مفعول ، كقول القائل : كف خضيب ، ولحية دهين ، ورجل لعين ، يريد بذلك : مخضوبة ، ومدهونة ، وملعون"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/7/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L213" ;
    st:hasText "ملعون"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/khairshar> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/8> a st:Segment ;
    rdfs:label "Segment 8" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L214" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.12/3/segment/8/segment/1> ;
    st:hasText "تأويل الرجيم : الملعون المشتوم ، وكل مشتوم بقول رديء أو سب فهو مرجوم ، وأصل الرجم الرمي ، بقول كان أو بفعل"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/8/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L214" ;
    st:hasText "الرجيم : الملعون المشتوم ، وكل مشتوم بقول رديء أو سب فهو مرجوم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/khairshar>,
        <http://www.semantictafsir.com/resource/theme/razail> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/9> a st:Segment ;
    rdfs:label "Segment 9" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L219" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.12/3/segment/9/segment/1> ;
    st:hasText "قد يجوز أن يكون قيل للشيطان : رجيم ؛ لأن الله جل ثناؤه طرده من سمواته ، ورجمه بالشهب الثواقب"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/4f0b261817d1> .

<http://www.semantictafsir.com/resource/commentary/0.12/3/segment/9/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L220" ;
    st:hasText "شيطان"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/0.12/5> a st:Commentary ;
    rdfs:label "Commentary 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L250" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/122> ;
    st:hasCommentaryNo 5 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/58147> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/184> .

<http://www.semantictafsir.com/resource/commentary/0.14/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L271" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.14/1/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.14/1/segment/1/segment/2> ;
    st:hasText "بِسْمِ اللَّهِ . مقتضية فعلا يَكُون لها جالبا ، وَلَا فعل معها ظاهر"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1/fragment/4451ad4b0074> .

<http://www.semantictafsir.com/resource/commentary/0.14/1/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L272" ;
    st:hasText "فعلا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/1/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L273" ;
    st:hasText "فعل"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/1/segment/10> a st:Segment ;
    rdfs:label "Segment 10" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L290" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.14/1/segment/10/segment/1> ;
    st:hasText "قوله : باسم اللهِ . عِنْد نهوضه للقيام أَوْ عِنْد قعوده وسائر أفعاله ، ينبئ عَنْ معنى مراده بقوله : باسم اللهِ . وأنه أراد بقيله : باسم الله : أقوم باسم الله ، وأقعد باسم الله . وكذلك سائر الأفعال"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.14/1/segment/10/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L293" ;
    st:hasText "الأفعال"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

