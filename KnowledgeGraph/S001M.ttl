    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/8/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2092" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/8/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.13/8/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.13/8/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.13/8/segment/1/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/1.13/8/segment/1/segment/5>,
        <http://www.semantictafsir.com/resource/commentary/1.13/8/segment/1/segment/6> ;
    st:hasText "و كَانَتْ بمعنى ( إلا ) التي هِيَ استثناء ، وَلَم يجز أن يَكُون أيضا عطفا عَلَيْهَا لو كَانَتْ بمعنى ( سوى ) ، وكانت ( لا ) موجودة عطفا بالواو التي هِيَ عاطفة لها عَلَى ما قبلها ، صح وثبت ألا وجه لـ غَيْرِ التي مَعَ : الْمَغْضُوبِ عَلَيْهِمْ يجوز توجيهها إِلَيْهِ عَلَى صحة ، إِلا بمعنى الجحد والنفي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/0a35d7b453b3>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/46cbac6c92de> .

