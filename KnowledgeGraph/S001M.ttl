<http://www.semantictafsir.com/resource/hadith/124/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L416" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/124/text/1/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/124/text/1/segment/2>,
        <http://www.semantictafsir.com/resource/hadith/124/text/1/segment/3>,
        <http://www.semantictafsir.com/resource/hadith/124/text/1/segment/4>,
        <http://www.semantictafsir.com/resource/hadith/124/text/1/segment/5> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/116> ;
    st:hasText "أَوَّلُ مَا نَزَلَ جِبْرِيلُ عَلَى مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يَا مُحَمَّدُ ، قُلْ أَسْتَعِيذُ بِالسَّمِيعِ الْعَلِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ ، ثُمَّ قَالَ : قُلْ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ، قَالَ ابْنُ عَبَّاسٍ : بِسْمِ اللَّهِ ، يَقُولُ لَهُ جِبْرِيلُ : يَا مُحَمَّدُ ، اقْرَأْ بِذِكْرِ اللَّهِ رَبِّكِ ، وَقُمْ وَاقْعُدْ بِذِكْرِ اللَّهِ \""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/37af5e4fa73b>,
        <http://www.semantictafsir.com/resource/entity/other/889d71ecaae5>,
        <http://www.semantictafsir.com/resource/entity/person/29a82ea13b18>,
        <http://www.semantictafsir.com/resource/entity/person/4ce9591136a3> ;
    st:references <http://www.semantictafsir.com/resource/hadith/124/text/1/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/hadith/124/text/1/thematic-reference/2> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1>,
        <http://www.semantictafsir.com/resource/quran/verse/1/1/fragment/4451ad4b0074> .

