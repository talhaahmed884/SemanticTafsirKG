    rdfs:label "Chain Link 5" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/141> a hadith:Hadith ;
    rdfs:label "Hadith 141" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L321" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/140> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/141/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/141/segment/1> ;
    st:hasHadithNo 141 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/217> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/141/note/1> ;
    st:hasText "حَدَّثَنِي عَلِيُّ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا مُسْلِمُ بْنُ عَبْدِ الرَّحْمَنِ ، قَالَ : حَدَّثَنَا مُحَمَّد بْن مُصْعَبٌ ، عَنْ قَيْسِ بْنِ الرَّبِيعِ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، عَنِ ابْنِ عَبَّاسٍ ، فِي قَوْلِ اللَّهِ : \" رَبِّ الْعَالَمِينَ ، قَالَ : رَبِّ الْجِنِّ وَالإِنْسِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/8cc50c90f535> .

