    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1> .

<http://www.semantictafsir.com/resource/commentary/0.14/13/thematic-reference/2> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L587" ;
