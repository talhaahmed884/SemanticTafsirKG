<http://www.semantictafsir.com/resource/commentary/1.9/6/thematic-reference/1> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1171" ;
    st:hasText "الصِّرَاطَ الْمُسْتَقِيمَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6> .

<http://www.semantictafsir.com/resource/commentary/1.9/7/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1185" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.9/7/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.9/7/segment/1/segment/2> ;
    st:hasText "فِي صِحَّةِ ذَلِكَ فَسَادُ قَوْلِ أَهْلِ الْقَدَرِ الزَّاعِمِينَ أَنَّ كُلَّ مَأْمُورٍ بِأَمْرٍ أَوْ مُكَلَّفٍ فَرْضًا ، فَقَدْ أُعْطِيَ مِنَ الْمَعُونَةِ عَلَيْهِ مَا قَدِ ارْتَفَعَتْ مَعَهُ فِي ذَلِكَ الْفَرْضِ حَاجَتُهُ إِلَى رَبِّهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> .

<http://www.semantictafsir.com/resource/commentary/1.9/7/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1186" ;
    st:hasText "أَهْلِ الْقَدَرِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/firaq> .

<http://www.semantictafsir.com/resource/commentary/1.9/7/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1189" ;
    st:hasText "الْفَرْضِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/fiqhterm> .

<http://www.semantictafsir.com/resource/commentary/1.9/7/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1190" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.9/7/segment/2/segment/1> ;
    st:hasText "لأَنَّهُ لَوْ كَانَ الأَمْرُ عَلَى مَا قَالُوا فِي ذَلِكَ لَبَطَلَ مَعْنَى قَوْلِ اللَّهِ جَلَّ ثَنَاؤُهُ : إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> .

<http://www.semantictafsir.com/resource/commentary/1.9/7/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1192" ;
    st:hasText "الصِّرَاطَ الْمُسْتَقِيمَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1207" ;
    st:hasText """لَعِبَتْ بَعْدِي السُّيُولُ بِهِ
وَجَرَى فِي رَوْنَقٍ رِهَمُهْ
لِلْفَتَى عَقْلٌ يَعِيشُ بِهِ
حَيْثُ تَهْدِي سَاقَهُ قَدَمُهْ"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.9/8/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1197" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.9/8/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.9/8/segment/1/segment/2> ;
    st:hasText "أَسْلِكْنَا طَرِيقَ الْجَنَّةِ فِي الْمَعَادِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1198" ;
    st:hasText "الْجَنَّةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1198" ;
    st:hasText "الْمَعَادِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1199" ;
    st:hasText "قَدِّمْنَا لَهُ وَامْضِ بِنَا إِلَيْهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1202" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.9/8/segment/3/segment/1> ;
    st:hasText "أَدْخِلُوهُمُ النَّارَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/segment/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1203" ;
    st:hasText "النَّارَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1216" ;
    st:hasText "تَرِدُ بِهِ الْمَوَارِدَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/thematic-reference/1> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1196" ;
    st:hasText "الصِّرَاطَ الْمُسْتَقِيمَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6> .

<http://www.semantictafsir.com/resource/commentary/1.9/8/thematic-reference/2> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1201" ;
    st:hasText "الْجَحِيمِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/37/23/fragment/e2b18960269f> .

<http://www.semantictafsir.com/resource/commentary/1.9/9/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1243" ;
    st:hasText """أَسْتَغْفِرُ اللَّهَ ذَنْبًا لَسْتُ مُحْصِيَهُ
رَبَّ الْعِبَادِ إِلَيْهِ الْوَجْهُ وَالْعَمَلُ"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.9/9/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1226" ;
    st:hasText "وَإِيَّاكَ نَسْتَعِينُ . مَسْأَلَةُ الْعَبْدِ رَبَّهُ الْمَعُونَةَ عَلَى عِبَادَتِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/ea2fedd30108> .

<http://www.semantictafsir.com/resource/commentary/1.9/9/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1229" ;
    st:hasText "اهْدِنَا ، إِنَّمَا هُوَ مَسْأَلَتُهُ الثَّبَاتَ عَلَى الْهُدَى فِيمَا بَقِيَ مِنْ عُمْرِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6/fragment/76b6fed7e336> .

<http://www.semantictafsir.com/resource/commentary/1.9/9/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1231" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.9/9/segment/3/segment/1> ;
    st:hasText "الْعَرَبُ تَقُولُ : هَدَيْتُ فُلانًا الطَّرِيقَ ، وَهَدَيْتُهُ لِلطَّرِيقِ ، وَهَدَيْتُهُ إِلَى الطَّرِيقِ : إِذَا أَرْشَدْتَهُ إِلَيْهِ ، وَسَدَّدْتُهُ لَهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

