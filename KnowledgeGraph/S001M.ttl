<http://www.semantictafsir.com/resource/hadith/155> a hadith:Hadith ;
    rdfs:label "Hadith 155" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1096" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.9/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/155/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/155/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/155/segment/2> ;
    st:hasHadithNo 155 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/238> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/155/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، قَالَ : قَالَ جِبْرِيلُ لِمُحَمَّدٍ : \" قُلْ يَا مُحَمَّدُ : اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، يَقُولُ : أَلْهِمْنَا الطَّرِيقَ الْهَادِي \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/889d71ecaae5>,
        <http://www.semantictafsir.com/resource/entity/person/4ce9591136a3> ;
    st:references <http://www.semantictafsir.com/resource/hadith/155/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6> .

