    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/183> a hadith:Hadith ;
    rdfs:label "Hadith 183" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1954" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/182> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/183/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/183/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/183/chain/1/link/3/narrator> ;
    st:hasHadithNo 183 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/279> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/183/note/1> ;
    st:hasText "حَدَّثَنِي يُونُسُ ، قَالَ : أَخْبَرَنَا ابْنُ وَهْبٍ ، قَالَ : قَالَ ابْنُ زَيْدٍ : \" غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ : الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

