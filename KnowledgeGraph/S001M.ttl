<http://www.semantictafsir.com/resource/hadith/153> a hadith:Hadith ;
    rdfs:label "Hadith 153" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L870" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.7/1> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/153/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/153/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 153 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/234> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/153/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، قَالَ : قَالَ جِبْرِيلُ لِمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" قُلْ يَا مُحَمَّدُ : إِيَّاكَ نَعْبُدُ ، إِيَّاكَ نُوَحِّدُ وَنَخَافُ ، وَنَرْجُو يَا رَبَّنَا لا غَيْرَكَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/153/chain/1/link/6> a hadith:NarratorChainSegment,
