<http://www.semantictafsir.com/resource/hadith/148/note/1> a st:Note ;
    rdfs:label "Note 1" ;
    st:hasText "148 /3 /140" .

<http://www.semantictafsir.com/resource/hadith/148/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L527" ;
    st:hasText "مَالِكِ يَوْمِ الدِّينِ ، يَقُولُ : \" لا يَمْلِكُ أَحَدٌ فِي ذَلِكَ الْيَوْمِ مَعَهُ حُكْمًا كَمُلْكِهِمْ فِي الدُّنْيَا ، ثُمَّ قَالَ : لا يَتَكَلَّمُونَ إِلا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا"@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/time/833431bfee94>,
        <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/hadith/148/text/1/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/hadith/148/text/1/thematic-reference/2>,
        <http://www.semantictafsir.com/resource/hadith/148/text/1/thematic-reference/3> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/4>,
        <http://www.semantictafsir.com/resource/quran/verse/78/38/fragment/fc5c1fa10bc6> .

<http://www.semantictafsir.com/resource/hadith/148/text/1/thematic-reference/1> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 1" ;
