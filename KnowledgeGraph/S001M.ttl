    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/200> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/131/note/1> ;
    st:hasText "حَدَّثَنَا إِسْمَاعِيلُ بْنُ الْفَضْلِ ، قَالَ : حَدَّثَنَا إِبْرَاهِيمُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا إِسْمَاعِيلُ بْنُ عَيَّاشٍ ، عَنْ إِسْمَاعِيلَ بْنِ يَحْيَى ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، عَمَّنْ حَدَّثَهُ ، عَنِ ابْنِ مَسْعُودٍ ، وَمِسْعَرِ بْنِ كِدَامٍ ، عَنْ عَطِيَّةَ الْعَوْفِيِّ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ عِيسَى ابْنَ مَرْيَمَ قَالَ : الرَّحْمَنُ رَحْمَنُ الآخِرَةِ وَالدُّنْيَا ، وَالرَّحِيمُ رَحِيمُ الآخِرَةِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam> .

<http://www.semantictafsir.com/resource/hadith/131/chain/1/link/10> a hadith:NarratorChainSegment,
