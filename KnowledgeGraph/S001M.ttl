<http://www.semantictafsir.com/resource/hadith/152> a hadith:Hadith ;
    rdfs:label "Hadith 152" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L854" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/151> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/152/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/152/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/152/chain/1/link/4/narrator> ;
    st:hasHadithNo 152 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/232> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/152/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ بْنُ دَاوُدَ ، قَالَ : حَدَّثَنِي حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ : \" مَالِكِ يَوْمِ الدِّينِ ، قَالَ : يَوْمَ يُدَانُ النَّاسُ بِالْحِسَابِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

