<http://www.semantictafsir.com/resource/commentary/1.10/21> a st:Commentary ;
    rdfs:label "Commentary 21" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1473" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/167> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.10/21/segment/1> ;
    st:hasCommentaryNo 21 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/41246> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/256> ;
    st:hasText "قَالَ أَبُو جَعْفَرٍ : وَإِنَّمَا وَصَفَهُ اللَّهُ جلَّ ثناؤُهُ بِالاسْتِقَامَةِ ؛ لأَنَّهُ صَوَابٌ لا خَطَأَ فِيهِ ، وَقَدْ زَعَمَ بَعْضُ أَهْلِ الْغَبَاءِ أَنَّهُ سَمَّاهُ اللَّهُ مُسْتَقِيمًا ، لاسْتِقَامَتِهِ بِأَهْلِهِ إِلَى الْجَنَّةِ ، وَذَلِكَ تَأْوِيلٌ لِتَأْوِيلِ جَمِيعِ أَهْلِ التَّفْسِيرِ خِلافٌ ، وَكَفَى بِإِجْمَاعِ جَمِيعِهِمْ عَلَى خِلافِهِ جَمِيعَهُمْ دَلِيلا عَلَى خَطَئِهِ ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/57676dacc48b>,
        <http://www.semantictafsir.com/resource/entity/person/4f67604ccf05> .

<http://www.semantictafsir.com/resource/commentary/1.10/21/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1477" ;
    st:hasText "الْجَنَّةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/1.10/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1288" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.10/3/segment/1/segment/1> ;
    st:hasText "أولى بتأويل هَذِهِ الآية عندي ، أعني : اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ أن يَكُون معنيا بِهِ : وفقنا للثبات عَلَى ما ارتضيته ووفقت لَهُ من أنعمت عَلَيْه من عبادك ، من قول وعمل ، وذلك هُوَ الصراط المستقيم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lrajeh> .

<http://www.semantictafsir.com/resource/commentary/1.10/3/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1288" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.10/3/segment/1/segment/1/segment/1> ;
    st:hasText "أولى بتأويل هَذِهِ الآية عندي ، أعني : اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ أن يَكُون معنيا بِهِ : وفقنا للثبات عَلَى ما ارتضيته ووفقت لَهُ من أنعمت عَلَيْه من عبادك ، من قول وعمل ، وذلك هُوَ الصراط المستقيم"@ar ;
    st:references <http://www.semantictafsir.com/resource/commentary/1.10/3/segment/1/segment/1/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6> .

<http://www.semantictafsir.com/resource/commentary/1.10/3/segment/1/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1291" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.10/3/segment/1/segment/1/segment/1/segment/1> ;
    st:hasText "وفقنا للثبات عَلَى ما ارتضيته ووفقت لَهُ من أنعمت عَلَيْه من عبادك ، من قول وعمل ، وذلك هُوَ الصراط المستقيم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

