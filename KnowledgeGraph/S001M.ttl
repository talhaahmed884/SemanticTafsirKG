<http://www.semantictafsir.com/resource/commentary/1.1/11/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L163" ;
    st:hasText """وَأَعْلَمُ أَنَّنِي سَأَكُونُ رَمْسًا
إِذَا سَارَ النَّوَاعِجُ لا يَسِيرُ
فَقَالَ السَّائِلُونَ لِمَنْ حَفَرْتُمْ
فَقَالَ الْمُخْبِرُونَ لَهُمْ وَزِيرُ"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.1/11/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L152" ;
    st:hasText "فَقَوْلُهُ : إِيَّاكَ نَعْبُدُ مِمَّا عَلَّمَهُمْ جَلَّ ذِكْرُهُ أَنْ يَقُولُوهُ وَيَدِينُوا لَهُ بِمَعْنَاهُ ، وَذَلِكَ مَوْصُولٌ بِقَوْلِهِ : الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ وَكَأَنَّهُ قَالَ : قُولُوا هَذَا وَهَذَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/11/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L155" ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/140> ;
    st:hasText "فَإِنْ قَالَ : وَأَيْنَ قَوْلُهُ : \" قُولُوا \" ، فَيَكُونُ تَأْوِيلُ ذَلِكَ مَا ادَّعَيْتَ ؟ قِيلَ : قَدْ دَلَلْنَا فِيمَا مَضَى عَلَى أَنَّ الْعَرَبَ مِنْ شَأْنِهَا إِذَا عَرَفَتْ مَكَانَ الْكَلِمَةِ ، وَلَمْ تَشَكَّكْ أَنَّ سَامِعَهَا يَعْرِفُ بِمَا أَظْهَرَتْ مِنْ مَنْطِقِهَا مَا حَذَفَتْ ، حَذْفُ مَا كَفَى مِنْهُ الظَّاهِرُ مِنْ مَنْطِقِهَا ، وَلا سِيَّمَا إِنْ كَانَتْ تِلْكَ الْكَلِمَةُ الَّتِي حُذِفَتْ قَوْلا ، أَوْ بِتَأْوِيلِ قَوْلٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.1/12/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L178" ;
    st:hasText """وَرَأَيْتُ زَوْجَكِ فِي الْوَغَى
مُتَقَلِّدًا سَيْفًا وَرُمْحَا"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.1/12/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L174" ;
    st:hasText "يُرِيدُ بِذَلِكَ : فَقَالَ الْمُخْبِرُونَ لَهُمُ : الْمَيِّتُ وَزِيرٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/094e674b3470> .

<http://www.semantictafsir.com/resource/commentary/1.1/12/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L176" ;
    st:hasText "فَأَسْقَطَ الْمَيِّتَ ، إِذْ كَانَ قَدْ أَتَى مِنَ الْكَلامِ بِمَا يَدُلُّ عَلَى ذَلِكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/12/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L184" ;
    st:hasText "وَحَامِلا رُمْحًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.1/12/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L185" ;
    st:hasText "لَمَّا كَانَ مَعْلُومًا مَعْنَاهُ اكْتَفَى بِمَا قَدْ ظَهَرَ مِنْ كَلامِهِ عَنْ إِظْهَارِ مَا حَذَفَ مِنْهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/12/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L187" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.1/12/segment/5/segment/1> ;
    st:hasText "قَدْ يَقُولُونَ لِلْمُسَافِرِ إِذَا وَدَّعُوهُ : مُصَاحَبًا مُعَافًى ، يُعْنَى بذلك : سر مصاحبا معافى ، فيحْذِفُونَ : سِرْ وَاخْرُجْ ، إِذْ كَانَ مَعْلُومًا مَعْنَاهُ ، وَإِنْ أُسْقِطَ ذِكْرُهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/12/segment/5/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L187" ;
    st:hasText "قَدْ يَقُولُونَ لِلْمُسَافِرِ إِذَا وَدَّعُوهُ : مُصَاحَبًا مُعَافًى ، يُعْنَى بذلك : سر مصاحبا معافى ، فيحْذِفُونَ : سِرْ وَاخْرُجْ ، إِذْ كَانَ مَعْلُومًا مَعْنَاهُ ، وَإِنْ أُسْقِطَ ذِكْرُهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.1/14/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L196" ;
    st:hasText "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ مِنْ مَعْنَى أَمْرِهِ عِبَادَهُ ، أَغْنَتْ دَلالَةُ مَا ظَهْرَ عَلَيْهِ مِنَ الْقَوْلِ عَنْ إِبْدَاءِ مَا حُذِفَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/2516ffb7ad67> .

<http://www.semantictafsir.com/resource/commentary/1.1/15> a st:Commentary ;
    rdfs:label "Commentary 15" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L203" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.1/14> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.1/15/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.1/15/segment/2> ;
    st:hasCommentaryNo 15 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/47391> ;
    st:hasText "عَنِ ابْنِ عَبَّاسٍ ، وَأَنَّهُ كَانَ يَقُولُ : \" إِنَّ جِبْرِيلَ قَالَ لِمُحَمَّدٍ : قُلْ يَا مُحَمَّدُ : الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ \" . وَبَيَّنَّا أَنَّ جِبْرِيلَ إِنَّمَا عَلَّمَ مُحَمَّدًا صَلَّى اللَّهُ عَلَيه وَسَلَّمَ مَا أُمِرَ بِتَعْلِيمِهِ إِيَّاهُ ، وَهَذَا الْخَبَرُ يُنْبِئُ عَنْ صِحَّةِ مَا قُلْنَا فِي تَأْوِيلِ ذَلِكَ ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/889d71ecaae5>,
        <http://www.semantictafsir.com/resource/entity/person/29a82ea13b18>,
        <http://www.semantictafsir.com/resource/entity/person/4ce9591136a3>,
        <http://www.semantictafsir.com/resource/entity/person/f70c1a5dcfb8> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2> .

<http://www.semantictafsir.com/resource/commentary/1.1/15/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L205" ;
    st:hasText "جِبْرِيلَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/mlak> .

<http://www.semantictafsir.com/resource/commentary/1.1/15/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L208" ;
    st:hasText "جِبْرِيلَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/mlak> .

<http://www.semantictafsir.com/resource/commentary/1.1/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L65" ;
    st:hasText "الشُّكْرُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/asghalamal> .

<http://www.semantictafsir.com/resource/commentary/1.1/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L66" ;
    st:hasText "ثَنَاءٌ عَلَيْهِ بِنِعَمِهِ وَأَيَادِيهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.1/4/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L68" ;
    st:hasText "ثَنَاءُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/asghalamal> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L94" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.1/8/segment/1/segment/1> ;
    st:hasText "لا تَمَانُعَ بَيْنَ أَهْلِ الْمَعْرِفَةِ بِلُغَاتِ الْعَرَبِ مَنِ الْحُكْمِ لِقَوْلِ الْقَائِلِ : الْحَمْدُ لِلَّهِ شُكْرًا بِالصِّحَّةِ ، فَقَدْ تَبَيَّنَ . إِذْ كَانَ ذَلِكَ عِنْدَ جَمِيعِهِمْ صَحِيحًا ، أَنَّ الْحَمْدَ لِلَّهِ قَدْ يُنْطَقُ بِهِ فِي مَوْضِعِ الشُّكْرِ ، وَأَنَّ الشُّكْرَ قَدْ يُوضَعُ مَوْضِعَ الْحَمْدِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/20f6ad902620>,
        <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L97" ;
    st:hasText "شُكْرًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sufiterm> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L102" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.1/8/segment/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.1/8/segment/2/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/138> ;
    st:hasText "يَخْرُجُ مِنْ قَوْلِ الْقَائِلِ : الْحَمْدُ لِلَّهِ ، مَصْدَرُ ( أَشْكُرُ ) ؛ لأَنَّ الشُّكْرَ لَوْ لَمْ يَكُنْ بِمَعْنَى الْحَمْدِ ، كَانَ خَطَأً أَنْ يَصْدُرَ مِنَ الْحَمْدِ غَيْرُ مَعْنَاهُ وَغَيْرُ لَفْظِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L103" ;
    st:hasText "مَصْدَرُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/2/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L104" ;
    st:hasText "الشُّكْرَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sufiterm> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L106" ;
    st:hasText "إِنْ قَالَ لَنَا قَائِلٌ : وَمَا وَجْهُ إِدْخَالِ الأَلْفِ وَاللامِ فِي الْحَمْدِ ؟ وَهَلا قِيلَ : حَمْدًا لِلَّهِ رَبِّ الْعَالَمِينَ ؟ . قِيلَ : إِنَّ لِدُخُولِ الأَلْفِ وَاللامِ فِي الْحَمْدِ مَعْنًى لا يُؤَدِّيهِ قَوْلُ الْقَائِلِ : حَمْدًا لِلَّهِ ، بِإِسْقَاطِ الأَلْفِ وَاللامِ ، وَذَلِكَ أَنَّ دُخُولَهُمَا فِي الْحَمْدِ مُنْبِئٌ عَنْ أَنَّ مَعْنَاهُ : جَمِيعُ الْمَحَامِدِ وَالشُّكْرُ الْكَامِلُ لِلَّهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L112" ;
    st:hasText "وَلَوْ أُسْقِطَتَا مِنْهُ مَا دَلَّ إِلا عَلَى أَنْ حَمْدَ قَائِلِ ذَلِكَ لِلَّهِ دُونَ الْمَحَامِدِ كُلِّهَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L114" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.1/8/segment/5/segment/1> ;
    st:hasText "مَعْنَى قَوْلِ الْقَائِلِ : حَمْدًا لِلَّهِ ، أَوْ : حَمْدٌ لِلَّهِ : أَحْمَدُ اللَّهَ حَمْدًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.1/8/segment/5/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L114" ;
    st:hasText "مَعْنَى قَوْلِ الْقَائِلِ : حَمْدًا لِلَّهِ ، أَوْ : حَمْدٌ لِلَّهِ : أَحْمَدُ اللَّهَ حَمْدًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.1/9/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L119" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.1/9/segment/1/segment/1> ;
    st:hasText "تَالِيًا سُورَةَ أُمِّ الْقُرْآنُ : أَحْمَدُ اللَّهَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2> .

<http://www.semantictafsir.com/resource/commentary/1.1/9/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L120" ;
    st:hasText "الْقُرْآنُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/ktub> .

<http://www.semantictafsir.com/resource/commentary/1.1/9/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L124" ;
    st:hasText "الدِّينِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

