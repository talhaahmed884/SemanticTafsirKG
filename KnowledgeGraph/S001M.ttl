<http://www.semantictafsir.com/resource/hadith/131/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L802" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/131/text/1/segment/1> ;
    st:hasText "عِيسَى ابْنَ مَرْيَمَ قَالَ : الرَّحْمَنُ رَحْمَنُ الآخِرَةِ وَالدُّنْيَا ، وَالرَّحِيمُ رَحِيمُ الآخِرَةِ \""@ar .

