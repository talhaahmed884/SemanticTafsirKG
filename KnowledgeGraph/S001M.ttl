<http://www.semantictafsir.com/resource/hadith/142> a hadith:Hadith ;
    rdfs:label "Hadith 142" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L336" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.3/7> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/142/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/142/chain/1/link/5/narrator> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/142/segment/1> ;
    st:hasHadithNo 142 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/219> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/142/note/1> ;
    st:hasText "حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ بْنِ عِيسَى الأَهْوَازِيُّ ، قَالَ : حَدَّثَنَا أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، قَالَ : حَدَّثَنَا قَيْسٌ ، عَنْ عَطَاءِ بْنِ السَّائِبِ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَوْلَهُ : \" رَبِّ الْعَالَمِينَ ، قَالَ : الْجِنُّ وَالإِنْسُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/8cc50c90f535> .

<http://www.semantictafsir.com/resource/hadith/142/chain/1/link/5> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 5" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/hadith/142/chain/1/link/5/narrator> ;
