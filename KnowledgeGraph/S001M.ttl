    rdfs:label "Chain Link 10" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L3260> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/132> a hadith:Hadith ;
    rdfs:label "Hadith 132" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L890" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.16/3> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/132/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/132/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 132 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/202> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/132/note/1> ;
    st:hasText "حَدَّثَنَا بِهِ أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، قَالَ : \" الرَّحْمَنِ الْفَعْلانُ مِنَ الرَّحْمَةِ ، وَهُوَ مِنْ كَلامِ الْعَرَبِ ، قَالَ : الرَّحْمَنِ الرَّحِيمِ : الرَّقِيقُ الرَّفِيقُ بِمَنْ أَحَبَّ أَنْ يَرْحَمَهُ ، وَالْبَعِيدُ الشَّدِيدُ عَلَى مَنْ أَحَبَّ أَنْ يُعَنِّفَ عَلَيْهِ ، وَكَذَلِكَ أَسْمَاؤُهُ كُلُّهَا \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/132/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/133> a hadith:Hadith ;
    rdfs:label "Hadith 133" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L1107" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.16/8> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/133/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/133/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/133/chain/1/link/4/narrator> ;
    st:hasHadithNo 133 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/204> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/133/note/1> ;
    st:hasText "حَدَّثَنَا مُحَمَّدُ بْنُ بَشَّارٍ ، قَالَ : حَدَّثَنَا حَمَّادُ بْنُ مَسْعَدَةَ ، عَنْ عَوْفٍ ، عَنِ الْحَسَنِ ، قَالَ : \" الرَّحْمَنُ اسْمٌ مَمْنُوعٌ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam> .

<http://www.semantictafsir.com/resource/hadith/133/chain/1/link/4> a hadith:NarratorChainSegment,
