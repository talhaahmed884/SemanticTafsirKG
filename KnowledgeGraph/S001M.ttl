    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4861> ;
    st:hasType "rawi" .

<http://www.semantictafsir.com/resource/hadith/191> a hadith:Hadith ;
    rdfs:label "Hadith 191" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2206" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/190> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/191/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/191/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/191/chain/1/link/4/narrator> ;
    st:hasHadithNo 191 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/289> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/191/note/1> ;
    st:hasText "حَدَّثَنَا ابْنُ حُمَيْدٍ ، قَالَ : حَدَّثَنَا مِهْرَانُ ، عَنْ سُفْيَانَ ، عَنْ مُجَاهِدٍ : وَلا الضَّالِّينَ ، قَالَ : النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

