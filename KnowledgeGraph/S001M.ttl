<http://www.semantictafsir.com/resource/commentary/1.8/13> a st:Commentary ;
    rdfs:label "Commentary 13" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1075" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.8/12> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.8/13/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.8/13/segment/2> ;
    st:hasCommentaryNo 13 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/43376> ;
    st:hasText "وَذَلِكَ أَنَّ قَائِلا لَوْ قَالَ : الشَّمْسُ قَدْ فَصَلَتْ بَيْنَ النَّهَارِ . لَكَانَ مِنَ الْكَلامِ خَلْفًا ، لِنُقْصَانِ الْكَلامِ عَمَّا بِهِ الْحَاجَةُ إِلَيْهِ مِنْ تَمَامِهِ الَّذِي يَقْتَضِيهِ : ( بَيْنَ ) . وَلَوْ قَالَ الْقَائِلُ : اللَّهُمَّ إِيَّاكَ نَعْبُدُ . لَكَانَ ذَلِكَ كَلامًا تَامًّا ، فَكَانَ مَعْلُومًا بِذَلِكَ أَنَّ حَاجَةَ كُلِّ كَلِمَةٍ ، كَانَتْ نَظِيرَةَ : إِيَّاكَ نَعْبُدُ ، إِلَى : ( إِيَّاكَ ) كَحَاجَةِ : نَعْبُدُ إِلَيْهَا ، وَأَنَّ الصَّوَابَ أَنْ تُكَونَ مَعَهَا ( إِيَّاكَ ) ، إِذْ كَانَتْ كُلُّ كَلِمَةٍ مِنْهَا جُمْلَةَ خَبَرِ مُبْتَدَأٍ ، وَبَيِّنًا حُكْمُ مُخَالَفَةِ ذَلِكَ حُكْمَ ( بَيْنَ ) فِيمَا وَفَّقَ بَيْنَهُمَا الَّذِي وَصَفْنَا قَوْلَهُ ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/rajeh> .

<http://www.semantictafsir.com/resource/commentary/1.8/13/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1075" ;
    st:hasText "ذَلِكَ أَنَّ قَائِلا لَوْ قَالَ : الشَّمْسُ قَدْ فَصَلَتْ بَيْنَ النَّهَارِ . لَكَانَ مِنَ الْكَلامِ خَلْفًا ، لِنُقْصَانِ الْكَلامِ عَمَّا بِهِ الْحَاجَةُ إِلَيْهِ مِنْ تَمَامِهِ الَّذِي يَقْتَضِيهِ : ( بَيْنَ ) . وَلَوْ قَالَ الْقَائِلُ : اللَّهُمَّ إِيَّاكَ نَعْبُدُ . لَكَانَ ذَلِكَ كَلامًا تَامًّا ، فَكَانَ مَعْلُومًا بِذَلِكَ أَنَّ حَاجَةَ كُلِّ كَلِمَةٍ ، كَانَتْ نَظِيرَةَ : إِيَّاكَ نَعْبُدُ ، إِلَى : ( إِيَّاكَ ) كَحَاجَةِ : نَعْبُدُ إِلَيْهَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/63902b83b5eb>,
        <http://www.semantictafsir.com/resource/entity/time/cdb40bbe6ac4> .

<http://www.semantictafsir.com/resource/commentary/1.8/13/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1082" ;
    st:hasText "أَنَّ الصَّوَابَ أَنْ تُكَونَ مَعَهَا ( إِيَّاكَ ) ، إِذْ كَانَتْ كُلُّ كَلِمَةٍ مِنْهَا جُمْلَةَ خَبَرِ مُبْتَدَأٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lrajeh> .

