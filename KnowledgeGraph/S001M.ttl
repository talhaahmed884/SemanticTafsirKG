<http://www.semantictafsir.com/resource/hadith/148> a hadith:Hadith ;
    rdfs:label "Hadith 148" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L518" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.5/4> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/148/text/1>,
        <http://www.semantictafsir.com/resource/hadith/148/text/2> ;
