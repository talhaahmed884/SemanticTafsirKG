<http://www.semantictafsir.com/resource/hadith/134> a hadith:Hadith ;
    rdfs:label "Hadith 134" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L38" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.1/1> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/134/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/134/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 134 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/206> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/134/note/1> ;
    st:hasText "حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" قَالَ جِبْرِيلُ لِمُحَمَّدٍ : قُلْ يَا مُحَمَّدُ : الْحَمْدُ لِلَّهِ \" قَالَ ابْنُ عَبَّاسٍ : \" الْحَمْدُ : هُوَ الشُّكْرُ لِلَّهِ ، وَالاسْتِخْذَاءِ لِلَّهِ ، وَالإِقْرَارِ بِنِعْمَتِهِ وَهِدَايَتِهِ ، وَابْتِدَائِهِ ، وَغَيْرِ ذَلِكَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha>,
        <http://www.semantictafsir.com/resource/theme/sufism> .

<http://www.semantictafsir.com/resource/hadith/134/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/135> a hadith:Hadith ;
    rdfs:label "Hadith 135" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L53" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/134> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/135/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/135/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L15584> ;
    st:hasHadithNo 135 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/207> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/135/note/1> ;
    st:hasText "حَدَّثَنِي سَعِيدُ بْنُ عَمْرٍو السَّكُونِيُّ ، قَالَ : حَدَّثَنَا بَقِيَّةُ بْنُ الْوَلِيدِ ، قَالَ : حَدَّثَنِي عِيسَى بْنُ إِبْرَاهِيمَ ، عَنْ مُوسَى بْنِ أَبِي حَبِيبٍ ، عَنِ الْحَكَمِ بْنِ عُمَيْرٍ ، وَكَانَتْ لَهُ صُحْبَةٌ ، قَالَ : قَالَ النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِذَا قُلْتَ : الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينِ ، فَقَدْ شَكَرْتَ اللَّهَ فَزَادَكَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sufism> .

<http://www.semantictafsir.com/resource/hadith/135/chain/1/link/5> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 5" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L15584> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/136> a hadith:Hadith ;
    rdfs:label "Hadith 136" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L71" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.1/4> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/136/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/136/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/136/chain/1/link/7/narrator> ;
    st:hasHadithNo 136 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/209> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/136/note/1> ;
    st:hasText "حَدَّثَنَا يُونُسُ بْنُ عَبْدِ الأَعْلَى الصَّدَفِيُّ ، قَالَ : أَنْبَأَنَا ابْنُ وَهْبٍ ، قَالَ : حَدَّثَنِي عُمَرُ بْنُ مُحَمَّدٍ ، عَنْ سُهَيْلِ بْنِ أَبِي صَالِحٍ ، عَنْ أَبِيهِ ، قَالَ : أَخْبَرَنِي السَّلُولِيُّ ، عَنْ كَعْبٍ ، قَالَ : \" مَنْ قَالَ : الْحَمْدُ لِلَّهِ ، فَذَلِكَ ثَنَاءٌ عَلَى اللَّهِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sufism> .

<http://www.semantictafsir.com/resource/hadith/136/chain/1/link/7> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 7" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/hadith/136/chain/1/link/7/narrator> ;
