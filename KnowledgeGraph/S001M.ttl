    rdfs:label "Verse Fragment 16:121 (اجْتَبَاهُ وَهَدَاهُ إِلَى صِرَاطٍ مُسْتَقِيمٍ)" ;
    st:hasText "اجْتَبَاهُ وَهَدَاهُ إِلَى صِرَاطٍ مُسْتَقِيمٍ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/16/121> .

<http://www.semantictafsir.com/resource/quran/verse/16/18> a st:Verse ;
    rdfs:label "Verse 16:18" ;
    st:hasSurahNo 16 ;
    st:hasText "وَإِن تَعُدُّوا۟ نِعْمَةَ ٱللَّهِ لَا تُحْصُوهَآ إِنَّ ٱللَّهَ لَغَفُورٌ رَّحِيمٌ"@ar ;
    st:hasVerseNo 18 .

<http://www.semantictafsir.com/resource/quran/verse/17/110> a st:Verse ;
    rdfs:label "Verse 17:110" ;
    st:hasSurahNo 17 ;
    st:hasText "قُلِ ٱدْعُوا۟ ٱللَّهَ أَوِ ٱدْعُوا۟ ٱلرَّحْمَٰنَ أَيًّا مَّا تَدْعُوا۟ فَلَهُ ٱلْأَسْمَآءُ ٱلْحُسْنَىٰ وَلَا تَجْهَرْ بِصَلَاتِكَ وَلَا تُخَافِتْ بِهَا وَٱبْتَغِ بَيْنَ ذَٰلِكَ سَبِيلًا"@ar ;
    st:hasVerseNo 110 .

<http://www.semantictafsir.com/resource/quran/verse/18/38> a st:Verse ;
    rdfs:label "Verse 18:38" ;
    st:hasSurahNo 18 ;
    st:hasText "لَّٰكِنَّا۠ هُوَ ٱللَّهُ رَبِّى وَلَآ أُشْرِكُ بِرَبِّىٓ أَحَدًا"@ar ;
    st:hasVerseNo 38 .

<http://www.semantictafsir.com/resource/quran/verse/19/46> a st:Verse ;
    rdfs:label "Verse 19:46" ;
    st:hasSurahNo 19 ;
    st:hasText "قَالَ أَرَاغِبٌ أَنتَ عَنْ ءَالِهَتِى يَٰٓإِبْرَٰهِيمُ لَئِن لَّمْ تَنتَهِ لَأَرْجُمَنَّكَ وَٱهْجُرْنِى مَلِيًّا"@ar ;
    st:hasVerseNo 46 .

<http://www.semantictafsir.com/resource/quran/verse/2/258> a st:Verse ;
    rdfs:label "Verse 2:258" ;
    st:hasSurahNo 2 ;
    st:hasText "أَلَمْ تَرَ إِلَى ٱلَّذِى حَآجَّ إِبْرَٰهِـۧمَ فِى رَبِّهِۦٓ أَنْ ءَاتَىٰهُ ٱللَّهُ ٱلْمُلْكَ إِذْ قَالَ إِبْرَٰهِـۧمُ رَبِّىَ ٱلَّذِى يُحْىِۦ وَيُمِيتُ قَالَ أَنَا۠ أُحْىِۦ وَأُمِيتُ قَالَ إِبْرَٰهِـۧمُ فَإِنَّ ٱللَّهَ يَأْتِى بِٱلشَّمْسِ مِنَ ٱلْمَشْرِقِ فَأْتِ بِهَا مِنَ ٱلْمَغْرِبِ فَبُهِتَ ٱلَّذِى كَفَرَ وَٱللَّهُ لَا يَهْدِى ٱلْقَوْمَ ٱلظَّٰلِمِينَ"@ar ;
    st:hasVerseNo 258 .

<http://www.semantictafsir.com/resource/quran/verse/20/108> a st:Verse ;
    rdfs:label "Verse 20:108" ;
    st:hasSurahNo 20 ;
    st:hasText "يَوْمَئِذٍ يَتَّبِعُونَ ٱلدَّاعِىَ لَا عِوَجَ لَهُۥ وَخَشَعَتِ ٱلْأَصْوَاتُ لِلرَّحْمَٰنِ فَلَا تَسْمَعُ إِلَّا هَمْسًا"@ar ;
    st:hasVerseNo 108 .

<http://www.semantictafsir.com/resource/quran/verse/20/108/fragment/f8f2df6f7ae5> a st:VerseFragment ;
    rdfs:label "Verse Fragment 20:108 (وَخَشَعَتِ الأَصْوَاتُ لِلرَّحْمَنِ)" ;
    st:hasText "وَخَشَعَتِ الأَصْوَاتُ لِلرَّحْمَنِ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/20/108> .

<http://www.semantictafsir.com/resource/quran/verse/21/28> a st:Verse ;
    rdfs:label "Verse 21:28" ;
    st:hasSurahNo 21 ;
    st:hasText "يَعْلَمُ مَا بَيْنَ أَيْدِيهِمْ وَمَا خَلْفَهُمْ وَلَا يَشْفَعُونَ إِلَّا لِمَنِ ٱرْتَضَىٰ وَهُم مِّنْ خَشْيَتِهِۦ مُشْفِقُونَ"@ar ;
    st:hasVerseNo 28 .

<http://www.semantictafsir.com/resource/quran/verse/21/28/fragment/610435d24b76> a st:VerseFragment ;
    rdfs:label "Verse Fragment 21:28 (وَلا يَشْفَعُونَ إِلا لِمَنِ ارْتَضَى)" ;
    st:hasText "وَلا يَشْفَعُونَ إِلا لِمَنِ ارْتَضَى"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/21/28> .

<http://www.semantictafsir.com/resource/quran/verse/25/60> a st:Verse ;
    rdfs:label "Verse 25:60" ;
    st:hasSurahNo 25 ;
    st:hasText "وَإِذَا قِيلَ لَهُمُ ٱسْجُدُوا۟ لِلرَّحْمَٰنِ قَالُوا۟ وَمَا ٱلرَّحْمَٰنُ أَنَسْجُدُ لِمَا تَأْمُرُنَا وَزَادَهُمْ نُفُورًا"@ar ;
    st:hasVerseNo 60 .

<http://www.semantictafsir.com/resource/quran/verse/25/60/fragment/9e00207c6bc4> a st:VerseFragment ;
    rdfs:label "Verse Fragment 25:60 (وَمَا الرَّحْمَنُ أَنَسْجُدُ لِمَا تَأْمُرُنَا)" ;
    st:hasText "وَمَا الرَّحْمَنُ أَنَسْجُدُ لِمَا تَأْمُرُنَا"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/25/60> .

<http://www.semantictafsir.com/resource/quran/verse/27/60> a st:Verse ;
    rdfs:label "Verse 27:60" ;
    st:hasSurahNo 27 ;
    st:hasText "أَمَّنْ خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ وَأَنزَلَ لَكُم مِّنَ ٱلسَّمَآءِ مَآءً فَأَنۢبَتْنَا بِهِۦ حَدَآئِقَ ذَاتَ بَهْجَةٍ مَّا كَانَ لَكُمْ أَن تُنۢبِتُوا۟ شَجَرَهَآ أَءِلَٰهٌ مَّعَ ٱللَّهِ بَلْ هُمْ قَوْمٌ يَعْدِلُونَ"@ar ;
    st:hasVerseNo 60 .

<http://www.semantictafsir.com/resource/quran/verse/27/60/fragment/fa0eb733d21e> a st:VerseFragment ;
    rdfs:label "Verse Fragment 27:60 (أَإِلَهٌ مَعَ اللَّهِ)" ;
    st:hasText "أَإِلَهٌ مَعَ اللَّهِ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/27/60> .

<http://www.semantictafsir.com/resource/quran/verse/3/110> a st:Verse ;
    rdfs:label "Verse 3:110" ;
    st:hasSurahNo 3 ;
    st:hasText "كُنتُمْ خَيْرَ أُمَّةٍ أُخْرِجَتْ لِلنَّاسِ تَأْمُرُونَ بِٱلْمَعْرُوفِ وَتَنْهَوْنَ عَنِ ٱلْمُنكَرِ وَتُؤْمِنُونَ بِٱللَّهِ وَلَوْ ءَامَنَ أَهْلُ ٱلْكِتَٰبِ لَكَانَ خَيْرًا لَّهُم مِّنْهُمُ ٱلْمُؤْمِنُونَ وَأَكْثَرُهُمُ ٱلْفَٰسِقُونَ"@ar ;
    st:hasVerseNo 110 .

<http://www.semantictafsir.com/resource/quran/verse/33/43> a st:Verse ;
    rdfs:label "Verse 33:43" ;
    st:hasSurahNo 33 ;
    st:hasText "هُوَ ٱلَّذِى يُصَلِّى عَلَيْكُمْ وَمَلَٰٓئِكَتُهُۥ لِيُخْرِجَكُم مِّنَ ٱلظُّلُمَٰتِ إِلَى ٱلنُّورِ وَكَانَ بِٱلْمُؤْمِنِينَ رَحِيمًا"@ar ;
    st:hasVerseNo 43 .

<http://www.semantictafsir.com/resource/quran/verse/33/43/fragment/f15d8c15abd2> a st:VerseFragment ;
    rdfs:label "Verse Fragment 33:43 (وَكَانَ بِالْمُؤْمِنِينَ رَحِيمًا)" ;
    st:hasText "وَكَانَ بِالْمُؤْمِنِينَ رَحِيمًا"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/33/43> .

<http://www.semantictafsir.com/resource/quran/verse/37/23> a st:Verse ;
    rdfs:label "Verse 37:23" ;
    st:hasSurahNo 37 ;
    st:hasText "مِن دُونِ ٱللَّهِ فَٱهْدُوهُمْ إِلَىٰ صِرَٰطِ ٱلْجَحِيمِ"@ar ;
    st:hasVerseNo 23 .

<http://www.semantictafsir.com/resource/quran/verse/37/23/fragment/e2b18960269f> a st:VerseFragment ;
    rdfs:label "Verse Fragment 37:23 (فَاهْدُوهُمْ إِلَى صِرَاطِ الْجَحِيمِ)" ;
    st:hasText "فَاهْدُوهُمْ إِلَى صِرَاطِ الْجَحِيمِ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/37/23> .

<http://www.semantictafsir.com/resource/quran/verse/4/66> a st:Verse ;
    rdfs:label "Verse 4:66" ;
    st:hasSurahNo 4 ;
    st:hasText "وَلَوْ أَنَّا كَتَبْنَا عَلَيْهِمْ أَنِ ٱقْتُلُوٓا۟ أَنفُسَكُمْ أَوِ ٱخْرُجُوا۟ مِن دِيَٰرِكُم مَّا فَعَلُوهُ إِلَّا قَلِيلٌ مِّنْهُمْ وَلَوْ أَنَّهُمْ فَعَلُوا۟ مَا يُوعَظُونَ بِهِۦ لَكَانَ خَيْرًا لَّهُمْ وَأَشَدَّ تَثْبِيتًا"@ar ;
    st:hasVerseNo 66 .

<http://www.semantictafsir.com/resource/quran/verse/40/55> a st:Verse ;
    rdfs:label "Verse 40:55" ;
    st:hasSurahNo 40 ;
    st:hasText "فَٱصْبِرْ إِنَّ وَعْدَ ٱللَّهِ حَقٌّ وَٱسْتَغْفِرْ لِذَنۢبِكَ وَسَبِّحْ بِحَمْدِ رَبِّكَ بِٱلْعَشِىِّ وَٱلْإِبْكَٰرِ"@ar ;
    st:hasVerseNo 55 .

<http://www.semantictafsir.com/resource/quran/verse/5/77> a st:Verse ;
    rdfs:label "Verse 5:77" ;
    st:hasSurahNo 5 ;
    st:hasText "قُلْ يَٰٓأَهْلَ ٱلْكِتَٰبِ لَا تَغْلُوا۟ فِى دِينِكُمْ غَيْرَ ٱلْحَقِّ وَلَا تَتَّبِعُوٓا۟ أَهْوَآءَ قَوْمٍ قَدْ ضَلُّوا۟ مِن قَبْلُ وَأَضَلُّوا۟ كَثِيرًا وَضَلُّوا۟ عَن سَوَآءِ ٱلسَّبِيلِ"@ar ;
    st:hasVerseNo 77 .

<http://www.semantictafsir.com/resource/quran/verse/56/86> a st:Verse ;
    rdfs:label "Verse 56:86" ;
    st:hasSurahNo 56 ;
    st:hasText "فَلَوْلَآ إِن كُنتُمْ غَيْرَ مَدِينِينَ"@ar ;
    st:hasVerseNo 86 .

<http://www.semantictafsir.com/resource/quran/verse/6/112> a st:Verse ;
    rdfs:label "Verse 6:112" ;
    st:hasSurahNo 6 ;
    st:hasText "وَكَذَٰلِكَ جَعَلْنَا لِكُلِّ نَبِىٍّ عَدُوًّا شَيَٰطِينَ ٱلْإِنسِ وَٱلْجِنِّ يُوحِى بَعْضُهُمْ إِلَىٰ بَعْضٍ زُخْرُفَ ٱلْقَوْلِ غُرُورًا وَلَوْ شَآءَ رَبُّكَ مَا فَعَلُوهُ فَذَرْهُمْ وَمَا يَفْتَرُونَ"@ar ;
    st:hasVerseNo 112 .

<http://www.semantictafsir.com/resource/quran/verse/7/12> a st:Verse ;
    rdfs:label "Verse 7:12" ;
    st:hasSurahNo 7 ;
    st:hasText "قَالَ مَا مَنَعَكَ أَلَّا تَسْجُدَ إِذْ أَمَرْتُكَ قَالَ أَنَا۠ خَيْرٌ مِّنْهُ خَلَقْتَنِى مِن نَّارٍ وَخَلَقْتَهُۥ مِن طِينٍ"@ar ;
    st:hasVerseNo 12 .

<http://www.semantictafsir.com/resource/quran/verse/7/43> a st:Verse ;
    rdfs:label "Verse 7:43" ;
    st:hasSurahNo 7 ;
    st:hasText "وَنَزَعْنَا مَا فِى صُدُورِهِم مِّنْ غِلٍّ تَجْرِى مِن تَحْتِهِمُ ٱلْأَنْهَٰرُ وَقَالُوا۟ ٱلْحَمْدُ لِلَّهِ ٱلَّذِى هَدَىٰنَا لِهَٰذَا وَمَا كُنَّا لِنَهْتَدِىَ لَوْلَآ أَنْ هَدَىٰنَا ٱللَّهُ لَقَدْ جَآءَتْ رُسُلُ رَبِّنَا بِٱلْحَقِّ وَنُودُوٓا۟ أَن تِلْكُمُ ٱلْجَنَّةُ أُورِثْتُمُوهَا بِمَا كُنتُمْ تَعْمَلُونَ"@ar ;
    st:hasVerseNo 43 .

<http://www.semantictafsir.com/resource/quran/verse/7/54> a st:Verse ;
    rdfs:label "Verse 7:54" ;
    st:hasSurahNo 7 ;
    st:hasText "إِنَّ رَبَّكُمُ ٱللَّهُ ٱلَّذِى خَلَقَ ٱلسَّمَٰوَٰتِ وَٱلْأَرْضَ فِى سِتَّةِ أَيَّامٍ ثُمَّ ٱسْتَوَىٰ عَلَى ٱلْعَرْشِ يُغْشِى ٱلَّيْلَ ٱلنَّهَارَ يَطْلُبُهُۥ حَثِيثًا وَٱلشَّمْسَ وَٱلْقَمَرَ وَٱلنُّجُومَ مُسَخَّرَٰتٍۭ بِأَمْرِهِۦٓ أَلَا لَهُ ٱلْخَلْقُ وَٱلْأَمْرُ تَبَارَكَ ٱللَّهُ رَبُّ ٱلْعَٰلَمِينَ"@ar ;
    st:hasVerseNo 54 .

<http://www.semantictafsir.com/resource/quran/verse/78/38> a st:Verse ;
    rdfs:label "Verse 78:38" ;
    st:hasSurahNo 78 ;
    st:hasText "يَوْمَ يَقُومُ ٱلرُّوحُ وَٱلْمَلَٰٓئِكَةُ صَفًّا لَّا يَتَكَلَّمُونَ إِلَّا مَنْ أَذِنَ لَهُ ٱلرَّحْمَٰنُ وَقَالَ صَوَابًا"@ar ;
    st:hasVerseNo 38 .

<http://www.semantictafsir.com/resource/quran/verse/78/38/fragment/fc5c1fa10bc6> a st:VerseFragment ;
    rdfs:label "Verse Fragment 78:38 (لا يَتَكَلَّمُونَ إِلا مَنْ أَذِنَ …)" ;
    st:hasText "لا يَتَكَلَّمُونَ إِلا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/78/38> .

<http://www.semantictafsir.com/resource/quran/verse/82/10> a st:Verse ;
    rdfs:label "Verse 82:10" ;
    st:hasSurahNo 82 ;
    st:hasText "وَإِنَّ عَلَيْكُمْ لَحَٰفِظِينَ"@ar ;
    st:hasVerseNo 10 .

<http://www.semantictafsir.com/resource/quran/verse/82/9> a st:Verse ;
    rdfs:label "Verse 82:9" ;
    st:hasSurahNo 82 ;
    st:hasText "كَلَّا بَلْ تُكَذِّبُونَ بِٱلدِّينِ"@ar ;
    st:hasVerseNo 9 .

<http://www.semantictafsir.com/resource/section/0.11> a st:Section ;
    rdfs:label "Section 0.11" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L4" ;
    st:containsCommentary <http://www.semantictafsir.com/resource/commentary/0.11/1>,
        <http://www.semantictafsir.com/resource/commentary/0.11/3>,
        <http://www.semantictafsir.com/resource/commentary/0.11/4>,
        <http://www.semantictafsir.com/resource/commentary/0.11/6> ;
    st:hasPart <http://www.semantictafsir.com/resource/hadith/119>,
        <http://www.semantictafsir.com/resource/hadith/120> ;
    st:hasSectionNo "0.11" ;
    st:hasText "الْقَوْلُ فِي تَأْوِيلِ أَسْمَاءِ فَاتِحَةِ الْكِتَابِ"@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b> .

