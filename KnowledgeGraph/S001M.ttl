    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1624" ;
