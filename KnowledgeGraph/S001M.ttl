<http://www.semantictafsir.com/resource/hadith/157> a hadith:Hadith ;
    rdfs:label "Hadith 157" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1332" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.10/6> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/157/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/157/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L5722> ;
    st:hasHadithNo 157 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/242> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/157/note/1> ;
    st:hasText "حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ الأَهْوَازِيُّ ، قَالَ : حَدَّثَنَا أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، قَالَ : حَدَّثَنَا حَمْزَةُ الزَّيَّاتُ ، عَنْ أَبِي الْمُخْتَارِ الطَّائِيِّ ، عَنِ ابْنِ أَخِي الْحَارِثِ الأَعْوَرِ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، قَالَ : \" الصِّرَاطُ الْمُسْتَقِيمُ كِتَابُ اللَّهِ تَعَالَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

