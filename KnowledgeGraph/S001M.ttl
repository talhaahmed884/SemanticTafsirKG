    st:hasTheme <http://www.semantictafsir.com/resource/theme/fiqhterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/7/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L450" ;
    st:hasText "تِلاوَةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/asghalamal> .

