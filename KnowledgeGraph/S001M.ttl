<http://www.semantictafsir.com/resource/hadith/119> a hadith:Hadith ;
    rdfs:label "Hadith 119" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L10" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.11/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/119/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4396> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/119/segment/1> ;
    st:hasHadithNo 119 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/177> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/119/note/1> ;
    st:hasText "بِمَا حَدَّثَنِي بِهِ يُونُسُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : أَخْبَرَنِي ابْنُ أَبِي ذِئْبٍ ، عَنْ سَعِيدٍ الْمَقْبُرِيِّ ، عَنْ أَبِي هُرَيْرَةَ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" هِيَ أُمُّ الْقُرْآنِ ، وَهِيَ فَاتِحَةُ الْكِتَابِ ، وَهِيَ السَّبْعُ الْمَثَانِي\""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2>,
        <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b> .

<http://www.semantictafsir.com/resource/hadith/119/chain/1/link/5> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 5" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4396> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/120> a hadith:Hadith ;
    rdfs:label "Hadith 120" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L103" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.11/4> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/120/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/120/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/120/chain/1/link/4/narrator> ;
    st:containsAdditionalText <http://www.semantictafsir.com/resource/hadith/120/addition/1> ;
    st:hasHadithNo 120 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/179> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/120/note/1> ;
    st:hasText "حَدَّثَنِي يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا ابْنُ عُلَيَّةَ ، عَنْ أَبِي رَجَاءٍ ، قَالَ : سَأَلْتُ الْحَسَنَ عَنْ قَوْلِهِ : وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي وَالْقُرْءَانَ الْعَظِيمَ ، قَالَ : \" هِيَ فَاتِحَةُ الْكِتَابِ ، ثُمَّ سُئِلَ عَنْهَا ، وَأَنَا أَسْمَعُ ، فَقَرَأَهَا : الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ حَتَّى أَتَى عَلَى آخِرِهَا ، فَقَالَ ، تُثَنَّى فِي كُلِّ قِرَاءَةٍ . أَوْ قَالَ : فِي كُلِّ صَلاةٍ \" . الشَّكُّ مِنْ أَبِي جَعْفَرٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/fiqh>,
        <http://www.semantictafsir.com/resource/theme/kalam> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/24ee25c09b42> .

<http://www.semantictafsir.com/resource/hadith/120/chain/1/link/4> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 4" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/hadith/120/chain/1/link/4/narrator> ;
    st:hasType "rawi" .

<http://www.semantictafsir.com/resource/hadith/120/chain/1/link/4/narrator> a hadith:HadithNarrator,
        hadith:RootNarrator ;
    rdfs:label "Narrator: الْحَسَنَ" ;
    st:hasName "الْحَسَنَ"@ar ;
