<http://www.semantictafsir.com/resource/hadith/145> a hadith:Hadith ;
    rdfs:label "Hadith 145" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L366" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/144/continuation/1> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/145/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/145/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/145/chain/1/link/4/narrator> ;
    st:hasHadithNo 145 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/222> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/145/note/1> ;
    st:hasText "حَدَّثَنَا بِشْرُ بْنُ مُعَاذٍ الْعَقَدِيُّ ، قَالَ : حَدَّثَنَا يَزِيدُ بْنُ زُرَيْعٍ ، عَنْ سَعِيدٍ ، عَنْ قَتَادَةَ : \" رَبِّ الْعَالَمِينَ ، قَالَ : كُلُّ صِنْفٍ : عَالَمٌ \""@ar .

