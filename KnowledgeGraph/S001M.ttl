<http://www.semantictafsir.com/resource/commentary/1.12/7/segment/11> a st:Segment ;
    rdfs:label "Segment 11" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1700" ;
    st:hasText "ضالون"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/7/segment/12> a st:Segment ;
    rdfs:label "Segment 12" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1702" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/7/segment/12/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/7/segment/12/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/7/segment/12/segment/3> ;
    st:hasText "هَذَا إذا وجهنا غَيْرِ إلى أنها مخفوضة عَلَى نية تكرير الصراط الخافض الَّذِينَ ، وَلَم نجعل : غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ من صفة : صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ بل إذا جعلناهم غيرهم ، وإن كَانَ الفريقان لا شك منعما عليهما فِي أديانهما"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

