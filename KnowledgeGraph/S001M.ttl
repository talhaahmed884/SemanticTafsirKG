<http://www.semantictafsir.com/resource/hadith/162> a hadith:Hadith ;
    rdfs:label "Hadith 162" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1393" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.10/12> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/162/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/162/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/162/chain/1/link/5/narrator> ;
    st:hasHadithNo 162 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/248> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/162/note/1> ;
    st:hasText "حَدَّثَنَا مَحْمُودُ بْنُ خِدَاشٍ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ رَبِيعَةَ الْكِلابِيُّ ، عَنْ إِسْمَاعِيلَ الأَزْرَقِ ، عَنْ أَبِي عُمَرَ الْبَزَّارِ ، عَنِ ابْنِ الْحَنَفِيَّةِ ، فِي قَوْلِهِ : \" اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ : هُوَ دِينُ اللَّهِ الَّذِي لا يَقْبَلُ مِنَ الْعِبَادِ غَيْرَهُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/162/chain/1/link/5> a hadith:NarratorChainSegment,
