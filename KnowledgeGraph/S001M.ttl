<http://www.semantictafsir.com/resource/hadith/188/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2163" ;
    st:hasText "أَنَّ رَجُلا أَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحَاصِرٌ وَادِي الْقُرَى ، قَالَ : قُلْتُ : مَنْ هَؤُلاءِ ؟ قَالَ : \" هَؤُلاءِ الضَّالُّونَ النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sghazawat> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/2464d13dfe4e> .

<http://www.semantictafsir.com/resource/hadith/188/text/1> a hadith:HadithText ;
