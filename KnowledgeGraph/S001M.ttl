    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L310" ;
    st:hasText "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ . الْحَمْدُ لِلَّهِ الَّذِي لَهُ الْخَلْقُ كُلُّهُ ، السَّمَوَاتُ وَالأَرْضُونَ ، وَمَنْ فِيهِنَّ ، وَمَا بَيْنَهُنَّ ، مِمَّا يُعْلَمُ وَمِمَّا لا يُعْلَمُ \""@ar ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2> .

