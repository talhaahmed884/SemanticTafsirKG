<http://www.semantictafsir.com/resource/hadith/125/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L572" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/125/text/1/segment/1> ;
    st:hasText "عِيسَى ابْنَ مَرْيَمَ أَسْلَمَتْهُ أُمُّهُ إِلَى الْكُتَّابِ لِيُعَلِّمَهُ ، فَقَالَ لَهُ الْمُعَلِّمُ : اكْتُبْ بِاسْمِ ، فَقَالَ لَهُ عِيسَى : وَمَا بِاسْمِ ؟ فَقَالَ لَهُ الْمُعَلِّمُ : مَا أَدْرِي ، فَقَالَ لَهُ عِيسَى : الْبَاءُ : بَهَاءُ اللَّهِ ، وَالسِّينِ : سَنَاؤُهُ ، وَالْمِيمُ : مَمْلَكَتُهُ \""@ar .

<http://www.semantictafsir.com/resource/hadith/125/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L572" ;
