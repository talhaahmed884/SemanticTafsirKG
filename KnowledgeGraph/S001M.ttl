    st:hasTheme <http://www.semantictafsir.com/resource/theme/ktub> .

<http://www.semantictafsir.com/resource/commentary/1.12/32/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1974" ;
    st:hasText "انْتَقَمْنَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sawabiqab> .

<http://www.semantictafsir.com/resource/commentary/1.12/32/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1975" ;
    st:hasText "أَغْرَقْنَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sawabiqab> .

<http://www.semantictafsir.com/resource/commentary/1.12/32/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1979" ;
    st:hasText "غَضَبُ اللَّهِ عَلَى مَنْ غَضِبَ عَلَيْهِ مِنْ عِبَادِهِ ذَمٌّ مِنْهُ لَهُمْ وَلأَفْعَالِهِمْ ، وَشَتْمٌ مِنْهُ لَهُمْ بِالْقَوْلِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/1.12/32/segment/7> a st:Segment ;
    rdfs:label "Segment 7" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1981" ;
    st:hasText "قَالَ بَعْضُهُمُ : الْغَضَبُ مِنْهُ مَعْنَى مَفْهُومٌ ، كَالَّذِي يُعْرَفُ مِنْ مَعَانِي الْغَضَبِ ، غَيْرَ أَنَّهُ وَإِنْ كَانَ كَذَلِكَ مِنْ جِهَةِ الإِثْبَاتِ ، فَمُخَالِفٌ مَعْنَاهُ مِنْهُ مَعْنَى مَا يَكُونُ مِنْ غَضَبِ الآدَمَيِّينِ ، الَّذِينَ يُزْعِجُهُمْ وَيُحَرِّكُهُمْ ، وَيَشُقُّ عَلَيْهِمْ وَيُؤْذِيهِمْ ؛ لأَنَّ اللَّهَ جَلَّ ثَنَاؤُهُ لا تَحِلُّ ذَاتَهُ الآفَاتُ ، وَلَكِنَّهُ لَهُ صِفَةٌ كَمَا الْعِلْمُ لَهُ صِفَةٌ ، وَالْقُدْرَةُ لَهُ صِفَةٌ ، عَلَى مَا يُعْقَلُ مِنْ جِهَةِ الإِثْبَاتِ ، وَإِنْ خَالَفَتْ مَعَانِي ذَلِكَ مَعَانِي عُلُومِ الْعِبَادِ ، الَّتِي هِيَ مَعَارِفُ الْقُلُوبِ ، وَقُوَاهُمُ الَّتِي تُوجَدُ مَعَ وُجُودِ الأَفْعَالِ ، وَتُعْدَمُ مَعَ عَدَمِهَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/1.12/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1654" ;
    st:hasText "يُقَالُ : لا أجلس إِلَّا إلى العالم غَيْر الجاهل ، يراد : لا أجلس إِلا إلى من يعلم ، لا إِلا من يجهل"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.12/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1656" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/2/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/181> ;
    st:hasText "لو كَانَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ معرفة مؤقتة ، كَانَ غَيْر جائز أن يَكُون : غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ لها نعتا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/5dc689230521>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/9461b4987ce7> .

<http://www.semantictafsir.com/resource/commentary/1.12/4/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1658" ;
    st:hasText "معرفة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/4/segment/2/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1661" ;
    st:hasText "نعتا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1661" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/5>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/6>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/7>,
        <http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/8> ;
    st:hasText "خطأ فِي كلام العرب إذا وَصَفْتِ معرفة مؤقتة بنكرة ، أن تلزم نعتها النكرة إعراب المعرفة المنعوت بها ، إِلا عَلَى نية تكرير ما أعرب المنعوت بها . خطأ فِي كلامهم أن يُقَالَ : مررت بعبد الله غَيْر العالم . فتخفض ( غَيْر ) إِلا عَلَى نية تكرير الباء التي أعربت عَبْد الله"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091>,
        <http://www.semantictafsir.com/resource/entity/person/cab33c7d10ae> .

<http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/1> a st:Segment ;
