    st:hasText "النَّعِيمِ وَالْكَرَامَةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sawabiqab> .

<http://www.semantictafsir.com/resource/commentary/0.16/3/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L818" ;
    st:hasText "لِجَمِيعِهِمَا عِنْدَنَا فِي الصِّحَّةِ مَخْرَجٌ ، فَلا وَجْهَ لِقَوْلِ قَائِلٍ : أَيُّهُمَا أَوْلَى بِالصِّحَّةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lrajeh> .

<http://www.semantictafsir.com/resource/commentary/0.16/3/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L821" ;
    st:hasText "بِالرَّحْمَنِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/0.16/3/segment/7> a st:Segment ;
    rdfs:label "Segment 7" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L822" ;
    st:hasText "الرَّحِيمِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/0.16/3/segment/8> a st:Segment ;
    rdfs:label "Segment 8" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L823" ;
    st:hasText "أَنَّهُ بِالتَّسْمِيَةِ بِالرَّحْمَنِ مَوْصُوفٌ بِعُمُومِ الرَّحْمَةِ جَمِيعَ خَلْقِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/0.16/3/segment/9> a st:Segment ;
    rdfs:label "Segment 9" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L825" ;
    st:hasText "أَنَّهُ بِالتَّسْمِيَةِ بِالرَّحِيمِ مَوْصُوفٌ بِخُصُوصِ الرَّحْمَةِ بَعْضَ خَلْقِهِ ،"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

