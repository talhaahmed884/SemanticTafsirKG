    st:hasTheme <http://www.semantictafsir.com/resource/theme/qiraat> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/4/fragment/aba0253a5eef> .

<http://www.semantictafsir.com/resource/commentary/1.4/6/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L446" ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/149> ;
    st:hasText "فالذي هُوَ أولى أن يَكُون مجاور وصفه بالمُلك أَوِ المِلك ما كَانَ نظير ذَلِكَ من الوصف ، وذلك هُوَ قوله : رَبِّ الْعَالَمِينَ الَّذِي هُوَ خبر عَنْ ملكه جميع أجناس الخلق ، وأن يَكُون مجاور وصفه بالعظمة والألوهة ما كَانَ لَهُ نظيرا فِي المعنى من الثناء عَلَيْه"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.4/6/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L452" ;
    st:hasText "قوله : الرَّحْمَنِ الرَّحِيمِ بمعنى التقديم قبل : رَبِّ الْعَالَمِينَ . وإن كَانَ فِي الظاهر مؤخرا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.4/7/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L458" ;
    st:hasText """طاف الخيال وأين منك لماما
فارجع لزورك بالسلام سلاما"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.4/7/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L464" ;
    st:hasText "بمعنى : طاف الخيال لماما ، وأين هُوَ منك"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.4/8> a st:Commentary ;
    rdfs:label "Commentary 8" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L466" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.4/7> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.4/8/segment/1> ;
    st:hasCommentaryNo 8 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/11579649> ;
    st:hasText "الْحَمْدُ لِلَّهِ الَّذِي أَنْزَلَ عَلَى عَبْدِهِ الْكِتَابَ وَلَمْ يَجْعَلْ لَهُ عِوَجَا . بمعنى : الحمد للَّه الَّذِي أنزل عَلَى عبده الكتاب قيما وَلَم يجعل لَهُ عوجا . وما أشبه ذَلِكَ . فَفِي ذَلِكَ دليل شاهد عَلَى صحة قول من أنكر أن تكون : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ من فاتحة الكتاب آية ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b> ;
    st:references <http://www.semantictafsir.com/resource/commentary/1.4/8/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1>,
        <http://www.semantictafsir.com/resource/quran/verse/18/1> .

<http://www.semantictafsir.com/resource/commentary/1.4/8/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L468" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.4/8/segment/1/segment/1> ;
    st:hasText "الحمد للَّه الَّذِي أنزل عَلَى عبده الكتاب قيما وَلَم يجعل لَهُ عوجا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

