<http://www.semantictafsir.com/resource/hadith/172> a hadith:Hadith ;
    rdfs:label "Hadith 172" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1550" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/171> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/172/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/172/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/172/chain/1/link/3/narrator> ;
    st:hasHadithNo 172 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/263> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/172/note/1> ;
    st:hasText "حَدَّثَنِي يُونُسُ ، قَالَ : أَخْبَرَنَا ابْنُ وَهْبٍ ، قَالَ : قَالَ عَبْدُ الرَّحْمَنِ بْنُ زَيْدٍ ، فِي قَوْلِ اللَّهِ : \" صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ ، قَالَ : النَّبِيُّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَمَنْ مَعَهُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> .

