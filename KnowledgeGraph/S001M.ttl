<http://www.semantictafsir.com/resource/hadith/187> a hadith:Hadith ;
    rdfs:label "Hadith 187" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2142" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/186> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/187/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/187/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasHadithNo 187 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/284> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/187/note/1> ;
    st:hasText "حَدَّثَنَا عَلِيُّ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا مُسْلِمُ بْنُ عَبْدِ الرَّحْمَنِ ، قَال : حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ ، عَنْ حَمَّادِ بْنِ سَلَمَةَ ، عَنْ سِمَاكِ بْنِ حَرْبٍ ، عَنْ مُرِّيِّ بْنِ قَطَرِيٍّ ، عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : سَأَلْتُ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ عَنْ قَوْلِ اللَّهِ : وَلا الضَّالِّينَ ، قَالَ : \" النَّصَارَى هُمُ الضَّالُّونَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

