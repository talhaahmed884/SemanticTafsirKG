<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1773" ;
    st:hasText "جحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1773" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2/segment/5>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2/segment/6> ;
    st:hasText "قالوا : لَمْ نجد فِي شيء من كلام العرب استثناء يعطف عَلَيْه بجحد ، وإنما وجدناهم يعطفون عَلَى الاستثناء بالاستثناء ، وبالجحد عَلَى الجحد ، فيقولون فِي الاستثناء : قام القوم إِلا أخاك وإلا أباك"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/2/segment/1> a st:Segment ;
