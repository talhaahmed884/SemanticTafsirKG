<http://www.semantictafsir.com/resource/hadith/167/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1461" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/167/text/1/segment/1> ;
    st:hasText "ضَرَبَ اللَّهُ مَثَلا صِرَاطًا مُسْتَقِيمًا ، وَالصِّرَاطُ الإِسْلامُ \""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/ad81fe9e37ba> .

