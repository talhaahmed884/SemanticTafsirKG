<http://www.semantictafsir.com/resource/hadith/121/chain/1/link/1/narrator> a hadith:HadithNarrator ;
    rdfs:label "Narrator: يُونُسُ بْنُ عَبْدِ الأَعْلَى" ;
    hadith:heardFrom <http://www.semantictafsir.com/resource/hadith/121/chain/1/link/2/narrator> ;
    st:hasName "يُونُسُ بْنُ عَبْدِ الأَعْلَى"@ar ;
