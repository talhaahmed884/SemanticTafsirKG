<http://www.semantictafsir.com/resource/hadith/132/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L897" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/132/text/1/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/132/text/1/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/129> ;
    st:hasText "الرَّحْمَنِ الْفَعْلانُ مِنَ الرَّحْمَةِ ، وَهُوَ مِنْ كَلامِ الْعَرَبِ ، قَالَ : الرَّحْمَنِ الرَّحِيمِ : الرَّقِيقُ الرَّفِيقُ بِمَنْ أَحَبَّ أَنْ يَرْحَمَهُ ، وَالْبَعِيدُ الشَّدِيدُ عَلَى مَنْ أَحَبَّ أَنْ يُعَنِّفَ عَلَيْهِ ، وَكَذَلِكَ أَسْمَاؤُهُ كُلُّهَا \""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/hadith/132/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L898" ;
    st:hasText "الرَّحْمَنِ الْفَعْلانُ مِنَ الرَّحْمَةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/a7c6cfbd6f74> .

<http://www.semantictafsir.com/resource/hadith/132/text/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L901" ;
    st:hasText "الرَّحْمَنِ الرَّحِيمِ : الرَّقِيقُ الرَّفِيقُ بِمَنْ أَحَبَّ أَنْ يَرْحَمَهُ ، وَالْبَعِيدُ الشَّدِيدُ عَلَى مَنْ أَحَبَّ أَنْ يُعَنِّفَ عَلَيْهِ ، وَكَذَلِكَ أَسْمَاؤُهُ كُلُّهَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:references <http://www.semantictafsir.com/resource/hadith/132/text/1/segment/2/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/hadith/132/text/1/segment/2/thematic-reference/2> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1/fragment/dbed01ba3bf8> .

