    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1866" ;
    st:hasText "أَنَّ رَجُلا أَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحَاصِرٌ وَادِي الْقُرَى ، فَقَالَ : مَنْ هَؤُلاءِ الَّذِينَ تُحَاصِرُ يَا رَسُولَ اللَّهِ ؟ قَالَ : \" هَؤُلاءِ الْمَغْضُوبُ عَلَيْهِمُ الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sghazawat> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/2464d13dfe4e> .

