<http://www.semantictafsir.com/resource/hadith/129> a hadith:Hadith ;
    rdfs:label "Hadith 129" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L665" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/128> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/129/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/129/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/129/chain/1/link/5/narrator> ;
    st:hasHadithNo 129 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/196> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/129/note/1> ;
    st:hasText "وَحَدَّثَنَا الْقَاسِمُ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ بْنُ دَاوُدَ ، قَالَ : حَدَّثَني حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، عَنْ مُجَاهِدٍ ، قَوْلَهُ : \" وَيَذَرَكَ وَإِلاهَتَكَ \" ، قَالَ : وَعِبَادَتَكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> .

