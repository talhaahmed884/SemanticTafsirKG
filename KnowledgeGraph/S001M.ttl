    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/4/segment/3/segment/8> a st:Segment ;
    rdfs:label "Segment 8" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1668" ;
    st:hasText "المنعوت"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/5/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1671" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/5/segment/1/segment/1> ;
    st:hasText "كأن معنى ذَلِكَ لو قِيلَ كذلك : مررت بعبد الله ، مررت بغير العالم . فهذا أحد وجهي الخفض فِي غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/cab33c7d10ae> .

<http://www.semantictafsir.com/resource/commentary/1.12/5/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1673" ;
    st:hasText "الخفض"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/5/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1674" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/5/segment/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/5/segment/2/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/5/segment/2/segment/3> ;
    st:hasText "الوجه الآخر من وجهي الخفض فيها ، أن يَكُون : الَّذِينَ بمعنى المعرفة المؤقتة ، وَإِذَا وجه إلى ذَلِكَ ، كَانَتْ : غَيْرِ مخفوضة بنية تكرير الصراط الَّذِي خفض الَّذِينَ ، عَلَيْهَا ، فكأنك قُلْتَ : صراط الَّذِين أنعمت عليهم ، صراط غَيْر المغضوب عليهم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/0a35d7b453b3>,
        <http://www.semantictafsir.com/resource/quran/fragment/d21bd175cec8> .

