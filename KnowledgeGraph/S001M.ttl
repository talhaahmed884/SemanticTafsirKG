    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L784" ;
    st:hasText "المجازاة بالأعمال"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sawabiqab> .

<http://www.semantictafsir.com/resource/commentary/1.6/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L795" ;
    st:hasText "ما تجزي تجازى"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.6/1/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L798" ;
    st:hasText "الجزاء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sawabiqab> .

<http://www.semantictafsir.com/resource/commentary/1.6/2/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L802" ;
    st:hasText "غَيْرَ مَدِينِينَ . يعني : مجزيين بأعمالكم وَلا محاسبين"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/56/86/fragment/d8c14a595c94> .

<http://www.semantictafsir.com/resource/commentary/1.6/2/thematic-reference/2> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L803" ;
    st:hasText "مجزيين"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sawabiqab> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/56/86/fragment/d8c14a595c94> .

<http://www.semantictafsir.com/resource/commentary/1.6/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L805" ;
    st:hasText "للدين معان فِي كلام العرب غَيْر معنى الحساب والجزاء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.6/4/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L809" ;
    st:hasText "يَوْمِ الدِّينِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/4/fragment/ec677a26df99> .

<http://www.semantictafsir.com/resource/commentary/1.6/9> a st:Commentary ;
    rdfs:label "Commentary 9" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L863" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/152> ;
    st:hasCommentaryNo 9 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/16752385> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/233> .

<http://www.semantictafsir.com/resource/commentary/1.7/3/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L893" ;
    st:hasText """تُبَارِي عِتَاقًا نَاجِيَاتٍ وَأَتْبَعَتْ
وَظِيفًا وَظِيفًا فَوْقَ مَوْرٍ مُعَبَّدِ"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.7/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L883" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.7/3/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.7/3/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.7/3/segment/1/segment/3> ;
    st:hasText "إِنَّمَا اخْتَرْنَا الْبَيَانَ عَنْ تَأْوِيلِهِ بِأَنَّهُ بِمَعْنَى : نَخْشَعُ ، وَنَذِلُّ وَنَسْتَكِينُ ، دُونَ الْبَيَانِ عَنْهُ بِأَنَّهُ بِمَعْنَى : نَرْجُو وَنَخَافُ ، وَإِنْ كَانَ الرَّجَاءُ وَالْخَوْفُ لا يَكُونَانِ إِلا مَعَ ذِلَّةٍ ؛ لأَنَّ الْعُبُودِيَّةَ عِنْدَ جَمِيعِ الْعَرَبِ أَصْلُهَا الذِّلَّةُ ، وَأَنَّهَا تُسَمِّي الطَّرِيقَ الْمُذَلَّلَ الَّذِي قَدْ وَطِئَتْهُ الأَقْدَامُ ، وَذَلَّلَتْهُ السَّابِلَةُ مُعَبَّدًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lrajeh> .

<http://www.semantictafsir.com/resource/commentary/1.7/3/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L886" ;
    st:hasText "الرَّجَاءُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sufiterm> .

<http://www.semantictafsir.com/resource/commentary/1.7/3/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L887" ;
    st:hasText "الْخَوْفُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sufiterm> .

<http://www.semantictafsir.com/resource/commentary/1.7/3/segment/1/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L888" ;
    st:hasText "الْعُبُودِيَّةَ عِنْدَ جَمِيعِ الْعَرَبِ أَصْلُهَا الذِّلَّةُ ، وَأَنَّهَا تُسَمِّي الطَّرِيقَ الْمُذَلَّلَ الَّذِي قَدْ وَطِئَتْهُ الأَقْدَامُ ، وَذَلَّلَتْهُ السَّابِلَةُ مُعَبَّدًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.7/3/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L898" ;
    st:hasText "يَعْنِي بِالْمَوْرِ : الطَّرِيقَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.7/3/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L899" ;
    st:hasText "الْمُعَبَّدِ الْمُذَلَّلِ : الْمَوْطُوءَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.7/4> a st:Commentary ;
    rdfs:label "Commentary 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L901" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.7/3> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.7/4/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.7/4/segment/2> ;
    st:hasCommentaryNo 4 ;
    st:hasText "وَمِنْ ذَلِكَ قِيلَ لِلْبَعِيرِ الْمُذَلَّلِ بِالرُّكُوبِ فِي الْحَوَائِجِ : مُعَبَّدٌ ، وَمِنْهُ سُمِّيَ الْعَبْدُ عَبْدًا لِذِلَّتِهِ لِمَوْلاهُ ، وَالشَّوَاهِدُ عَلَى ذَلِكَ مِنْ أَشْعَارِ الْعَرَبِ وَكَلامِهَا أَكْثَرُ مِنْ أَنْ تُحْصَى ، وَفِيمَا ذَكَرْنَاهُ كِفَايَةٌ لِمَنْ وُفِّقَ لِفَهْمِهِ ، إِنْ شَاءَ اللَّهُ تَعَالَى ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.7/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L901" ;
    st:hasText "مِنْ ذَلِكَ قِيلَ لِلْبَعِيرِ الْمُذَلَّلِ بِالرُّكُوبِ فِي الْحَوَائِجِ : مُعَبَّدٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.7/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L903" ;
    st:hasText "مِنْهُ سُمِّيَ الْعَبْدُ عَبْدًا لِذِلَّتِهِ لِمَوْلاهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.8/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L914" ;
    st:hasText "وإياك يا ربنا نستعين عَلَى عبادتنا إياك وطاعتنا فِي أمورنا كلها ، لا أحدا سواك"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.8/10/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1042" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.8/10/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.8/10/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.8/10/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.8/10/segment/1/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/1.8/10/segment/1/segment/5> ;
    st:hasText "فَيُقَالُ : اللَّهُمَّ إِنَّا نَعْبُدُكَ ، وَنَسْتَعِينُكَ ، وَنَحْمَدُكَ ، وَنَشْكُرُكَ ، وَكَانَ ذَلِكَ أَفْصَحَ فِي كَلامِ الْعَرَبِ مِنْ أَنْ يُقَالَ : اللَّهُمَّ إِنَّا نَعْبُدُكَ وَنَسْتَعِينُ وَنَحْمَدُ ، كَانَ كَذَلِكَ إِذَا قُدِّمَتْ كِنَايَةُ اسْمِ الْمُخَاطَبِ قَبْلَ الْفِعْلِ مَوْصُولَةً بـ ( إِيَّا ) ، كَانَ الأَفْصَحُ إِعَادَتَهَا مَعَ كُلِّ فِعْلٍ ، كَمَا كَانَ الْفَصِيحُ مِنَ الْكَلامِ إِعَادَتَهَا مَعَ كُلِّ فِعْلٍ ، إِذَا كَانَتْ بَعْدَ الْفِعْلِ مُتَّصِلَةً بِهِ ، وَإِنْ كَانَ تَرْكُ إِعَادَتِهَا جَائِزًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

