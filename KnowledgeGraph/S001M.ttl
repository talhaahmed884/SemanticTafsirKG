    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/5/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L393" ;
