<http://www.semantictafsir.com/resource/hadith/151> a hadith:Hadith ;
    rdfs:label "Hadith 151" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L844" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/150> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/151/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/151/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/151/chain/1/link/4/narrator> ;
    st:hasHadithNo 151 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/231> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/151/note/1> ;
    st:hasText "حَدَّثَنَا الْحَسَنُ بْنُ يَحْيَى ، قَالَ : أَخْبَرَنَا عَبْدُ الرَّزَّاقِ ، قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ قَتَادَةَ ، فِي قَوْلِهِ : \" مَالِكِ يَوْمِ الدِّينِ ، قَالَ : يَوْمَ يُدِينُ اللَّهُ الْعِبَادَ بِأَعْمَالِهِمْ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

