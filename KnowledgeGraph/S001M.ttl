<http://www.semantictafsir.com/resource/hadith/196> a hadith:Hadith ;
    rdfs:label "Hadith 196" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2268" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/195> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/196/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/196/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/196/chain/1/link/3/narrator> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/197> ;
    st:hasHadithNo 196 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/295> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/196/note/1> ;
    st:hasText "حَدَّثَنِي يُونُسُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : أَخْبَرَنَا ابْنُ وَهْبٍ ، قَالَ : قَالَ عَبْدُ الرَّحْمَنِ بْنُ زَيْدٍ : \" وَلا الضَّالِّينَ : النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/196/chain/1/link/3> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 3" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/hadith/196/chain/1/link/3/narrator> ;
    st:hasType "rawi" .

<http://www.semantictafsir.com/resource/hadith/196/chain/1/link/3/narrator> a hadith:HadithNarrator,
        hadith:RootNarrator ;
    rdfs:label "Narrator: عَبْدُ الرَّحْمَنِ بْنُ زَيْدٍ" ;
    st:hasName "عَبْدُ الرَّحْمَنِ بْنُ زَيْدٍ"@ar ;
    st:hasNarratorType nt:rawi .

<http://www.semantictafsir.com/resource/hadith/197> a hadith:Hadith ;
    rdfs:label "Hadith 197" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2276" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/196> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/197/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/197/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/197/chain/1/link/4/narrator> ;
    st:hasHadithNo 197 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/296> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/197/note/1> ;
    st:hasText "حَدَّثَنِي يُونُسُ ، قَالَ : أَخْبَرَنَا ابْنُ وَهْبٍ ، قَالَ : حَدَّثَنَا عَبْدُ الرَّحْمَنِ بْنُ زَيْدٍ ، عَنْ أَبِيهِ ، قَالَ : وَلا الضَّالِّينَ : النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

