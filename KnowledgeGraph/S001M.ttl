<http://www.semantictafsir.com/resource/hadith/170> a hadith:Hadith ;
    rdfs:label "Hadith 170" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1534" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.11/6> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/170/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/170/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 170 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/261> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/170/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ ، قَالَ : حَدَّثَنِي حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : \" أَنْعَمْتَ عَلَيْهِمْ ، قَالَ : الْمُؤْمِنِينَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/170/chain/1/link/5> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 5" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/171> a hadith:Hadith ;
    rdfs:label "Hadith 171" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1543" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/170> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/171/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/171/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/171/chain/1/link/3/narrator> ;
    st:hasHadithNo 171 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/262> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/171/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ ، قَالَ : قَالَ وَكِيعٌ : \" أَنْعَمْتَ عَلَيْهِمْ : الْمُسْلِمِينَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

