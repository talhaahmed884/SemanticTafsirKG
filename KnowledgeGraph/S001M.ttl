<http://www.semantictafsir.com/resource/hadith/148/text/1/thematic-reference/3> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L532" ;
    st:hasText "لا يَتَكَلَّمُونَ إِلا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/78/38/fragment/fc5c1fa10bc6> .

<http://www.semantictafsir.com/resource/hadith/148/text/2> a hadith:HadithText ;
    rdfs:label "Hadith Text 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L534" ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/151> ;
    st:hasText "، وَقَالَ : وَخَشَعَتِ الأَصْوَاتُ لِلرَّحْمَنِ ، وَقَالَ : وَلا يَشْفَعُونَ إِلا لِمَنِ ارْتَضَى \""@ar ;
    st:references <http://www.semantictafsir.com/resource/hadith/148/text/2/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/hadith/148/text/2/thematic-reference/2> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/20/108/fragment/f8f2df6f7ae5>,
        <http://www.semantictafsir.com/resource/quran/verse/21/28/fragment/610435d24b76> .

<http://www.semantictafsir.com/resource/hadith/148/text/2/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L535" ;
    st:hasText "وَخَشَعَتِ الأَصْوَاتُ لِلرَّحْمَنِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/20/108/fragment/f8f2df6f7ae5> .

