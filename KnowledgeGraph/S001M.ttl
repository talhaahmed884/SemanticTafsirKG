        <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2>,
        <http://www.semantictafsir.com/resource/entity/other/8c7140194441>,
        <http://www.semantictafsir.com/resource/entity/other/cea9503321ad>,
        <http://www.semantictafsir.com/resource/entity/other/efa52dfbd171>,
        <http://www.semantictafsir.com/resource/entity/other/f1fd820eca2e>,
        <http://www.semantictafsir.com/resource/entity/person/4ce9591136a3>,
        <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/commentary/1.14/1/thematic-reference/1> ;
