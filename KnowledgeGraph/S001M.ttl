<http://www.semantictafsir.com/resource/hadith/168/note/1> a st:Note ;
    rdfs:label "Note 1" ;
    st:hasText "168 /3 /140" .

<http://www.semantictafsir.com/resource/hadith/168/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1519" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/168/text/1/segment/1> ;
    st:hasText "صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ ، يَقُولُ : طَرِيقَ مَنْ أَنْعَمْتَ عَلَيْهِمْ مِنَ الْمَلائِكَةِ ، وَالنَّبِيِّينَ ، وَالصِّدِّيقِينَ ، وَالشُّهَدَاءِ ، وَالصَّالِحِينَ ، الَّذِينَ أَطَاعُوكَ وَعَبَدُوكَ \""@ar ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/4314d74e46ad> .

<http://www.semantictafsir.com/resource/hadith/168/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1521" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/168/text/1/segment/1/segment/1> ;
    st:hasText "طَرِيقَ مَنْ أَنْعَمْتَ عَلَيْهِمْ مِنَ الْمَلائِكَةِ ، وَالنَّبِيِّينَ ، وَالصِّدِّيقِينَ ، وَالشُّهَدَاءِ ، وَالصَّالِحِينَ ، الَّذِينَ أَطَاعُوكَ وَعَبَدُوكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

