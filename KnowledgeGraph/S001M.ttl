<http://www.semantictafsir.com/resource/commentary/1.5/10/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L583" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.5/10/segment/1/segment/1> ;
    st:hasText "الْمَعْنَى الَّذِي فِي قَوْلِهِ : مَلِكِ يَوْمِ الدِّينِ ، وَهُوَ وَصْفُهُ بِأَنَّهُ الْمَلِكُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> .

