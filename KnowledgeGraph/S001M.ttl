<http://www.semantictafsir.com/resource/commentary/0.16/7/segment/16> a st:Segment ;
    rdfs:label "Segment 16" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L1041" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.16/7/segment/16/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.16/7/segment/16/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/0.16/7/segment/16/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/0.16/7/segment/16/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/0.16/7/segment/16/segment/5> ;
    st:hasText "الاسْمُ مُقَدَّمًا قَبْلَ نَعْتِهِ وَصِفَتِهِ ، لِيَعْلَمَ السَّامِعُ الْخَبَرَ عَمَّنِ الْخَبَرُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

