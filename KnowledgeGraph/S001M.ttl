<http://www.semantictafsir.com/resource/commentary/1.8/11/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1055" ;
    st:hasText """وَجَاعِلُ الشَّمْسِ مِصْرًا لا خِفَاءَ بِهِ
بَيْنَ النَّهَارِ وَبَيْنَ اللَّيْلِ قَدْ فَصَلا"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/63902b83b5eb>,
        <http://www.semantictafsir.com/resource/entity/time/6ca3e70cdabd>,
        <http://www.semantictafsir.com/resource/entity/time/cdb40bbe6ac4> .

<http://www.semantictafsir.com/resource/commentary/1.8/11/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1060" ;
    st:hasText """بَيْنَ الأَشَجِّ وَبَيْنَ قَيْسٍ بَاذِخٌ
بَخْ بَخْ لِوَالِدِهِ وَلِلْمَوْلُودِ"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/adc9174fdfc0>,
        <http://www.semantictafsir.com/resource/entity/person/e37a342058bd> .

<http://www.semantictafsir.com/resource/commentary/1.8/12/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1068" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.8/12/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.8/12/segment/1/segment/2> ;
    st:hasText "حَظَّ ( إِيَّاكَ ) أَنْ تَكُونَ مُكَرَّرَةً مَعَ كُلِّ فِعْلٍ ؛ لِمَا وَصَفْنَا آنِفًا مِنَ الْعِلَّةِ ، وَلَيْسَ ذَلِكَ حُكْمَ ( بَيْنَ ) ؛ لأَنَّهَا لا تَكُونُ إِذَا اقْتَضَتِ اثْنَيْنِ إِلا تَكْرِيرًا إِذَا أُعِيدَتْ ، إِذْ كَانَتْ لا تَنْفَرِدُ بِالْوَاحِدِ ، وَأَنَّهَا لَوْ أُفْرِدَتْ بِأَحَدِ الاسْمَيْنِ فِي حَالِ اقْتِضَائِهَا اثْنَيْنِ كَانَ الْكَلامُ كَالْمُسْتَحِيلِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.8/12/segment/1/segment/1> a st:Segment ;
