<http://www.semantictafsir.com/resource/commentary/0.16/10> a st:Commentary ;
    rdfs:label "Commentary 10" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L1113" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/133> ;
    st:hasCommentaryNo 10 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/205> ;
    st:hasText "مَعَ أَنَّ فِي إِجْمَاعِ الأُمَّةِ مِنْ مَنْعِ التَّسَمِّي بِهِ جَمِيعَ النَّاسِ ، مَا يُغْنِي عَنِ الاسْتِشْهَادِ عَلَى صِحَّةِ مَا قُلْنَا فِي ذَلِكَ بِقَوْلِ الْحَسَنِ وَغَيْرِهِ ."@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/d48c73b5abf8> .

