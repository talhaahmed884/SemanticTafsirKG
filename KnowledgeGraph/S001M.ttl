<http://www.semantictafsir.com/resource/hadith/168> a hadith:Hadith ;
    rdfs:label "Hadith 168" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1513" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.11/2> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/168/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/168/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 168 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/257> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/168/note/1> ;
    st:hasText "حَدَّثَنَا مُحَمَّدُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنِ ابْنِ عَبَّاسٍ : \" صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ ، يَقُولُ : طَرِيقَ مَنْ أَنْعَمْتَ عَلَيْهِمْ مِنَ الْمَلائِكَةِ ، وَالنَّبِيِّينَ ، وَالصِّدِّيقِينَ ، وَالشُّهَدَاءِ ، وَالصَّالِحِينَ ، الَّذِينَ أَطَاعُوكَ وَعَبَدُوكَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/168/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
