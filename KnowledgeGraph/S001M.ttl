<http://www.semantictafsir.com/resource/commentary/1.13/6/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2065" ;
    st:hasText "فَمَا ألوم البيض ألا تسخرا"@ar .

<http://www.semantictafsir.com/resource/commentary/1.13/6/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2070" ;
    st:hasText """ما كَانَ يرضى رسول الله فعلهم
والطيبان أَبُو بَكْر وعمر"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/0bb986bab107>,
        <http://www.semantictafsir.com/resource/entity/person/30096e942778> .

<http://www.semantictafsir.com/resource/commentary/1.13/6/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2054" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/6/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.13/6/segment/1/segment/2> ;
    st:hasText "فَفِي شهادة أَهْل المعرفة بلسان العرب عَلَى تخطئة من قَالَ ذَلِكَ دلالة واضحة عَلَى أن ( لا ) لا تأتي مبتدأة بمعنى الحذف ولما يتقدمها جحد . وكان يتأول فِي ( لا ) التي فِي بيت العجاج الَّذِي ذكرنا أَن الْبَصْرِيّ استشهد بِهِ لقوله : أنها جحد صحيح"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/bcdfd9808124>,
        <http://www.semantictafsir.com/resource/entity/organization/20f6ad902620>,
        <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091>,
        <http://www.semantictafsir.com/resource/entity/person/3b4ae287b4eb> .

<http://www.semantictafsir.com/resource/commentary/1.13/6/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2057" ;
    st:hasText "الحذف"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/6/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2058" ;
    st:hasText "جحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/6/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2061" ;
    st:hasText "معنى البيت : سرى فِي بئر لا تحير عَلَيْه خيرًا ، وَلَا يتبين لَهُ فيها أثر عمل ، وَهُوَ لا يشعر بِذَلِك وَلا يدري بِهِ . من قولهم : طحنت الطاحنة فَمَا أحارت شيئًا . أَيْ : لَمْ يتبين لها أثر عمل"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.13/6/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2068" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/6/segment/3/segment/1> ;
    st:hasText "إِنَّمَا جاز أن تكون ( لا ) بمعنى الحذف ؛ لأن الجحد قَدْ تقدمها فِي أول الكلام ، فكان الكلام الآخر مواصلا للأول"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.13/6/segment/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2069" ;
    st:hasText "الجحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2078" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/1/segment/1> ;
    st:hasText "ذ كَانَ قَدْ تقدم الجحد فِي أول الكلام"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2079" ;
    st:hasText "الجحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2080" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2/segment/4> ;
    st:hasText "هذا القول الآخر أولى بالصواب من الأول ، إذ كَانَ غَيْر موجود فِي كلام العرب ابتداء الكلام من غَيْر جحد تقدمه بـ ( لا ) التي معناها الحذف ، وَلَا جائز العطف بها عَلَى ( سوى ) ، وَلَا عَلَى حرف الاستثناء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lrajeh> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2083" ;
    st:hasText "جحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2084" ;
