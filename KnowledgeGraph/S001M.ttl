<http://www.semantictafsir.com/resource/commentary/0.14/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L347" ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/114> ;
    st:hasText "مَعْنَى قَوْلِهِ : بِسْمِ اللَّهِ : أَبْدَأُ بِتَسْمِيَةِ اللَّهِ وَذِكْرِهِ قَبْلَ كُلِّ شَيْءٍ ، أَوْ أَقْرَأُ بِتَسْمِيَةِ اللَّهِ ، أَوْ : أَقُومُ وَأَقْعُدُ بِتَسْمِيَةِ اللَّهِ وَذِكْرِهِ ، لا أنَّهُ يَعْنِي بِقِيلِهِ : بِسْمِ اللَّهِ : أَقُومُ بِاللَّهِ ، أَوْ : أَقْرَأُ بِاللَّهِ . فَيَكُونُ قَوْلُ الْقَائِلِ : أَقْرَأُ بِاللَّهِ ، أَوْ : أَقُومُ ، أَوْ : أَقْعُدُ بِاللَّهِ . أَوْلَى بِوَجْهِ الصَّوَابِ فِي ذَلِكَ مِنْ قَوْلِهِ : بِسْمِ اللَّهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lrajeh>,
        <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1/fragment/4451ad4b0074> .

<http://www.semantictafsir.com/resource/commentary/0.14/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L356" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.14/4/segment/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.14/4/segment/2/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/0.14/4/segment/2/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/0.14/4/segment/2/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/0.14/4/segment/2/segment/5>,
        <http://www.semantictafsir.com/resource/commentary/0.14/4/segment/2/segment/6> ;
    st:hasText "فَإِنْ قَالَ : فَإِنْ كَانَ الأَمْرُ فِي ذَلِكَ عَلَى مَا وَصَفْتَ ، فَكَيْفَ قِيلَ : بِسْمِ اللَّهِ . وَقَدْ عَلِمْتَ أَنَّ الاسْمَ اسْمٌ ، وَأَنَّ التَّسْمِيَةَ مَصْدَرٌ مِنْ قَوْلِكَ : سَمَّيْتُ ؟ قِيلَ : إِنَّ الْعَرَبَ قَدْ تُخْرِجُ الْمَصَادِرَ مُبْهَمَةً عَلَى أَسْمَاءٍ مُخْتَلِفَةٍ ، كَقَوْلِهِمْ : أَكْرَمْتُ فُلانًا كَرَامَةً ، وَإِنَّمَا بِنَاءُ مَصْدَرِ ( أَفْعَلْتُ ) إِذَا أُخْرِجَ عَلَى فِعْلِهِ : الإِفْعَالُ ، وَكَقَوْلِهِمْ : أَهَنْتُ فُلانًا هَوَانًا ، وَكَلَّمْتُهُ كَلامًا ، وَبِنَاءُ مَصْدَرِ ( فَعَلْتُ ) التَّفْعِيلُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1/fragment/4451ad4b0074> .

