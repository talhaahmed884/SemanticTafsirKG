<http://www.semantictafsir.com/resource/commentary/1.9/1/thematic-reference/1> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1092" ;
