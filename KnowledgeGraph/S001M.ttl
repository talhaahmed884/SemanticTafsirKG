<http://www.semantictafsir.com/resource/hadith/144/continuation/1> a hadith:Hadith ;
    rdfs:label "Hadith Continuation 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L361" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/144> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/144/continuation/1/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/144/continuation/1/chain/1/link/4/narrator> ;
    st:hasText "حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ الأَهْوَازِيُّ ، قَالَ : حَدَّثَنَا أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، عَنْ سُفْيَانَ ، عَنْ رَجُلٍ ، عَنْ مُجَاهِدٍ ، بِمِثْلِهِ"@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/8cc2d1f25465> ;
    st:refersTo <http://www.semantictafsir.com/resource/hadith/144> .

