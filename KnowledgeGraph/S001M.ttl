<http://www.semantictafsir.com/resource/hadith/143> a hadith:Hadith ;
    rdfs:label "Hadith 143" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L345" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/142> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/143/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/143/chain/1/link/5/narrator> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/143/segment/1> ;
    st:hasHadithNo 143 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/220> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/143/note/1> ;
    st:hasText "حَدَّثَنِي أَحْمَدُ بْنُ عَبْدِ الرَّحِيمِ الْبَرْقِيُّ ، قَالَ : حَدَّثَنَا ابْنُ أَبِي مَرْيَمَ ، عَنِ ابْنِ لَهِيعَةَ ، عَنْ عَطَاءِ بْنِ دِينَارٍ ، عَنْ سَعِيدِ بْنِ جُبَيْرٍ ، قَوْلَهُ : \" رَبِّ الْعَالَمِينَ ، قَالَ : ابْنُ آدَمَ ، وَالْجِنُّ وَالإِنْسُ ، كُلُّ أُمَّةٍ مِنْهُمْ عَالَمٌ عَلَى حِدَتِهِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/8cc50c90f535> .

