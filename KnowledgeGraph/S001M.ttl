        <http://www.semantictafsir.com/resource/commentary/0.11/6/segment/5> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/108>,
        <http://www.semantictafsir.com/resource/location/book/turki/1/109> ;
    st:hasCommentaryNo 6 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/53807> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/180> ;
    st:hasPart <http://www.semantictafsir.com/resource/commentary/0.11/6/poetry/1>,
        <http://www.semantictafsir.com/resource/commentary/0.11/6/poetry/2> ;
    st:hasText "وَالْمَعْنَى الَّذِي قُلْنَا فِي ذَلِكَ ، قَصَدَ أَبُو النَّجْمِ الْعِجْلِيُّ ، بِقَوْلِهِ : الْحَمْدُ لِلَّهِ الَّذِي عَافَانِي وَكُلَّ خَيْرٍ بَعْدَهُ أَعْطَانِي مِنَ الْقُرَانِ وَمِنَ الْمَثَانِي وَكَذَلِكَ قَوْلُ الرَّاجِزِ الآخَرِ الَّذِي يَقُولُ : نَشَدْتُكُمْ بِمُنْزِلِ الْفُرْقَانِ أُمِّ الْكِتَابِ السَّبْعِ مِنْ مَثَانِي ثُنِّينَ مِنْ آيٍ مِنَ الْقُرْآنِ وَالسَّبْعِ سَبْعِ الطُّوَلِ الدَّوَانِي وَلَيْسَ فِي وُجُوبِ اسْمِ السَّبْعِ الْمَثَانِي لِفَاتِحَةِ الْكِتَابِ مَا يَدْفَعُ صِحَّةَ وُجُوبِ اسْمِ الْمَثَانِي لِلْقُرْآنِ كُلِّهِ ، وَلِمَا ثَنَّى الْمِئِينَ مِنَ السُّوَرِ ؛ لأَنَّ لِكُلِّ ذَلِكَ وَجْهًا وَمَعْنًى مَفْهُومًا ، لا يُفْسِدُ بِتَسْمِيَةِ بَعْضِ ذَلِكَ بِالْمَثَانِي تَسْمِيَةُ غَيْرِهِ بِهَا ، فَأَمَّا وَجْهُ تَسْمِيَةِ مَا ثَنَّى الْمِئِينِ مِنْ سُوَرِ الْقُرْآنِ بِالْمَثَانِي ، فَقَدْ بَيَّنَّا صِحَّتَهُ ، وَسَنُدَلُّ عَلَى صِحَّةِ وَجْهِ تَسْمِيَةِ جَمِيعِ الْقُرْآنِ بِهِ ، عِنْدَ انْتِهَائِنَا إِلَيْهِ فِي سُورَةِ ( الزُّمَرِ ) إِنْ شَاءَ اللَّهُ تَعَالَى ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2>,
        <http://www.semantictafsir.com/resource/entity/other/2d811b4672fb>,
        <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b>,
        <http://www.semantictafsir.com/resource/entity/other/a6da093d16a9>,
        <http://www.semantictafsir.com/resource/entity/person/1e21d9f0091d>,
        <http://www.semantictafsir.com/resource/entity/person/c683fd0e9308> .

<http://www.semantictafsir.com/resource/commentary/0.11/6/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L120" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.11/6/poetry/1/segment/1> ;
    st:hasText """الْحَمْدُ لِلَّهِ الَّذِي عَافَانِي
وَكُلَّ خَيْرٍ بَعْدَهُ أَعْطَانِي
مِنَ الْقُرَانِ وَمِنَ الْمَثَانِي"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2> .

<http://www.semantictafsir.com/resource/commentary/0.11/6/poetry/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L123" ;
    st:hasText "الْقُرَانِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/ktub> .

<http://www.semantictafsir.com/resource/commentary/0.11/6/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L126" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.11/6/poetry/2/segment/1> ;
    st:hasText """نَشَدْتُكُمْ بِمُنْزِلِ الْفُرْقَانِ
أُمِّ الْكِتَابِ السَّبْعِ مِنْ مَثَانِي
ثُنِّينَ مِنْ آيٍ مِنَ الْقُرْآنِ
وَالسَّبْعِ سَبْعِ الطُّوَلِ الدَّوَانِي"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2>,
        <http://www.semantictafsir.com/resource/entity/other/6483d70289a8>,
        <http://www.semantictafsir.com/resource/entity/other/7af94d289306> .

