<http://www.semantictafsir.com/resource/commentary/0.12/1/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L159" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.12/1/segment/4/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.12/1/segment/4/segment/2> ;
    st:hasText "الشيطان فِي كلام العرب كُلّ متمرد من الجن والإنس والدواب وكل شيء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
