<http://www.semantictafsir.com/resource/commentary/1.13/2> a st:Commentary ;
    rdfs:label "Commentary 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2004" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.13/1> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.13/2/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.13/2/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.13/2/segment/4> ;
    st:hasCommentaryNo 2 ;
    st:hasPart <http://www.semantictafsir.com/resource/commentary/1.13/2/poetry/1>,
        <http://www.semantictafsir.com/resource/commentary/1.13/2/poetry/2> ;
    st:hasText "وأن ( لا ) بمعنى الإلغاء والصلة ، ويعتل أيضا لذلك بقول أبي النجم : فَمَا ألوم البيض ألا تسخرا لما رأين الشمط القفندرا وَهُوَ يريد : فَمَا ألوم البيض أن تسخر . وبقول الأحْوَص : ويلحينني فِي اللهو ألا أحبه وللهو داع دائب غَيْر غافل يريد : ويلحينني فِي اللهو أن أحبه . وبقوله تَعَالَى : مَا مَنَعَكَ أَلَّا تَسْجُدَ . يريد : أن تسجد ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/886104f932eb>,
        <http://www.semantictafsir.com/resource/entity/person/e5ab829a4e2a> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/7/12/fragment/60d94b4337e3> .

