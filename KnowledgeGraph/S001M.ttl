<http://www.semantictafsir.com/resource/commentary/0.15/3/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L626" ;
    st:hasText "لِلَّهِ دَرُّ الْغَانِيَاتِ الْمُدَّهِ"@ar .

<http://www.semantictafsir.com/resource/commentary/0.15/3/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L628" ;
    st:hasText "سَبَّحْنَ وَاسْتَرْجَعْنَ مِنْ تَأَلُّهِي"@ar .

<http://www.semantictafsir.com/resource/commentary/0.15/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L615" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/3/segment/1/segment/1> ;
    st:hasText "نْ قَالَ لَنَا قَائِلٌ : فَهَلْ لِذَلِكَ فِي ( فَعَلَ وَيَفْعَلُ ) أَصْلٌ كَانَ مِنْهُ بِنَاءُ هَذَا الاسْمِ ؟ قِيلَ : أَمَّا سَمَاعًا مِنَ الْعَرَبِ فَلا ، وَلَكِنِ اسْتِدْلالا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/0.15/3/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L616" ;
    st:hasText "الاسْمِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.15/3/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L618" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/3/segment/2/segment/1> ;
    st:hasText "فَإِنْ قَالَ : وَمَا دَلَّ عَلَى أَنَّ الأُلُوهِيَّةَ هِيَ الْعِبَادَةُ ، وَأَنَّ الإِلَهَ هُوَ الْمَعْبُودُ ، وَأَنَّ لَهُ أَصْلا فِي ( فَعَلَ وَيَفْعَلُ ؟ ) ؟ قِيلَ : لا تَمَانُعَ بَيْنَ الْعَرَبِ فِي الْحُكْمِ لِقَوْلِ الْقَائِلِ ، يَصِفُ رَجُلا بِعِبَادَةٍ ، وَيَطْلُبُ مَا عِنْدَ اللَّهِ جَلَّ ذِكْرُهُ : تَأَلَّهَ فُلانٌ بِالصِّحَّةِ ، وَلا خِلافَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/0.15/3/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L619" ;
    st:hasText "الأُلُوهِيَّةَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/0.15/3/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L630" ;
    st:hasText "يَعْنِي : مِنْ تَعَبُّدِي وَطَلَبِي اللَّهَ بِعَمَلِي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/0.15/3/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L631" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/3/segment/4/segment/1> ;
    st:hasText "لا شَكَّ أَنَّ التَّأَلُّهَ التَّفَعُّلُ مِنْ : أَلَهَ يَأْلَهُ ، وَأَنَّ مَعْنَى أَلَهَ ، إِذَا نُطِقَ بِهِ : عَبَدَ اللَّهَ ، وَقَدْ جَاءَ مِنْهُ مَصْدَرٌ يَدُلُّ عَلَى أَنَّ الْعَرَبَ قَدْ نَطَقَتْ مِنْهُ بِ ( فَعَلَ يَفْعَلُ ) ، بِغَيْرِ زِيَادَةٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091>,
        <http://www.semantictafsir.com/resource/entity/person/cab33c7d10ae> .

<http://www.semantictafsir.com/resource/commentary/0.15/3/segment/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L634" ;
    st:hasText "مَصْدَرٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.15/8/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L674" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/8/segment/1/segment/1> ;
    st:hasText "لا شَكَّ أَنَّ الإِلاهَةَ ، عَلَى مَا فَسَّرَهُ ابْنُ عَبَّاسٍ وَمُجَاهِدٌ مَصْدَرٌ مِنْ قَوْلِ الْقَائِلِ : أَلَهَ اللَّهَ فُلانٌ إِلاهَةً ، كَمَا يُقَالُ : عَبَدَ اللَّهَ فُلانٌ عُبَادَةً ، وَعَبَرَ الرُّؤْيَا عِبَارَةً"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/29a82ea13b18>,
        <http://www.semantictafsir.com/resource/entity/person/8cc2d1f25465>,
        <http://www.semantictafsir.com/resource/entity/person/cab33c7d10ae> .

<http://www.semantictafsir.com/resource/commentary/0.15/8/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L677" ;
    st:hasText "مَصْدَرٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.15/8/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L680" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/8/segment/2/segment/1> ;
    st:hasText "بَيَّنَ قَوْلُ ابْنِ عَبَّاسٍ وَمُجَاهِدٍ هَذَا أَنَّ ( أَلَهَ ) عَبَدَ ، وَأَنَّ الإِلاهَةَ مَصْدَرُهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/29a82ea13b18>,
        <http://www.semantictafsir.com/resource/entity/person/8cc2d1f25465> .

<http://www.semantictafsir.com/resource/commentary/0.15/8/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L683" ;
    st:hasText "مَصْدَرُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L745" ;
    st:hasText "الرَّحْمَنِ ، فهو فَعْلان ، من رحم ، و الرَّحِيمِ ، فعيل منه"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:references <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/1/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/1/thematic-reference/2> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/a75c8c0f3c1a>,
        <http://www.semantictafsir.com/resource/quran/fragment/a7c6cfbd6f74> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/1/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L746" ;
    st:hasText "الرَّحْمَنِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/a7c6cfbd6f74> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/1/thematic-reference/2> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L748" ;
    st:hasText "الرَّحِيمِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/a75c8c0f3c1a> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L749" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/2/segment/1> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/125> ;
    st:hasText "العرب كثيرًا ما تبني الأسماء من ( فعل يفعل ) على ( فعلان ) ، كقولهم من غضب : غضبان ، ومن سكر : سكران ، ومن عطش : عطشان ، فكذلك قولهم : رحمن ، من رحم ؛ لأن ( فعل ) منه : رحم ، يرحم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L751" ;
    st:hasText "الأسماء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L754" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/5>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/6> ;
    st:hasText "قيل : رحيم ، وإن كانت عين ( فعل ) منه مكسورة ؛ لأنه مدح ، ومن شأن العرب أن يحملوا أبنية الأسماء إذا كان فيها مدح أو ذم على ( فعيل ) ، وإن كانت عين ( فعل ) منها مكسورة أو مفتوحة ، كما قالوا من ( علم ) : عالم وعليم ، ومن ( قدر ) : قادر وقدير ، وليس ذلك منها بناء على أفعالها ؛ لأن البناء من ( فعل يفعل ) ، و ( فعل يفعل ) فاعل ، فلو كان الرحمن والرحيم خارجين على بناء أفعالهما لكانت صورتهما الراحم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L755" ;
    st:hasText "مكسورة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L757" ;
    st:hasText "الأسماء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L758" ;
    st:hasText "مكسورة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L759" ;
    st:hasText "مفتوحة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L761" ;
    st:hasText "أفعال"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/3/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L763" ;
    st:hasText "أفعال"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L763" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/4/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/4/segment/2> ;
    st:hasText "ن قال قائل : فإذا كان الرحمن والرحيم اسمين مشتقين من الرحمة ، فما وجه تكرير ذلك وأحدهما مؤد عَنْ معنى الآخر ؟ قيل له : ليس الأمر فِي ذلك كما ظننت ، بل لكل كلمة منهما معنى لا تؤدي الأخرى منهما عنها"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L764" ;
    st:hasText "اسم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L765" ;
    st:hasText "مشتقين"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L768" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/5/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/5/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/126> ;
    st:hasText "ما المعنى الذي انفردت به كل واحدة منهما ، فصارت إحداهما غير مؤدية المعنى عَنِ الأخرى ؟ قيل : أما من جهة العربية ، فلا تمانع بين أهل المعرفة بلغات العرب أن قول القائل : الرحمن ، عَنْ أبنية الأسماء من ( فعل ويفعل ) أشد عدولا من قوله : الرحيم ، ولا خلاف مع ذلك بينهم أن كل اسم كان له أصل فِي ( فعل ويفعل ) ثم كان عَنْ أصله من ( فعل ويفعل ) أشد عدولا ، أن الموصوف بِهِ مفضل على الموصوف بالاسم المبني على أصله من ( فعل ويفعل ) إذا كانت التسمية به مدحًا أو ذَمًّا ، فهذا ما فِي قول القائل : الرحمن ، من زيادة المعنى على قوله : الرحيم فِي اللغة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091>,
        <http://www.semantictafsir.com/resource/entity/other/9970632f55af> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/5/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L772" ;
    st:hasText "الأسماء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/5/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L776" ;
    st:hasText "الاسم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.16/1/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L782" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/6/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/6/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/0.16/1/segment/6/segment/3> ;
    st:hasText "الْعَرْزَمِيَّ يَقُولُ : الرَّحْمَنِ الرَّحِيمِ ، قَالَ : الرَّحْمَنِ بِجَمِيعِ الْخَلْقِ ، الرَّحِيمِ ، قَالَ : بِالْمُؤْمِنِينَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/dfcfdf0f0ed1>,
        <http://www.semantictafsir.com/resource/entity/person/66f18a722e6f> ;
