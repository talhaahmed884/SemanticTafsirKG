<http://www.semantictafsir.com/resource/commentary/1.5/4/thematic-reference/3> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L512" ;
    st:hasText "يَوْمَ هُمْ بَارِزُونَ لا يَخْفَى عَلَى اللَّهِ مِنْهُمْ شَيْءٌ لِمَنِ الْمُلْكُ الْيَوْمَ لِلَّهِ الْوَاحِدِ الْقَهَّارِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/40/16> .

<http://www.semantictafsir.com/resource/commentary/1.5/6/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L541" ;
    st:hasText "أَصَحُّ الْقِرَاءَتَيْنِ فِي التِّلاوَةِ عِنْدِي التَّأْوِيلُ الأَوَّلُ ، وَقِرَاءَةُ مَنْ قَرَأَ : مَلِكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/qahabsawab> .

