<http://www.semantictafsir.com/resource/hadith/194> a hadith:Hadith ;
    rdfs:label "Hadith 194" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2244" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/193> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/194/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/194/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1131> ;
    st:hasHadithNo 194 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/293> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/194/note/1> ;
    st:hasText "حَدَّثَنِي مُوسَى بْنُ هَارُونَ الْهَمْدَانِيُّ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ حَمَّادٍ ، قَالَ : حَدَّثَنَا أَسْبَاطُ بْنُ نَصْرٍ ، عَنْ إِسْمَاعِيلَ السُّدِّيِّ ، فِي خَبَرٍ ذَكَرَهُ ، عَنْ أَبِي مَالِكٍ ، وَعَنْ أَبِي صَالِحٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَعَنْ مُرَّةَ الْهَمْدَانِيِّ ، عَنِ ابْنِ مَسْعُودٍ ، وَعَنْ نَاسٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَلا الضَّالِّينَ : هُمُ النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/5466e6a00d41> .

