<http://www.semantictafsir.com/resource/commentary/0.16/6/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L984" ;
    st:hasText """أَلا ضَرَبَتْ تِلْكَ الْفَتَاةُ هَجِينَهَا
أَلا قَضَبَ الرَّحْمَنُ رَبِّي يَمِينَهَا"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.16/6/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L990" ;
    st:hasText """عَجِلْتُمْ عَلَيْنَا عَجْلَتَيْنَا عَلَيْكُمْ
وَمَا يَشَأِ الرَّحْمَنُ يَعْقِدُ وَيُطْلِقِ"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.16/6/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L968" ;
    st:hasText "قَالَ الْمُشْرِكُونَ لِلنَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : وَمَا الرَّحْمَنُ أَنَسْجُدُ لِمَا تَأْمُرُنَا . إِنْكَارًا مِنْهُمْ لِهَذَا الاسْمِ ، فَكَأَنَّهُ كَانَ مُحَالا عِنْدَهُ أَنْ يُنْكِرَ أَهْلُ الشِّرْكِ مَا كَانُوا بِصِحَّتِهِ عَالِمِينَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/mushrikin> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/45c5623c04e4>,
        <http://www.semantictafsir.com/resource/entity/organization/5ff8bcc638a3> ;
    st:references <http://www.semantictafsir.com/resource/commentary/0.16/6/segment/1/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/25/60/fragment/9e00207c6bc4> .

<http://www.semantictafsir.com/resource/commentary/0.16/6/segment/1/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L971" ;
    st:hasText "الرَّحْمَنُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/25/60/fragment/9e00207c6bc4> .

<http://www.semantictafsir.com/resource/commentary/0.16/7/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L1007" ;
    st:hasText """وَنَدْمَانٍ يَزِيدُ الْكَأْسَ طِيبًا
سَقَيْتُ وَقَدْ تَغَوَّرَتِ النُّجُومُ"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.16/7/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L997" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.16/7/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.16/7/segment/1/segment/2> ;
    st:hasText "زَعَمَ أَيْضًا بَعْضُ مَنْ ضَعُفَتْ مَعْرِفَتُهُ بِتَأْوِيلِ أَهْلِ التَّأْوِيلِ ، وَقَلَّتْ رِوَايَتُهُ لأَقْوَالِ السَّلَفِ مِنْ أَهْلِ التَّفْسِيرِ ، أَنَّ الرَّحْمَنَ مَجَازُهُ ذُو الرَّحْمَةِ ، وَالرَّحِيمَ مَجَازُهُ الرَّاحِمُ ، ثُمَّ قَالَ : قَدْ يُقَدِّرُونَ اللَّفْظَيْنِ مِنْ لَفْظٍ وَالْمَعْنَى وَاحِدٌ ، وَذَلِكَ لاتِّسَاعِ الْكَلامِ عِنْدَهُمْ ، قَالَ : وَقَدْ فَعَلُوا مِثْلَ ذَلِكَ ، فَقَالُوا : نَدْمَانٌ وَنَدِيمٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/57676dacc48b>,
        <http://www.semantictafsir.com/resource/entity/organization/ac7c0a320365> .

