<http://www.semantictafsir.com/resource/hadith/192> a hadith:Hadith ;
    rdfs:label "Hadith 192" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2214" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/191> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/192/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/192/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 192 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/290> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/192/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنِ ابْنِ عَبَّاسٍ\" وَلا الضَّالِّينَ ، قَالَ : وَغَيْرِ طَرِيقِ النَّصَارَى ، الَّذِينَ أَضَلَّهُمُ اللَّهُ بِفِرْيَتِهِمْ عَلَيْهِ ، قَالَ : يَقُولُ : فَأَلْهِمْنَا دِينَكَ الْحَقَّ ، وَهُوَ لا إِلَهَ إِلا اللَّهُ وَحْدَهُ لا شَرِيكَ لَهُ ، حَتَّى لا تَغْضَبَ عَلَيْنَا كَمَا غَضِبْتَ عَلَى الْيَهُودِ ، وَلا تُضِلَّنَا كَمَا أَضْلَلْتَ النَّصَارَى ، فَتُعَذِّبَنَا بِمَا تُعَذِّبُهُمْ بِهِ ، يَقُولُ : امْنَعْنَا مِنْ ذَلِكَ بِرِفْقِكَ ، وَرَحْمَتِكَ وَقُدْرَتِكَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam> .

<http://www.semantictafsir.com/resource/hadith/192/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/193> a hadith:Hadith ;
    rdfs:label "Hadith 193" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2235" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.13/21> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/193/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/193/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 193 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/292> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/193/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ ، قَالَ : حَدَّثَنِي حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : \" الضَّالِّينَ : النَّصَارَى\""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

