<http://www.semantictafsir.com/resource/hadith/166> a hadith:Hadith ;
    rdfs:label "Hadith 166" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1444" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/165> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/166/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/166/chain/1/link/3/narrator> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/166/segment/1> ;
    st:hasHadithNo 166 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/253> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/166/note/1> ;
    st:hasText "حَدَّثَنِي يُونُسُ بْنُ عَبْدِ الأَعْلَى ، قَالَ : حَدَّثَنَا ابْنُ وَهْبٍ ، قَالَ : قَالَ عَبْدُ الرَّحْمَنِ بْنُ زَيْدِ بْنِ أَسْلَمَ : \" اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ : الإِسْلامَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/ad81fe9e37ba> ;
    st:references <http://www.semantictafsir.com/resource/hadith/166/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6> .

