<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/2/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2086" ;
    st:hasText "الاستثناء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2086" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/3/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/3/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.13/7/segment/3/segment/3> ;
    st:hasText "إنما لـ ( غير ) في كلام العرب معان ثلاثة ؛ أحدها الاستثناء ، والآخر الجحد ، والثالث سوى ، فإذا ثبت خطأ أن ( لا ) تكون بمعنى الإلغاء مبتدأ ، وفسد أن يَكُون عطفا عَلَى غَيْرِ التي مَعَ الْمَغْضُوبِ عَلَيْهِمْ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2088" ;
    st:hasText "الاستثناء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.13/7/segment/3/segment/2> a st:Segment ;
