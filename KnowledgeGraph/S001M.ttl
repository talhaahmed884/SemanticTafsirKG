<http://www.semantictafsir.com/resource/commentary/1.13/1/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2000" ;
    st:hasText "فِي بئر لا حور سرى وما شعر"@ar .

<http://www.semantictafsir.com/resource/commentary/1.13/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1997" ;
    st:hasText "كَانَ بعض أَهْل البصرة يزعم أن ( لا ) مَعَ : الضَّالِّينَ أدخلت تتميما للكلام ، والمعنى إلغاؤها"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/7dcf868fd74e> .

