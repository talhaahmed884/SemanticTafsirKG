<http://www.semantictafsir.com/resource/quran/verse/1/4/fragment/2a427743b804> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:4 (مَالِكِ يَوْمِ الدِّينِ ، بِمَعْنَى …)" ;
    st:hasText "مَالِكِ يَوْمِ الدِّينِ ، بِمَعْنَى : أَنَّهُ يَمْلِكُ الْحُكْمَ بَيْنَهُمْ ،"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/4> .

<http://www.semantictafsir.com/resource/quran/verse/45/16> a st:Verse ;
    rdfs:label "Verse 45:16" ;
    st:hasSurahNo 45 ;
    st:hasText "وَلَقَدْ ءَاتَيْنَا بَنِىٓ إِسْرَٰٓءِيلَ ٱلْكِتَٰبَ وَٱلْحُكْمَ وَٱلنُّبُوَّةَ وَرَزَقْنَٰهُم مِّنَ ٱلطَّيِّبَٰتِ وَفَضَّلْنَٰهُمْ عَلَى ٱلْعَٰلَمِينَ"@ar ;
    st:hasVerseNo 16 .

