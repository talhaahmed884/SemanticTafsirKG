<http://www.semantictafsir.com/resource/hadith/131> a hadith:Hadith ;
    rdfs:label "Hadith 131" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L790" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.16/1> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/131/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/131/chain/1> ;
