<http://www.semantictafsir.com/resource/commentary/1.5/18/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L682" ;
    st:hasText """إِنْ كُنْتَ أَزْنَنْتَنِي بِهَا كَذِبًا
جَزْءُ فَلاقَيْتَ مِثْلَهَا عَجِلا"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.5/18/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L688" ;
    st:hasText """كَذَبْتُمْ وَبَيْتِ اللَّهِ لا تَنْكِحُونَهَا
بَنِي شَابَ قَرْنَاهَا تَصُرُّ وَتَحْلُبُ"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/9b0b45d5588c> .

<http://www.semantictafsir.com/resource/commentary/1.5/18/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L676" ;
    st:hasText "فَنَصَبَهُ بِنِيَّةِ النِّدَاءِ وَالدُّعَاءِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.5/18/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L679" ;
    st:hasText "يَا يُوسُفُ أَعْرِضْ عَنْ هَذَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/7694520808a7> .

<http://www.semantictafsir.com/resource/commentary/1.5/18/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L687" ;
    st:hasText "يَا جَزْءُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.5/18/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L694" ;
    st:hasText "يَا بَنِي شَابَ قَرْنَاهَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/9b0b45d5588c> .

<http://www.semantictafsir.com/resource/commentary/1.5/18/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L696" ;
    st:hasText "بِنَصْبِ الْكَافِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/harakat> .

<http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L701" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1/segment/4> ;
    st:hasText "وِجْهَتَهُ مَعَ جَرِّهِ : مَالِكِ يَوْمِ الدِّينِ وَخَفْضِهِ . فَظَنَّ أَنَّهُ لا يَصِحُّ مَعْنَى ذَلِكَ بَعْدَ جَرِّهِ : مَالِكِ يَوْمِ الدِّينِ ، فَنَصَبَ : مَالِكِ يَوْمِ الدِّينِ لِيَكُونَ : إِيَّاكَ نَعْبُدُ لَهُ خِطَابًا ، كَأَنَّهُ أَرَادَ : يَا مَالِكَ يَوْمِ الدِّينِ ، إِيَّاكَ نَعْبُدُ ، وَإِيَّاكَ نَسْتَعِينُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1/thematic-reference/2>,
        <http://www.semantictafsir.com/resource/commentary/1.5/19/segment/1/thematic-reference/3> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/2ece56e0ebe7>,
        <http://www.semantictafsir.com/resource/quran/verse/1/4>,
        <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/dc23f68cbca2> .

