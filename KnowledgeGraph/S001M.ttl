    st:hasText "مخفوضة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/7/segment/12/segment/2> a st:Segment ;
