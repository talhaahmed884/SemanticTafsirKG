<http://www.semantictafsir.com/resource/hadith/146/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L378" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/146/text/1/segment/1> ;
    st:hasText "رَبِّ الْعَالَمِينَ ، قَالَ : \" الإِنْسُ عَالَمٌ ، وَالْجِنُّ عَالَمٌ ، وَمَا سِوَى ذَلِكَ ثَمَانِيَةَ عَشَرَ أَلْفَ عَالَمٍ ، أَوْ أَرْبَعَةَ عَشَرَ أَلْفَ عالم ، هُوَ يَشُكُّ ، مِنَ الْمَلائِكَةِ عَلَى الأَرْضِ ، وَلِلأَرْضِ أَرْبَعُ زَوَايَا ، فِي كُلِّ زَاوِيَةٍ ثَلاثَةُ آلافِ عَالَمٍ وَخَمْسُ مِائَةِ عَالِمٍ ، خَلَقَهُمْ لِعِبَادَتِهِ \""@ar ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/8cc50c90f535> .

<http://www.semantictafsir.com/resource/hadith/146/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L379" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/146/text/1/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/146/text/1/segment/1/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/147> ;
    st:hasText "الإِنْسُ عَالَمٌ ، وَالْجِنُّ عَالَمٌ ، وَمَا سِوَى ذَلِكَ ثَمَانِيَةَ عَشَرَ أَلْفَ عَالَمٍ ، أَوْ أَرْبَعَةَ عَشَرَ أَلْفَ عالم ، هُوَ يَشُكُّ ، مِنَ الْمَلائِكَةِ عَلَى الأَرْضِ ، وَلِلأَرْضِ أَرْبَعُ زَوَايَا ، فِي كُلِّ زَاوِيَةٍ ثَلاثَةُ آلافِ عَالَمٍ وَخَمْسُ مِائَةِ عَالِمٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kawn> .

