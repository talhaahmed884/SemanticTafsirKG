<http://www.semantictafsir.com/resource/hadith/137> a hadith:Hadith ;
    rdfs:label "Hadith 137" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L81" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.1/6> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/137/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1138> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/137/segment/1> ;
    st:hasHadithNo 137 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/211> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/137/note/1> ;
    st:hasText "حَدَّثَنِي عَلِيُّ بْنُ الْحَسَنِ الْخَرَّازُ ، قَالَ : حَدَّثَنَا مُسْلِمُ بْنُ عَبْدِ الرَّحْمَنِ الْجَرْمِيُّ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ مُصْعَبٍ الْقَرْقَسَانِيُّ ، عَنْ مُبَارَكِ بْنِ فَضَالَةَ ، عَنِ الْحَسَنِ ، عَنِ الأَسْوَدِ بْنِ سَرِيعٍ ، أَنَّ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ قَالَ : \" لَيْسَ شَيْءٌ أَحَبَّ إِلَيْهِ الْحَمْدُ مِنَ اللَّهِ تَعَالَى ، وَلِذَلِكَ أَثْنَى عَلَى نَفْسِهِ ، فَقَالَ : الْحَمْدُ لِلَّهِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sufism> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/0278c0f18853> .

<http://www.semantictafsir.com/resource/hadith/137/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L1138> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/138> a hadith:Hadith ;
    rdfs:label "Hadith 138" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L265" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.2/5> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/138/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/138/segment/1> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/144> ;
    st:hasHadithNo 138 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/213> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/138/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنِ ابْنِ عَبَّاسٍ ، قَالَ : \" قَالَ جِبْرِيلُ لِمُحَمَّدٍ : يَا مُحَمَّدُ ، قُلِ : الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ \" . قَالَ ابْنُ عَبَّاسٍ : \" يَقُولُ : قُلِ : الْحَمْدُ لِلَّهِ الَّذِي لَهُ الْخَلْقُ كُلُّهُ ؛ السَّمَوَاتُ كُلُّهُنَّ وَمَنْ فِيهِنَّ ، وَالأَرْضُونَ كُلُّهُنَّ وَمَنْ فِيهِنَّ ، وَمَا بَيْنَهُنَّ مِمَّا يُعْلَمُ ، وَمِمَّا لا يُعْلَمُ ، يَقُولُ : اعْلَمْ يَا مُحَمَّدُ أَنَّ رَبَّكَ هَذَا لا يُشْبِهُهُ شَيْءٌ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/889d71ecaae5>,
        <http://www.semantictafsir.com/resource/entity/person/29a82ea13b18>,
        <http://www.semantictafsir.com/resource/entity/person/4ce9591136a3> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2> .

