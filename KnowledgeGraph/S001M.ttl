<http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/0278c0f18853> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:2 (الْحَمْدُ لِلَّهِ)" ;
    st:hasText "الْحَمْدُ لِلَّهِ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/2> .

<http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/bb69f8b3de74> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:2 (الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ دُونَ …)" ;
    st:hasText "الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ دُونَ نَصْبِهَا الَّذِي يُؤَدِّي إِلَى الدَّلالَةِ عَلَى أَنَّ مَعْنَى تَالِيهِ كَذَلِكَ : أَحْمَدُ اللَّهَ حَمْدًا ، وَلَوْ قَرَأَ قَارِئٌ ذَلِكَ بِالنَّصْبِ ، لَكَانَ عِنْدِي مُحِيلا مَعْنَاهُ ، وَمُسْتَحِقًّا الْعُقُوبَةَ عَلَى قِرَاءَتِهِ إِيَّاهُ كَذَلِكَ ، إِذَا تَعَمَّدَ قِرَاءَتَهُ كَذَلِكَ ، وَهُوَ عَالِمٌ بِخَطَئِهِ وَفَسَادِ تَأْوِيلِهِ ."@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/2> .

<http://www.semantictafsir.com/resource/quran/verse/1/4/fragment/ec677a26df99> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:4 (يَوْمِ الدِّينِ)" ;
    st:hasText "يَوْمِ الدِّينِ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/4> .

<http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/ea2fedd30108> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:5 (وَإِيَّاكَ نَسْتَعِينُ)" ;
    st:hasText "وَإِيَّاكَ نَسْتَعِينُ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/5> .

<http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/98588a9a1330> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:7 (قَدْ كَانَ بعض نحويي البصريين …)" ;
    st:hasText "قَدْ كَانَ بعض نحويي البصريين يزعم أن قراءة من نَصَبِ ( غير ) فِي غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ عَلَى وجه استثناء : غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ من معاني صفة الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/7> .

<http://www.semantictafsir.com/resource/quran/verse/4/67> a st:Verse ;
    rdfs:label "Verse 4:67" ;
    st:hasSurahNo 4 ;
    st:hasText "وَإِذًا لَّـَٔاتَيْنَٰهُم مِّن لَّدُنَّآ أَجْرًا عَظِيمًا"@ar ;
    st:hasVerseNo 67 .

<http://www.semantictafsir.com/resource/quran/verse/4/68> a st:Verse ;
    rdfs:label "Verse 4:68" ;
    st:hasSurahNo 4 ;
    st:hasText "وَلَهَدَيْنَٰهُمْ صِرَٰطًا مُّسْتَقِيمًا"@ar ;
    st:hasVerseNo 68 .

<http://www.semantictafsir.com/resource/quran/verse/5/77/fragment/d57bc651d48e> a st:VerseFragment ;
    rdfs:label "Verse Fragment 5:77 (يَاأَهْلَ الْكِتَابِ لا تَغْلُوا فِي …)" ;
    st:hasText "يَاأَهْلَ الْكِتَابِ لا تَغْلُوا فِي دِينِكُمْ غَيْرَ الْحَقِّ وَلا تَتَّبِعُوا أَهْوَاءَ قَوْمٍ قَدْ ضَلُّوا مِنْ قَبْلُ وَأَضَلُّوا كَثِيرًا وَضَلُّوا عَنْ سَوَاءِ السَّبِيلِ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/5/77> .

