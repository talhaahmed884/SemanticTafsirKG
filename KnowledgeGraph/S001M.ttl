<http://www.semantictafsir.com/resource/commentary/0.11/6> a st:Commentary ;
    rdfs:label "Commentary 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L118" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/120> ;
