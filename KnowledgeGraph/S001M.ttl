<http://www.semantictafsir.com/resource/hadith/153/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L876" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/153/text/1/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/153/text/1/segment/2> ;
    st:hasText "قَالَ جِبْرِيلُ لِمُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" قُلْ يَا مُحَمَّدُ : إِيَّاكَ نَعْبُدُ ، إِيَّاكَ نُوَحِّدُ وَنَخَافُ ، وَنَرْجُو يَا رَبَّنَا لا غَيْرَكَ \""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/889d71ecaae5>,
        <http://www.semantictafsir.com/resource/entity/person/4ce9591136a3> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/dc23f68cbca2> .

