<http://www.semantictafsir.com/resource/hadith/169> a hadith:Hadith ;
    rdfs:label "Hadith 169" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1526" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.11/4> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/169/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/169/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/169/chain/1/link/4/narrator> ;
    st:hasHadithNo 169 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/259> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/169/note/1> ;
    st:hasText "حَدَّثَنِي أَحْمَدُ بْنُ حَازِمٍ الْغِفَارِيُّ ، قَالَ : أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى ، عَنْ أَبِي جَعْفَرٍ ، عَنْ رَبِيعٍ : \" صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ ، قَالَ : النَّبِيُّونَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> .

