<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L953" ;
    st:hasText "إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ . بِمَعْنَى مَسْأَلَتِهِمْ إِيَّاهُ الْمَعُونَةَ عَلَى الْعِبَادَةِ ، أَدَلُّ الدَّلِيلِ عَلَى فَسَادِ قَوْلِ الْقَائِلِينَ بِالتَّفْوِيضِ مِنْ أَهْلِ الْقَدَرِ الَّذِينَ أَحَالُوا أَنْ يَأْمُرَ اللَّهُ أَحَدًا مِنْ عِبَادِهِ بِأَمْرٍ ، أَوْ يُكَلِّفَهُ فَرْضَ عَمَلٍ إِلا بَعْدَ إِعْطَائِهِ الْمَعُونَةَ وَالْقُدْرَةَ عَلَى فِعْلِهِ ، وَعَلَى تَرْكِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/10> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 10" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L972" ;
    st:hasText "وَفِي إِجْمَاعِ أَهْلِ الإِسْلامِ جَمِيعًا عَلَى تَصْوِيبِ قَوْلِ الْقَائِلِ : اللَّهُمَّ إِنَّا نَسْتَعِينُكَ ، وَتَخْطِئَتِهِمْ قَوْلَ الْقَائِلِ : اللَّهُمَّ لا تَجُرْ عَلَيْنَا ، دَلِيلٌ وَاضِحٌ عَلَى خَطَأِ مَا قَالَ الَّذِينَ وَصَفْتُ قَوْلَهُمْ ، إِذ كَانَ تَأْوِيلُ قَوْلِ الْقَائِلِ عِنْدَهُمُ : اللَّهُمَّ إِنَّا نَسْتَعِينُكَ : اللَّهُمَّ لا تَتْرُكْ مَعُونَتَنَا الَّتِي تَرْكُكَهَا جَوْرٌ مِنْكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/11> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 11" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L978" ;
    st:hasText "اللَّهُمَّ لا تَتْرُكْ مَعُونَتَنَا الَّتِي تَرْكُكَهَا جَوْرٌ مِنْكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/2> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L956" ;
    st:hasText "أَهْلِ الْقَدَرِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/firaq> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/3> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L959" ;
    st:hasText "فَرْضَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/fiqhterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/4> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L961" ;
    st:hasText "وَلَوْ كَانَ الَّذِي قَالُوا مِنْ ذَلِكَ كَمَا قَالُوا ، لَبَطَلَتِ الرَّغْبَةُ إِلَى اللَّهِ فِي الْمَعُونَةِ عَلَى طَاعَتِهِ ، إِذْ كَانَ عَلَى قَوْلِهِمْ مَعَ وُجُودِ الأَمْرِ ، وَالنَّهْيِ ، وَالتَّكْلِيفِ ، حَقًّا وَاجِبًا عَلَى اللَّهِ لِلْعَبْدِ إِعْطَاؤُهُ الْمَعُونَةَ عَلَيْهِ ، سَأَلَهُ ذَلِكَ عَبْدُهُ أَوْ تَرَكَ مَسْأَلَتَهُ ذَلِكَ ، بَلْ تَرْكُ إِعْطَائِهِ ذَلِكَ عِنْدَهُمْ مِنْهُ جَوْرٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/5> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 5" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L964" ;
