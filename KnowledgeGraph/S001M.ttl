    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L1131> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/190> a hadith:Hadith ;
    rdfs:label "Hadith 190" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2193" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/189> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/190/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/190/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4861> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/190/segment/1> ;
    st:hasHadithNo 190 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/288> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/190/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ ، قَالَ : حَدَّثَنَا خَالِدٌ الْوَاسِطِيُّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ ، أَنَّ رَجُلا سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ مُحَاصِرٌ وَادِي الْقُرَى ، وَهُوَ عَلَى فَرَسٍ : مَنْ هَؤُلاءِ ؟ قَالَ : \" الضَّالُّونَ \" . يَعْنِي : النَّصَارَى"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/sirah> .

