<http://www.semantictafsir.com/resource/hadith/180> a hadith:Hadith ;
    rdfs:label "Hadith 180" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1928" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.12/25> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/180/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/180/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/180/chain/1/link/4/narrator> ;
    st:hasHadithNo 180 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/275> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/180/note/1> ;
    st:hasText "حَدَّثَنَا ابْنُ حُمَيْدٍ الرَّازِيُّ ، قَالَ : حَدَّثَنَا مِهْرَانُ ، عَنْ سُفْيَانَ ، عَنْ مُجَاهِدٍ ، قَالَ : \" غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ . قَالَ : هُمُ الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

