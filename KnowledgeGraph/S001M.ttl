        <http://www.semantictafsir.com/resource/hadith/123/text/1/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/hadith/123/text/1/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/hadith/123/text/1/segment/1/segment/4>,
        <http://www.semantictafsir.com/resource/hadith/123/text/1/segment/1/segment/5>,
        <http://www.semantictafsir.com/resource/hadith/123/text/1/segment/1/segment/6> ;
    st:hasText "أَوَّلَ مَا نَزَلَ بِهِ جِبْرِيلُ عَلَى مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يَا مُحَمَّدُ ، قُلْ : أَسْتَعِيذُ بِالسَّمِيعِ الْعَلِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ ، ثُمَّ قَالَ : قُلْ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ، قَالَ : قَالَ لَهُ جِبْرِيلُ : قُلْ : بِسْمِ اللَّهِ يَا مُحَمَّدُ ، يَقُولُ : اقْرَأْ بِذِكْرِ اللَّهِ رَبِّكَ ، وَقُمْ وَاقْعُدْ بِذِكْرِ اللَّهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/aball> ;
