<http://www.semantictafsir.com/resource/commentary/0.14/9/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L482" ;
    st:hasText """إِلَى الْحَوْلِ ثُمَّ اسْمُ السَّلامِ عَلَيْكُمَا
وَمَنْ يَبْكِ حَوْلا كَامِلا فَقَدِ اعْتَذَر"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.14/9/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L496" ;
    st:hasText "ثُمَّ اسْمُ السَّلامِ عَلَيْكُمَا"@ar .

<http://www.semantictafsir.com/resource/commentary/0.14/9/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L487" ;
    st:hasText "قَدْ تَأَوَّلَهُ مُقَدَّمٌ فِي الْعِلْمِ بِلُغَةِ الْعَرَبِ أَنَّهُ مَعْنِيٌّ بِهِ : ثُمَّ السَّلامُ عَلَيْكُمَا ، وَأَنَّ اسْمَ السَّلامِ هُوَ السَّلامُ . قِيلَ لَهُ : لَوْ جَازَ ذَلِكَ وَصَحَّ تَأْوِيلُهُ فِيهِ عَلَى مَا تَأَوَّلَ ، لَجَازَ أَنْ يُقَالَ : رَأَيْتُ اسْمَ زَيْدٍ ، وَأَكَلْتُ اسْمَ الطَّعَامِ ، وَشَرِبْتُ اسْمَ الشَّرَابِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091>,
        <http://www.semantictafsir.com/resource/entity/person/bc030eaa76a5> .

<http://www.semantictafsir.com/resource/commentary/0.15/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L599" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/1/segment/1/segment/1> ;
    st:hasText "اللَّهِ . فَإنَّهُ عَلَى معنى ما رُوِيَ لنا عَنْ عَبْد الله بْن عَبَّاس : هُوَ الَّذِي يألهه كُلّ شيء ، ويعبده كُلّ خلق"@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/c6418b1d94db> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/cb1e0b5dab48> .

<http://www.semantictafsir.com/resource/commentary/0.15/1/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L602" ;
    st:hasText "الَّذِي يألهه كُلّ شيء ، ويعبده كُلّ خلق"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.15/10> a st:Commentary ;
    rdfs:label "Commentary 10" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L712" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/130> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/10/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.15/10/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/0.15/10/segment/3> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/124> ;
    st:hasCommentaryNo 10 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/199> ;
    st:hasPart <http://www.semantictafsir.com/resource/commentary/0.15/10/poetry/1> ;
    st:hasText "أَنْ يُقَالَ : اللَّهُ جلَّ ثناؤُهُ إِلَهُ الْعَبْدِ ، وَالْعَبْدُ أَلَهَهُ ، وَأَنْ يَكُونَ قَوْلُ الْقَائِلِ : اللَّهُ . مِنْ الْكَلامِ أَصْلُهُ الإِلَهُ ، فَإِنْ قَالَ : وَكَيْفَ يَجُوزُ أَنْ يَكُونَ ذَلِكَ كَذَلِكَ ، مَعَ اخْتِلافِ لَفْظَيْهِمَا ؟ ، قَيلَ : كَمَا جَازَ أَنْ يَكُونَ قَوْلُهُ : لَكِنَّا هُوَ اللَّهُ رَبِّي أَصْلُهُ : لَكِنْ أَنَا ، هُوَ اللَّهُ رَبِّي ، كَمَا قَالَ الشَّاعِرُ : وَتَرْمِينَنِي بِالطَّرْفِ أَيْ أَنْتَ مُذْنِبٌ وَتَقْلِينَنِي لَكِنَّا إِيَّاكِ لا أَقْلِي ، يُرِيدُ : لَكِنْ أَنَا إِيَّاكِ لا أَقْلِي ، فَحَذَفَ الْهَمْزَةَ مِنْ ( أَنَا ) ، فَالْتَقَتْ نُونُ ( أَنَا ) وَنُونُ ( لَكِنَّ ) ، وَهِيَ سَاكِنَةٌ ، فَأُدْغِمَتْ فِي نُونِ ( أَنَا ) ، فَصَارَتَا نُونًا مُشَدَّدَةً ، فَكَذَلِكَ اللَّهُ ، أَصْلُهُ الإِلَهُ ، أُسْقِطَتِ الْهَمْزَةُ الَّتِي هِيَ فَاءُ الاسْمِ ، فَالْتَقَتِ اللامُ الَّتِي هِيَ عَيْنُ الاسْمِ ، وَاللامُ الزَّائِدَةُ الَّتِي دَخَلَتْ مَعَ الأَلْفِ الزَّائِدَةِ ، وَهِيَ سَاكِنَةٌ ، فَأُدْغِمَتْ فِي الأُخْرَى ، الَّتِي هِيَ عَيْنُ الاسْمِ ، فَصَارَتَا فِي اللَّفْظِ لامًا وَاحِدَةً مُشَدَّدَةً ، كَمَا وَصَفْنَا مِنْ قَوْلِ اللَّهِ : لَكِنَّا هُوَ اللَّهُ رَبِّي pb ed=\"GK\" edRef=\"42274\" n=\"62\"/>"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/18/38/fragment/4eb22b857ded> .

<http://www.semantictafsir.com/resource/commentary/0.15/10/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L721" ;
    st:hasText """وَتَرْمِينَنِي بِالطَّرْفِ أَيْ أَنْتَ مُذْنِبٌ
وَتَقْلِينَنِي لَكِنَّا إِيَّاكِ لا أَقْلِي"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.15/10/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L713" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.15/10/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.15/10/segment/1/segment/2> ;
    st:hasText "أَنْ يُقَالَ : اللَّهُ جلَّ ثناؤُهُ إِلَهُ الْعَبْدِ ، وَالْعَبْدُ أَلَهَهُ ، وَأَنْ يَكُونَ قَوْلُ الْقَائِلِ : اللَّهُ . مِنْ الْكَلامِ أَصْلُهُ الإِلَهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.15/10/segment/1/segment/1> a st:Segment ;
