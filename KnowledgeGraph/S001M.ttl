<http://www.semantictafsir.com/resource/hadith/124> a hadith:Hadith ;
    rdfs:label "Hadith 124" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L409" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.14/5> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/124/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/124/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 124 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/187> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/124/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، قَالَ : \" أَوَّلُ مَا نَزَلَ جِبْرِيلُ عَلَى مُحَمَّدٍ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : يَا مُحَمَّدُ ، قُلْ أَسْتَعِيذُ بِالسَّمِيعِ الْعَلِيمِ مِنَ الشَّيْطَانِ الرَّجِيمِ ، ثُمَّ قَالَ : قُلْ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ ، قَالَ ابْنُ عَبَّاسٍ : بِسْمِ اللَّهِ ، يَقُولُ لَهُ جِبْرِيلُ : يَا مُحَمَّدُ ، اقْرَأْ بِذِكْرِ اللَّهِ رَبِّكِ ، وَقُمْ وَاقْعُدْ بِذِكْرِ اللَّهِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/sufism> .

<http://www.semantictafsir.com/resource/hadith/124/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
