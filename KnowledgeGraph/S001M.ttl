<http://www.semantictafsir.com/resource/hadith/185> a hadith:Hadith ;
    rdfs:label "Hadith 185" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2118" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.13/10> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/185/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/185/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasHadithNo 185 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/282> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/185/note/1> ;
    st:hasText "قِيلَ : حَدَّثَنَا أَحْمَدُ بْنُ الْوَلِيدِ الرَّمْلِيُّ ، قَالَ : حَدَّثَنَا عَبْدُ اللَّهِ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنِ الشَّعْبِيِّ ، عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" وَلا الضَّالِّينَ ، قَالَ : النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/185/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/186> a hadith:Hadith ;
    rdfs:label "Hadith 186" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2130" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/185> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/186/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/186/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasHadithNo 186 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/283> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/186/note/1> ;
    st:hasText "حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ سِمَاكٍ ، قَالَ : سَمِعْتُ عَبَّادَ بْنَ حُبَيْشٍ يُحَدِّثُ عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ الضَّالِّينَ النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

