<http://www.semantictafsir.com/resource/quran/verse/10/22> a st:Verse ;
    rdfs:label "Verse 10:22" ;
    st:hasSurahNo 10 ;
    st:hasText "هُوَ ٱلَّذِى يُسَيِّرُكُمْ فِى ٱلْبَرِّ وَٱلْبَحْرِ حَتَّىٰٓ إِذَا كُنتُمْ فِى ٱلْفُلْكِ وَجَرَيْنَ بِهِم بِرِيحٍ طَيِّبَةٍ وَفَرِحُوا۟ بِهَا جَآءَتْهَا رِيحٌ عَاصِفٌ وَجَآءَهُمُ ٱلْمَوْجُ مِن كُلِّ مَكَانٍ وَظَنُّوٓا۟ أَنَّهُمْ أُحِيطَ بِهِمْ دَعَوُا۟ ٱللَّهَ مُخْلِصِينَ لَهُ ٱلدِّينَ لَئِنْ أَنجَيْتَنَا مِنْ هَٰذِهِۦ لَنَكُونَنَّ مِنَ ٱلشَّٰكِرِينَ"@ar ;
    st:hasVerseNo 22 .

<http://www.semantictafsir.com/resource/quran/verse/12/29> a st:Verse ;
    rdfs:label "Verse 12:29" ;
    st:hasSurahNo 12 ;
    st:hasText "يُوسُفُ أَعْرِضْ عَنْ هَٰذَا وَٱسْتَغْفِرِى لِذَنۢبِكِ إِنَّكِ كُنتِ مِنَ ٱلْخَاطِـِٔينَ"@ar ;
    st:hasVerseNo 29 .

<http://www.semantictafsir.com/resource/quran/verse/16/121> a st:Verse ;
    rdfs:label "Verse 16:121" ;
    st:hasSurahNo 16 ;
    st:hasText "شَاكِرًا لِّأَنْعُمِهِ ٱجْتَبَىٰهُ وَهَدَىٰهُ إِلَىٰ صِرَٰطٍ مُّسْتَقِيمٍ"@ar ;
    st:hasVerseNo 121 .

