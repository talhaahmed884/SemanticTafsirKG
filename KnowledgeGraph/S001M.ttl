<http://www.semantictafsir.com/resource/hadith/120/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L108" ;
    st:hasText ": وَلَقَدْ آتَيْنَاكَ سَبْعًا مِنَ الْمَثَانِي وَالْقُرْءَانَ الْعَظِيمَ ، قَالَ : \" هِيَ فَاتِحَةُ الْكِتَابِ ، ثُمَّ سُئِلَ عَنْهَا ، وَأَنَا أَسْمَعُ ، فَقَرَأَهَا : الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ حَتَّى أَتَى عَلَى آخِرِهَا ، فَقَالَ ، تُثَنَّى فِي كُلِّ قِرَاءَةٍ"@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1a1fae70038f>,
        <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b> ;
    st:references <http://www.semantictafsir.com/resource/hadith/120/text/1/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2>,
        <http://www.semantictafsir.com/resource/quran/verse/15/87> .

<http://www.semantictafsir.com/resource/hadith/120/text/1/thematic-reference/1> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L110" ;
    st:hasText "وَالْقُرْءَانَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/ktub> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/15/87> .

