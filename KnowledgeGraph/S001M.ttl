<http://www.semantictafsir.com/resource/hadith/173> a hadith:Hadith ;
    rdfs:label "Hadith 173" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1824" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.12/15> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/173/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/173/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasHadithNo 173 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/265> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/173/note/1> ;
    st:hasText "قِيلَ : حَدَّثَنِي أَحْمَدُ بْنُ الْوَلِيدِ الرَّمْلِيُّ ، قَالَ : حَدَّثَنَا عَبْدُ اللَّهِ بْنُ جَعْفَرٍ الرَّقِّيُّ ، قَالَ : حَدَّثَنَا سُفْيَانُ بْنُ عُيَيْنَةَ ، عَنْ إِسْمَاعِيلَ بْنِ أَبِي خَالِدٍ ، عَنِ الشَّعْبِيِّ ، عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" الْمَغْضُوبُ عَلَيْهِمُ ، الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/173/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/174> a hadith:Hadith ;
    rdfs:label "Hadith 174" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1835" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/173> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/174/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/174/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasHadithNo 174 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/266> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/174/note/1> ;
    st:hasText "حَدَّثَنَا مُحَمَّدُ بْنُ الْمُثَنَّى ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ جَعْفَرٍ ، قَالَ : حَدَّثَنَا شُعْبَةُ ، عَنْ سِمَاكٍ ، قَالَ : سَمِعْتُ عَبَّادَ بْنَ حُبَيْشٍ يُحَدِّثُ عَنْ عَدِيِّ بْنِ حَاتِمٍ ، قَالَ : قَالَ لِي رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ الْمَغْضُوبَ عَلَيْهِمُ الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/174/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L5575> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/175> a hadith:Hadith ;
    rdfs:label "Hadith 175" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1846" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/174> ;
