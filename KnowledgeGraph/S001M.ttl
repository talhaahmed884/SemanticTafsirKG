    st:hasTheme <http://www.semantictafsir.com/resource/theme/sawabiqab> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/bb69f8b3de74> .

<http://www.semantictafsir.com/resource/commentary/1.10/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1265" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.10/1/segment/1/segment/1> ;
    st:hasText "أجمعت الحجة من أَهْل التأويل جميعًا عَلَى أن الصراط المستقيم هُوَ الطريق الواضح الَّذِي لا اعوجاج فِيهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lrajeh> .

<http://www.semantictafsir.com/resource/commentary/1.10/1/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1266" ;
    st:hasText "الصراط المستقيم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.10/2/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1270" ;
    st:hasText """أمير الْمُؤْمِنِين عَلَى صراط
إذا اعوج الموارد مستقيم"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.10/2/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1277" ;
    st:hasText """صبحنا أرضهم بالخيل حَتَّى
تركناها أدق من الصراط"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.10/2/poetry/3> a st:Poetry ;
    rdfs:label "Poetry 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1282" ;
    st:hasText "فصد عَنْ نهج الصراط القاصد"@ar .

