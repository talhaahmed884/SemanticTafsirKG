<http://www.semantictafsir.com/resource/hadith/184> a hadith:Hadith ;
    rdfs:label "Hadith 184" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1961" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/183> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/184/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/184/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/184/chain/1/link/4/narrator> ;
    st:hasHadithNo 184 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/280> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/184/note/1> ;
    st:hasText "حَدَّثَنِي يُونُسُ ، قَالَ : أَخْبَرَنَا ابْنُ وَهْبٍ ، قَالَ : حَدَّثَنِي ابْنُ زَيْدٍ ، عَنْ أَبِيهِ ، قَالَ : \" الْمَغْضُوبُ عَلَيْهِمْ : الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

