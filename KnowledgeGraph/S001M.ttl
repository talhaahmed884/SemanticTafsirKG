<http://www.semantictafsir.com/resource/hadith/154> a hadith:Hadith ;
    rdfs:label "Hadith 154" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L917" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.8/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/154/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/154/segment/1> ;
    st:hasHadithNo 154 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/236> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/154/note/1> ;
    st:hasText "كَالَّذِي حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ : \" وَإِيَّاكَ نَسْتَعِينُ ، قَالَ : إِيَّاكَ نَسْتَعِينُ عَلَى طَاعَتِكَ وَعَلَى أُمُورِنَا كُلِّهَا \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/ea2fedd30108> .

<http://www.semantictafsir.com/resource/hadith/154/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
