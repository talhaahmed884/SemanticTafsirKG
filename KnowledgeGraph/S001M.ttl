<http://www.semantictafsir.com/resource/hadith/134/note/1> a st:Note ;
    rdfs:label "Note 1" ;
    st:hasText "134 /3 /140 /40" .

<http://www.semantictafsir.com/resource/hadith/134/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L44" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/134/text/1/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/134/text/1/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/136> ;
    st:hasText "قَالَ جِبْرِيلُ لِمُحَمَّدٍ : قُلْ يَا مُحَمَّدُ : الْحَمْدُ لِلَّهِ \" قَالَ ابْنُ عَبَّاسٍ : \" الْحَمْدُ : هُوَ الشُّكْرُ لِلَّهِ ، وَالاسْتِخْذَاءِ لِلَّهِ ، وَالإِقْرَارِ بِنِعْمَتِهِ وَهِدَايَتِهِ ، وَابْتِدَائِهِ ، وَغَيْرِ ذَلِكَ \""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/889d71ecaae5>,
        <http://www.semantictafsir.com/resource/entity/person/29a82ea13b18>,
        <http://www.semantictafsir.com/resource/entity/person/4ce9591136a3> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/0278c0f18853> .

<http://www.semantictafsir.com/resource/hadith/134/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L45" ;
    st:hasText "جِبْرِيلُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/mlak> .

<http://www.semantictafsir.com/resource/hadith/134/text/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L49" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/134/text/1/segment/2/segment/1> ;
    st:hasText "الْحَمْدُ : هُوَ الشُّكْرُ لِلَّهِ ، وَالاسْتِخْذَاءِ لِلَّهِ ، وَالإِقْرَارِ بِنِعْمَتِهِ وَهِدَايَتِهِ ، وَابْتِدَائِهِ ، وَغَيْرِ ذَلِكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/asghalamal> .

