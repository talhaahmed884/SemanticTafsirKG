    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/7/segment/12/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1705" ;
    st:hasText "صفة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/7/segment/13> a st:Segment ;
    rdfs:label "Segment 13" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1707" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/7/segment/13/segment/1> ;
    st:hasText "فأما إذا وجهنا غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ إِلَى أنها من نعت الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ فلا حاجة بسامعه إلى الاستدلال ، إذ كَانَ الصريح من معناه قَدْ أغنى عَنِ الدليل"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.12/7/segment/13/segment/1> a st:Segment ;
