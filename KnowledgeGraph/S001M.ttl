<http://www.semantictafsir.com/resource/hadith/150> a hadith:Hadith ;
    rdfs:label "Hadith 150" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L828" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/149> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/150/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1131> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/150/segment/1> ;
    st:hasHadithNo 150 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/230> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/150/note/1> ;
    st:hasText "حَدَّثَنِي مُوسَى بْنُ هَارُونَ الْهَمْدَانِيُّ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ حَمَّادٍ الْقَنَّادُ ، قَالَ : حَدَّثَنَا أَسْبَاطُ بْنُ نَصْرٍ الْهَمْدَانِيُّ ، عَنْ إِسْمَاعِيلَ بْنِ عَبْدِ الرَّحْمَنِ السُّدِّيِّ ، عَنْ أَبِي مَالِكٍ ، وَعَنْ أَبِي صَالِحٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَعَنْ مُرَّةَ الْهَمْدَانِيِّ ، عَنِ ابْنِ مَسْعُودٍ ، وَعَنْ نَاسٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" مَالِكِ يَوْمِ الدِّينِ : هُوَ يَوْمُ الْحِسَابِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/5466e6a00d41>,
        <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/hadith/150/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/4> .

