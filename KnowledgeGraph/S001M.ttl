<http://www.semantictafsir.com/resource/hadith/181> a hadith:Hadith ;
    rdfs:label "Hadith 181" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1937" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.12/27> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/181/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/181/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/181/chain/1/link/4/narrator> ;
    st:hasHadithNo 181 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/277> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/181/note/1> ;
    st:hasText "حَدَّثَنَا أَحْمَدُ بْنُ حَازِمٍ الْغِفَارِيُّ ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ ، عَنْ أَبِي جَعْفَرٍ ، عَنْ رَبِيعٍ : \" غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ ، قَالَ : الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

