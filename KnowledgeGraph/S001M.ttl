<http://www.semantictafsir.com/resource/commentary/1.6/1/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L785" ;
    st:hasText """إذا ما رمونا رميناهم
ودناهم مثل ما يقرضونا"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.6/1/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L790" ;
    st:hasText """واعلم وأيقن أن ملكك زائل
واعلم بأنك ما تدين تدان"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.6/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L783" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.6/1/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.6/1/segment/1/segment/2> ;
    st:hasText "الدين فِي هَذَا الموضع بتأويل الحساب والمجازاة بالأعمال"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.6/1/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L783" ;
    st:hasText "الحساب"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/1.6/1/segment/1/segment/2> a st:Segment ;
