    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1142" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.9/4/segment/1/segment/1> ;
    st:hasText "وَفَّقَكَ اللَّهُ لإِصَابَةِ الْحَقِّ فِي أَمْرِي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/4/segment/1/segment/1> a st:Segment ;
