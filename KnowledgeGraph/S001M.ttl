    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/227> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/148/note/1> ;
    st:hasText "وَأَمَّا تَأْوِيلُ قِرَاءَةِ مَنْ قَرَأَ : مَالِكِ يَوْمِ الدِّينِ فَمَا حَدَّثَنَا بِهِ أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، عَنْ بِشْرِ بْنِ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنِ ابْنِ عَبَّاسٍ : مَالِكِ يَوْمِ الدِّينِ ، يَقُولُ : \" لا يَمْلِكُ أَحَدٌ فِي ذَلِكَ الْيَوْمِ مَعَهُ حُكْمًا كَمُلْكِهِمْ فِي الدُّنْيَا ، ثُمَّ قَالَ : لا يَتَكَلَّمُونَ إِلا مَنْ أَذِنَ لَهُ الرَّحْمَنُ وَقَالَ صَوَابًا ، وَقَالَ : وَخَشَعَتِ الأَصْوَاتُ لِلرَّحْمَنِ ، وَقَالَ : وَلا يَشْفَعُونَ إِلا لِمَنِ ارْتَضَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/qiraat> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/hadith/148/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/hadith/148/thematic-reference/2> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/4> .

