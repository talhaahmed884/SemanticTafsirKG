<http://www.semantictafsir.com/resource/commentary/1.12/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1644" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/3/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/3/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/3/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/3/segment/1/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/1.12/3/segment/1/segment/5> ;
    st:hasText "غَيْرِ مضافة إلى مَجْهُول من الأسماء نظير الَّذِينَ فِي أَنَّهُ معرفة غَيْر مؤقتة ، كَمَا الَّذِينَ معرفة غَيْر مؤقتة ، جاز من أجل ذَلِكَ أن يَكُون غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ نعتا ل الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/0a35d7b453b3>,
        <http://www.semantictafsir.com/resource/quran/fragment/d21bd175cec8>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/5dc689230521> .

