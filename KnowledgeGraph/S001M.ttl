<http://www.semantictafsir.com/resource/hadith/189/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2185" ;
    st:hasText "سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، وَهُوَ بِوَادِي الْقُرَى ، وَهُوَ عَلَى فَرَسِهِ ، وَسَأَلَهُ رَجُلٌ مِنْ بَنِي الْقَيْنِ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، مَنْ هَؤُلاءِ ؟ قَالَ : \" هَؤُلاءِ الضَّالُّونَ \" يَعْنِي : النَّصَارَى"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sghazawat> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/2464d13dfe4e>,
        <http://www.semantictafsir.com/resource/entity/organization/725064799b45> .

