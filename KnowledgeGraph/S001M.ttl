<http://www.semantictafsir.com/resource/hadith/195> a hadith:Hadith ;
    rdfs:label "Hadith 195" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2260" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/194> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/195/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/195/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/195/chain/1/link/4/narrator> ;
    st:hasHadithNo 195 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/294> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/195/note/1> ;
    st:hasText "حَدَّثَنَا أَحْمَدُ بْنُ حَازِمٍ الْغِفَارِيُّ ، قَالَ : أَخْبَرَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى ، عَنْ أَبِي جَعْفَرٍ ، عَنْ رَبِيعٍ ، \" وَلا الضَّالِّينَ : النَّصَارَى \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

