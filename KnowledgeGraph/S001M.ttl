<http://www.semantictafsir.com/resource/commentary/1.13/28/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2339" ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/199> ;
    st:hasText "فَمِنْ ذَلِكَ قَوْلُهُ جَلَّ وَعَزَّ : أَفَرَأَيْتَ مَنِ اتَّخَذَ إِلَهَهُ هَوَاهُ وَأَضَلَّهُ اللَّهُ عَلَى عِلْمٍ وَخَتَمَ عَلَى سَمْعِهِ وَقَلْبِهِ وَجَعَلَ عَلَى بَصَرِهِ غِشَاوَةً فَمَنْ يَهْدِيهِ مِنْ بَعْدِ اللَّهِ أَفَلا تَذَكَّرُونَ ، فَأَنْبَأَ جلَّ ثناؤُهُ أَنَّهُ الْمُضِلُّ الْهَادِي دُونَ غَيْرِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> .

<http://www.semantictafsir.com/resource/commentary/1.13/28/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2344" ;
    st:hasText "لَكِنَّ الْقُرْآنَ نَزَلَ بِلِسَانِ الْعَرَبِ عَلَى مَا قَدْ قَدَّمْنَا الْبَيَانَ عَنْهُ فِي أَوَّلِ الْكِتَابِ ، وَمِنْ شَأْنِ الْعَرَبِ إِضَافَةُ الْفِعْلِ إِلَى مَنْ وُجِدَ مِنْهُ ، وَإِنْ كَانَ مُسَبِّبُهُ غَيْرَ الَّذِي وُجِدَ مِنْهُ أَحْيَانًا ، وَأَحْيَانًا إِلَى مُسَبِّبِهِ ، وَإِنْ كَانَ الَّذِي وُجِدَ مِنْهُ الْفِعْلُ غَيْرَهُ ، فَكَيْفَ بِالْفِعْلِ الَّذِي يَكْتَسِبُهُ الْعَبْدُ كَسْبًا ، وَيُوجِدُهُ اللَّهُ جَلَّ ثَنَاؤُهُ عَيْنًا وَنَشْأَةً ! بَلْ ذَلِكَ أَحْرَى أَنْ يُضَافَ إِلَى مُكْتَسِبِهِ كَسْبًا لَهُ بِالْقُوَّةِ مِنْهُ عَلَيْهِ ، وَالاخْتِيَارِ مِنْهُ لَهُ ، وَإِلَى اللَّهِ جَلَّ ثَنَاؤُهُ بِإِيجَادِ عَيْنِهِ ، وَإِنْشَائِهَا تَدْبِيرًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.13/3/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2021" ;
    st:hasText "غَيْرِ التي مَعَ الْمَغْضُوبِ عَلَيْهِمْ أنها بمعنى ( سوى"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/94d133322693> .

<http://www.semantictafsir.com/resource/commentary/1.13/3/thematic-reference/2> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2023" ;
    st:hasText "معنى الكلام كَانَ عنده : اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ ، الَّذِين هُمْ سوى المغضوب عليهم والضالين"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/94d133322693> .

<http://www.semantictafsir.com/resource/commentary/1.13/3/thematic-reference/3> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2024" ;
    st:hasText "الصِّرَاطَ الْمُسْتَقِيمَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/94d133322693> .

<http://www.semantictafsir.com/resource/commentary/1.13/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2027" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/4/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.13/4/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.13/4/segment/1/segment/3> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/192> ;
    st:hasText "كان بعض نحويي الكوفيين يستنكر ذَلِكَ من قوله ، ويزعم أن غَيْرِ التي مَعَ الْمَغْضُوبِ عَلَيْهِمْ لو كَانَتْ بمعنى ( سوى ) ، لكان خطأ أن يعطف عَلَيْهَا بـ ( لا ) إذ كَانَتْ ( لا ) لا يعطف بها إِلَّا عَلَى جحد قَدْ تقدمها ، كَمَا كَانَ خطأ قول القائل : عندي ( سوى ) أخيك وَلَا أبيك ؛ لأن ( سوى ) ليست من حروف النفي والجحود"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/2a1652ae4b8b>,
        <http://www.semantictafsir.com/resource/entity/organization/3f8e9a955cfa> .

