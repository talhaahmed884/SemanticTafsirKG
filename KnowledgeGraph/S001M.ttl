    st:hasText "الاستعاذة الاستجارة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/asghalamal> .

<http://www.semantictafsir.com/resource/commentary/0.12/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L153" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.12/1/segment/2/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.12/1/segment/2/segment/2> ;
    st:hasText "أعوذ بِالله من الشَّيْطَان \" : أستجير بِالله دون غيره من سائر خلقه ، من الشَّيْطَان ، أن يضرني فِي ديني ، أَوْ يصدني عَنْ حق يلزمني لربي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/asghalamal>,
        <http://www.semantictafsir.com/resource/theme/dua> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/37af5e4fa73b> .

<http://www.semantictafsir.com/resource/commentary/0.12/1/segment/2/segment/1> a st:Segment ;
