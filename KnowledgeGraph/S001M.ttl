<http://www.semantictafsir.com/resource/hadith/199/note/1> a st:Note ;
    rdfs:label "Note 1" ;
    st:hasText "199 /5" .

<http://www.semantictafsir.com/resource/hadith/199/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2488" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/199/text/1/segment/1> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/203> ;
    st:hasText "قَسَمْتُ الصَّلاةَ بَيْنِي وَبَيْنَ عَبْدِي نِصْفَيْنِ ، وَلَهُ مَا سَأَلَ ، فَإِذَا قَالَ الْعَبْدُ : الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ، قَالَ : حَمِدَنِي عَبْدِي ، وَإِذَا قَالَ : الرَّحْمَنِ الرَّحِيمِ ، قَالَ : أَثْنَى عَلَيَّ عَبْدِي ، وَإِذَا قَالَ : مَالِكِ يَوْمِ الدِّينِ ، قَالَ : مَجَّدَنِي عَبْدِي ، قَالَ : هَذَا لِي وَلَهُ مَا بَقِيَ \""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/hadith/199/text/1/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2>,
        <http://www.semantictafsir.com/resource/quran/verse/1/3>,
        <http://www.semantictafsir.com/resource/quran/verse/1/4> .

<http://www.semantictafsir.com/resource/hadith/199/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2489" ;
    st:hasText "الصَّلاةَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/salat> .

