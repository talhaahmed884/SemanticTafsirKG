<http://www.semantictafsir.com/resource/quran/verse/1/4/fragment/4d2a36bffc6a> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:4 (مَالِكِ يَوْمِ الدِّينِ أَنَّهُ مَالِكُ …)" ;
    st:hasText "مَالِكِ يَوْمِ الدِّينِ أَنَّهُ مَالِكُ جَمِيعَ الْعَالَمِينَ ، وَسَيِّدُهُمْ ، وَمُصْلِحُهُمْ ، وَالنَّاظِرُ لَهُمْ ، وَالرَّحِيمُ بِهِمْ فِي الدُّنْيَا وَالآخِرَةِ ، بِقَوْلِهِ :"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/4> .

<http://www.semantictafsir.com/resource/quran/verse/1/6/fragment/73123638df68> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:6 (اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ …)" ;
    st:hasText "اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ : الطَّرِيقُ \""@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/6> .

<http://www.semantictafsir.com/resource/quran/verse/1/6/fragment/76b6fed7e336> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:6 (اهْدِنَا)" ;
    st:hasText "اهْدِنَا"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/6> .

<http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/1f92466cd3c7> a st:VerseFragment ;
    rdfs:label "Verse Fragment 1:7 (أَنْعَمْتَ عَلَيْهِمْ)" ;
    st:hasText "أَنْعَمْتَ عَلَيْهِمْ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/1/7> .

<http://www.semantictafsir.com/resource/quran/verse/15/87> a st:Verse ;
    rdfs:label "Verse 15:87" ;
    st:hasSurahNo 15 ;
    st:hasText "وَلَقَدْ ءَاتَيْنَٰكَ سَبْعًا مِّنَ ٱلْمَثَانِى وَٱلْقُرْءَانَ ٱلْعَظِيمَ"@ar ;
    st:hasVerseNo 87 .

<http://www.semantictafsir.com/resource/quran/verse/17/110/fragment/86ed95d7a3a5> a st:VerseFragment ;
    rdfs:label "Verse Fragment 17:110 (قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا …)" ;
    st:hasText "قُلِ ادْعُوا اللَّهَ أَوِ ادْعُوا الرَّحْمَنَ أَيًّا مَا تَدْعُوا فَلَهُ الأَسْمَاءُ الْحُسْنَى"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/17/110> .

<http://www.semantictafsir.com/resource/quran/verse/18/1> a st:Verse ;
    rdfs:label "Verse 18:1" ;
    st:hasSurahNo 18 ;
    st:hasText "ٱلْحَمْدُ لِلَّهِ ٱلَّذِىٓ أَنزَلَ عَلَىٰ عَبْدِهِ ٱلْكِتَٰبَ وَلَمْ يَجْعَل لَّهُۥ عِوَجَا"@ar ;
    st:hasVerseNo 1 .

<http://www.semantictafsir.com/resource/quran/verse/2/146> a st:Verse ;
    rdfs:label "Verse 2:146" ;
    st:hasSurahNo 2 ;
    st:hasText "ٱلَّذِينَ ءَاتَيْنَٰهُمُ ٱلْكِتَٰبَ يَعْرِفُونَهُۥ كَمَا يَعْرِفُونَ أَبْنَآءَهُمْ وَإِنَّ فَرِيقًا مِّنْهُمْ لَيَكْتُمُونَ ٱلْحَقَّ وَهُمْ يَعْلَمُونَ"@ar ;
    st:hasVerseNo 146 .

<http://www.semantictafsir.com/resource/quran/verse/4/66/fragment/333c71170497> a st:VerseFragment ;
    rdfs:label "Verse Fragment 4:66 (وَلَوْ أَنَّهُمْ فَعَلُوا مَا يُوعَظُونَ …)" ;
    st:hasText "وَلَوْ أَنَّهُمْ فَعَلُوا مَا يُوعَظُونَ بِهِ لَكَانَ خَيْرًا لَهُمْ وَأَشَدَّ تَثْبِيتًا"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/4/66> .

<http://www.semantictafsir.com/resource/quran/verse/40/16> a st:Verse ;
    rdfs:label "Verse 40:16" ;
    st:hasSurahNo 40 ;
    st:hasText "يَوْمَ هُم بَٰرِزُونَ لَا يَخْفَىٰ عَلَى ٱللَّهِ مِنْهُمْ شَىْءٌ لِّمَنِ ٱلْمُلْكُ ٱلْيَوْمَ لِلَّهِ ٱلْوَٰحِدِ ٱلْقَهَّارِ"@ar ;
    st:hasVerseNo 16 .

<http://www.semantictafsir.com/resource/quran/verse/5/60> a st:Verse ;
    rdfs:label "Verse 5:60" ;
    st:hasSurahNo 5 ;
    st:hasText "قُلْ هَلْ أُنَبِّئُكُم بِشَرٍّ مِّن ذَٰلِكَ مَثُوبَةً عِندَ ٱللَّهِ مَن لَّعَنَهُ ٱللَّهُ وَغَضِبَ عَلَيْهِ وَجَعَلَ مِنْهُمُ ٱلْقِرَدَةَ وَٱلْخَنَازِيرَ وَعَبَدَ ٱلطَّٰغُوتَ أُو۟لَٰٓئِكَ شَرٌّ مَّكَانًا وَأَضَلُّ عَن سَوَآءِ ٱلسَّبِيلِ"@ar ;
    st:hasVerseNo 60 .

<http://www.semantictafsir.com/resource/quran/verse/56/86/fragment/d8c14a595c94> a st:VerseFragment ;
    rdfs:label "Verse Fragment 56:86 (فَلَوْلا إِنْ كُنْتُمْ غَيْرَ مَدِينِينَ …)" ;
    st:hasText "فَلَوْلا إِنْ كُنْتُمْ غَيْرَ مَدِينِينَ . يعني : مجزيين بأعمالكم وَلا محاسبين ."@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/56/86> .

<http://www.semantictafsir.com/resource/quran/verse/6/112/fragment/2fc2d5743c3e> a st:VerseFragment ;
    rdfs:label "Verse Fragment 6:112 (وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا …)" ;
    st:hasText "وَكَذَلِكَ جَعَلْنَا لِكُلِّ نَبِيٍّ عَدُوًّا شَيَاطِينَ الإِنْسِ وَالْجِنِّ"@ar ;
    st:isPartOfVerse <http://www.semantictafsir.com/resource/quran/verse/6/112> .

