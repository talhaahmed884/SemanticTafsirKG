<http://www.semantictafsir.com/resource/hadith/149> a hadith:Hadith ;
    rdfs:label "Hadith 149" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L812" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.6/4> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/149/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/149/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/149/segment/2>,
        <http://www.semantictafsir.com/resource/hadith/149/segment/3>,
        <http://www.semantictafsir.com/resource/hadith/149/segment/4>,
        <http://www.semantictafsir.com/resource/hadith/149/segment/5> ;
    st:hasHadithNo 149 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/229> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/149/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ مُحَمَّدُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ : \" يَوْمِ الدِّينِ ، قَالَ : يَوْمِ حِسَابِ الْخَلائِقِ ، هُوَ يَوْمُ الْقِيَامَةِ ، يُدِينُهُمْ بِأَعْمَالِهِمْ ، إِنْ خَيْرًا فَخَيْرًا ، وَإِنَّ شَرًّا فَشَرًّا ، إِلا مَنْ عَفَا عَنْهُ ، فَالأَمْرُ أَمْرُهُ ، ثُمَّ قَالَ : أَلا لَهُ الْخَلْقُ وَالأَمْرُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/hadith/149/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/4/fragment/ec677a26df99>,
        <http://www.semantictafsir.com/resource/quran/verse/7/54/fragment/a255c09850c6> .

