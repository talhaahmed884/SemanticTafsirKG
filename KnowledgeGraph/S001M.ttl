<http://www.semantictafsir.com/resource/hadith/178> a hadith:Hadith ;
    rdfs:label "Hadith 178" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1902" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/177> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/178/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/178/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 178 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/272> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/178/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنِ ابْنِ عَبَّاسٍ ، \" غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ . يَعْنِي : الْيَهُودَ الَّذِينَ غَضِبَ اللَّهُ عَلَيْهِمْ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/178/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/179> a hadith:Hadith ;
    rdfs:label "Hadith 179" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1913" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/178> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/179/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/179/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1131> ;
    st:hasHadithNo 179 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/273> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/179/note/1> ;
    st:hasText "حَدَّثَنِي مُوسَى ، قَالَ : حَدَّثَنَا عَمْرٌو ، قَالَ : حَدَّثَنَا أَسْبَاطٌ ، عَنِ السُّدِّيِّ ، فِي خَبَرٍ ذَكَرَهُ ، عَنْ أَبِي مَالِكٍ ، وَعَنْ أَبِي صَالِحٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَعَنْ مُرَّةَ الْهَمْدَانِيِّ ، عَنِ ابْنِ مَسْعُودٍ ، وَعَنْ نَاسٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ : هُمُ الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/5466e6a00d41> .

