<http://www.semantictafsir.com/resource/hadith/159> a hadith:Hadith ;
    rdfs:label "Hadith 159" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1355" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/158> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/159/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/159/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L2069> ;
    st:hasHadithNo 159 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/244> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/159/note/1> ;
    st:hasText "حَدَّثَنَا مَحْمُودُ بْنُ خِدَاشٍ الطَّالْقَانِيُّ ، قَالَ : حَدَّثَنَا حُمَيْدُ بْنُ عَبْد الرَّحْمَنِ الرُّؤَاسِيُّ ، قَالَ : حَدَّثَنَا عَلِيٌّ ، وَالْحَسَنُ ، ابْنَا صَالِحٍ ، جَمِيعًا عَنْ عَبْدِ اللَّهِ بْنِ مُحَمَّدِ بْنِ عَقِيلٍ ، عَنْ جَابِرِ : \" اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ : الإِسْلامُ ، قَالَ : هُوَ أَوْسَعُ مِمَّا بَيْنَ السَّمَاءِ وَالأَرْضِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/159/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L2069> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/160> a hadith:Hadith ;
    rdfs:label "Hadith 160" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1368" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/159> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/160/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/160/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/174> ;
    st:hasHadithNo 160 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/245> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/160/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، قَالَ : قَالَ جِبْرِيلُ لِمُحَمَّدٍ : \" قُلْ يَا مُحَمَّدُ : اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، يَقُولُ : أَلْهِمْنَا الطَّرِيقَ الْهَادِي ، وَهُوَ دِينُ اللَّهِ الَّذِي لا عِوَجَ لَهُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/160/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/161> a hadith:Hadith ;
    rdfs:label "Hadith 161" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1382" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/160> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/161/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/161/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 161 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/246> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/161/note/1> ;
    st:hasText "حَدَّثَنَا سَهْلُ بْنُ مُوسَى الرَّازِيُّ ، قَالَ : حَدَّثَنَا يَحْيَى بْنُ عَوْفٍ ، عَنِ الْفُرَاتِ بْنِ السَّائِبِ ، عَنْ مَيْمُونِ بْنِ مِهْرَانَ ، عَنِ ابْنِ عَبَّاسٍ ، فِي قَوْلِهِ : \" اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ : ذَلِكَ الإِسْلامُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

