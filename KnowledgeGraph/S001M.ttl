<http://www.semantictafsir.com/resource/commentary/1.14/1/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2372" ;
    st:hasText "يَوْمِ الدِّينِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/babfa2de7c89> .

<http://www.semantictafsir.com/resource/commentary/1.14/4> a st:Commentary ;
    rdfs:label "Commentary 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2498" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/199> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/204> ;
    st:hasCommentaryNo 4 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/65311> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/300> ;
    st:hasText "آخِرُ تَفْسِيرِ سُورَةِ فَاتِحَةِ الْكِتَابِ ."@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b> .

<http://www.semantictafsir.com/resource/commentary/1.2/2/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L223" ;
    st:hasText """وأهلكن يومًا رب كندة وابنه
ورب معد بين خبت وعرعر"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/4ccd4dfede8b>,
        <http://www.semantictafsir.com/resource/entity/person/f05b7793b7c4> .

<http://www.semantictafsir.com/resource/commentary/1.2/2/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L231" ;
    st:hasText """تخب إلى النُّعْمَان حَتَّى تناله
فدى لك من رب طريفي وتالدي"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/fd652743176a> .

<http://www.semantictafsir.com/resource/commentary/1.2/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L221" ;
    st:hasText "الرب فِي كلام العرب منصرف عَلَى معان ؛ فالسيد المطاع فيهم يدعى ربا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/1.2/2/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L229" ;
    st:hasText "يعني برب كندة : سيد كندة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/4ccd4dfede8b> .

<http://www.semantictafsir.com/resource/commentary/1.2/3/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L239" ;
    st:hasText """كانوا كسالئة حمقاء إذ حقنت
سلاءها فِي أديم غَيْر مربوب"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.2/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L238" ;
    st:hasText "الرجل المصلح الشيء يدعى ربا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.2/3/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L245" ;
    st:hasText "يعني بِذَلِك : فِي أديم غَيْر مصلح"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.2/3/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L246" ;
    st:hasText "إن فلانا يرب صنيعته عِنْد فُلان . إذا كَانَ يحاول إصلاحها وإدامتهما"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/tabeer> .

<http://www.semantictafsir.com/resource/commentary/1.2/4/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L249" ;
    st:hasText """فكنت امرأ أفضت إليك ربابتي
وقبلك ربتني فضعت ربوب"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.2/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L254" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.2/4/segment/1/segment/1> ;
    st:hasText "أفضت إليك . أَيْ : وصلت إليك ربابتي ، فصرت أَنْت الَّذِي ترب أمري فتصلحه ، لما خرجت من ربابة غيرك من الملوك كانوا قبلك علي ، فضيعوا أمري وتركوا تفقده"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/tabeer> .

<http://www.semantictafsir.com/resource/commentary/1.2/4/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L254" ;
    st:hasText "أفضت إليك . أَيْ : وصلت إليك ربابتي ، فصرت أَنْت الَّذِي ترب أمري فتصلحه ، لما خرجت من ربابة غيرك من الملوك كانوا قبلك علي ، فضيعوا أمري وتركوا تفقده"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.2/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L257" ;
    st:hasText "وهم الربوب ، واحدهم رب"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.2/4/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L258" ;
    st:hasText "المالك للشيء يدعى ربه"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.2/7> a st:Commentary ;
    rdfs:label "Commentary 7" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L281" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/138> ;
    st:hasCommentaryNo 7 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/45338> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/214> .

<http://www.semantictafsir.com/resource/commentary/1.3/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L287" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.3/1/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.3/1/segment/1/segment/2> ;
    st:hasText "العالمون جمع عالم ، والعالم جمع لا واحد لَهُ من لفظه"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.3/1/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L287" ;
    st:hasText "جمع"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.3/1/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L288" ;
    st:hasText "واحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.3/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L289" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.3/1/segment/2/segment/1> ;
    st:hasText "كالأنام والرهط والجيش ، ونحو ذَلِكَ من الأسماء التي هِيَ موضوعات عَلَى جماع لا واحد لَهُ من لفظه"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.3/1/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L290" ;
    st:hasText "واحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.3/16> a st:Commentary ;
    rdfs:label "Commentary 16" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L397" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/147> ;
    st:hasCommentaryNo 16 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/33326> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/226> .

<http://www.semantictafsir.com/resource/commentary/1.3/2/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L298" ;
    st:hasText "فخندف هامة هَذَا العالم"@ar .

<http://www.semantictafsir.com/resource/commentary/1.3/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L291" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.3/2/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.3/2/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.3/2/segment/1/segment/3> ;
    st:hasText "العالم اسم لأصناف الأمم ، وكل صنف منها عالم ، وأهل كُلّ قرن من كُلّ صنف منها عالم ذَلِكَ القرن وذلك الزمان ، فالإنس عالم ، وكل أَهْل زمان منهم عالم ذَلِكَ الزمان ، والجن عالم ، وكذلك سائر أجناس الخلق ، كُلّ جنس منها عالم زمانه ، ولذلك جمع فَقِيل : عالمون . وواحده جمع ، لكون عالم كُلّ زمان من ذَلِكَ عالم ذَلِكَ الزمان"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/1.3/2/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L294" ;
    st:hasText "الجن"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/samiyat> .

<http://www.semantictafsir.com/resource/commentary/1.3/2/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L296" ;
    st:hasText "واحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.3/2/segment/1/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L296" ;
    st:hasText "جمع"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.4/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L420" ;
    st:hasText "كتاب"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/ktub> .

<http://www.semantictafsir.com/resource/commentary/1.4/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L431" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.4/4/segment/1/segment/1> ;
    st:hasText "قَدْ أنكر ذَلِكَ جماعة من أَهْل التأويل ، وقالوا : إن ذَلِكَ من المؤخر الَّذِي معناه التقديم ، وإنما هو : الحمد للَّه الرَّحْمَن الرحيم رب العالمين ملك يَوْم الدّين"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/ac7c0a320365>,
        <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> .

