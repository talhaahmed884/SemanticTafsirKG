    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/5/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L394" ;
    st:hasText "الأَسْمَاءِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/5/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L396" ;
    st:hasText "التَّأْوِيلِ فِي قَوْلِ الْقَائِلِ : بِسْمِ اللَّهِ . أَنَّ مَعْنَاهُ فِي ذَلِكَ عِنْدَ ابْتِدَائِهِ فِي فِعْلٍ أَوْ قَوْلٍ : أَبْدَأُ بِتَسْمِيَةِ اللَّهِ ، قَبْلَ فِعْلِي أَوْ قَبْلَ قَوْلِي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1/fragment/4451ad4b0074> .

<http://www.semantictafsir.com/resource/commentary/0.14/5/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L401" ;
    st:hasText "بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ إِنَّمَا مَعْنَاهُ : أَقْرَأُ مُبْتَدِئًا بِتَسْمِيَةِ اللَّهِ ، أَوْ أَبْتَدِئُ قِرَاءَتِي بِتَسْمِيَةِ اللَّهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1> .

<http://www.semantictafsir.com/resource/commentary/0.14/5/segment/7> a st:Segment ;
    rdfs:label "Segment 7" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L404" ;
    st:hasText "جَعَلَ الاسْمَ مَكَانَ التَّسْمِيَةِ ، كَمَا جَعَلَ الْكَلامَ مَكَانَ التَّكْلِيمِ ، وَالْعَطَاءَ مَكَانَ الإِعْطَاءِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.14/7/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L439" ;
    st:hasText "أَسْمَائِهِ الْحُسْنَى ، وَصِفَاتِهِ الْعُلَى"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/0.14/7/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L442" ;
    st:hasText "الرَّحْمَنِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/0.14/7/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L443" ;
    st:hasText "الرَّحِيمِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/0.14/7/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L447" ;
    st:hasText "الذَّبَائِحِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/fiqhterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/7/segment/5> a st:Segment ;
