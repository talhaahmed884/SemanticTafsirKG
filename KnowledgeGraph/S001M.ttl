<http://www.semantictafsir.com/resource/hadith/130/note/1> a st:Note ;
    rdfs:label "Note 1" ;
    st:hasText "130 /2 /140 /24" .

<http://www.semantictafsir.com/resource/hadith/130/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L705" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/130/text/1/segment/1> ;
    st:hasText "عِيسَى أَسْلَمَتْهُ أُمُّهُ إِلَى الْكُتَّابِ لِيُعَلِّمَهُ ، فَقَالَ لَهُ الْمُعَلِّمُ : اكْتُبِ اللَّهَ ، فَقَالَ لَهُ عِيسَى : أَتَدْرِي مَا اللَّهُ ؟ اللَّهُ إِلَهُ الآلِهَةِ \""@ar .

