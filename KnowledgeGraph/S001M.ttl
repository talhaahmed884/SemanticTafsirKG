    st:hasTheme <http://www.semantictafsir.com/resource/theme/fiqhterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/8> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 8" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L966" ;
    st:hasText "حَقًّا وَاجِبًا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/fiqhterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/9> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 9" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L970" ;
    st:hasText "وَلَوْ كَانَ الأَمْرُ فِي ذَلِكَ عَلَى مَا قَالُوا ، لَكَانَ الْقَائِلُ : إِيَّاكَ نَعْبُدُ وَإِيَّاكَ نَسْتَعِينُ ، إِنَّمَا يَسْأَلُ رَبَّهُ أَلا يَجُورَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/afaalibad> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/7/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1003" ;
    st:hasText """فَلَوْ أَنَّ مَا أَسْعَى لأَدْنَى مَعِيشَةٍ
كَفَانِي وَلَمْ أَطْلُبْ قَلِيلٌ مِنَ الْمَالِ"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.8/7/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1001" ;
    st:hasText "ظَنَّ بَعْضُ أَهْلِ الْغَفْلَةِ أَنَّ ذَلِكَ مِنَ الْمُقَدَّمِ ، الَّذِي مَعْنَاهُ التَّأْخِيرُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.8/7/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1009" ;
    st:hasText "يُرِيدُ بِذَلِكَ : كَفَانِي قَلِيلٌ مِنَ الْمَالِ ، وَلَمْ أَطْلُبْ كَثِيرًا ، وَذَلِكَ مِنْ معاني التَّقْدِيمِ وَالتَّأْخِيرِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.8/8/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1016" ;
    st:hasText "فَيَكُونُ نَظِيرَ الْعِبَادَةِ الَّتِي بِوُجُودِهَا وُجُودُ الْمَعُونَةِ عَلَيْهَا ، وَبِوُجُودِ الْمَعُونَةِ عَلَيْهَا وُجُودُهَا ، فَيَكُونُ ذِكْرُ أَحَدِهِمَا دَالا عَلَى الآخَرِ ، فَيَعْتَدِلُ فِي صِحَّةِ الْكَلامِ تَقْدِيمُ مَا قُدِّمَ مِنْهُمَا قَبْلَ صَاحِبِهِ أَنْ يَكُونَ مَوْضُوعًا فِي دَرَجَتِهِ ، وَمُرَتَّبًا فِي مَرْتَبَتِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.8/8/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1021" ;
    st:hasText "فَإِنْ قَالَ : فَمَا وَجْهُ تَكْرَارِهِ : إِيَّاكَ . مَعَ قَوْلِهِ : نَسْتَعِينُ . وَقَدْ تَقَدَّمَ ذَلِكَ قَبْلَ : نَعْبُدُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1023" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/10>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/5>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/6>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/7>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/8>,
        <http://www.semantictafsir.com/resource/commentary/1.8/9/segment/1/segment/9> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/164> ;
    st:hasText "هَلا قِيلَ : إِيَّاكَ نَعْبُدُ وَنَسْتَعِينُ ، إِذْ كَانَ الْمُخْبَرُ عَنْهُ أَنَّهُ الْمَعْبُودُ هُوَ الْمُخْبَرُ عَنْهُ أَنَّهُ الْمُسْتَعَانُ ؟ قِيلَ لَهُ : إِنَّ الْكَافَ الَّتِي مَعَ ( إِيَّا ) ، هِيَ الْكَافُ الَّتِي كَانَتْ تَتَّصِلُ بِالْفِعْلِ ، أَعْنِي بِقَوْلِهِ : نَعْبُدُ ، لَوْ كَانَتْ مُؤَخَّرَةً بَعْدَ الْفِعْلِ ، وَهِيَ كِنَايَةُ اسْمِ الْمُخَاطَبِ الْمَنْصُوبِ بِالْفِعْلِ ، فَكَثُرَتْ بـ ( إِيَّا ) مُتَقَدِّمَةٌ ، إِذْ كَانَتِ الأَسْمَاءُ إِذَا انْفَرَدَتْ بَأَنْفُسِهَا لا تَكُونُ فِي كَلامِ الْعَرَبِ عَلَى حَرْفٍ وَاحِدٍ ، فَلَمَّا كَانَتِ الْكَافُ مِنْ : إِيَّاكَ هِيَ كِنَايَةُ اسْمِ الْمُخَاطَبِ ، الَّتِي كَانَتْ تَكُونُ كَافًا وَحْدَهَا مُتَّصِلَةً بِالْفِعْلِ ، إِذَا كَانَتْ بَعْدَ الْفِعْلِ ، ثُمَّ كَانَ حَظُّهَا أَنْ تُعَادَ مَعَ كُلِّ فِعْلٍ اتَّصَلَتْ بِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/19312b8fbf55>,
        <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/b23133eac05c> .

