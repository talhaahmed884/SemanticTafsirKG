<http://www.semantictafsir.com/resource/commentary/1.13/9/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2101" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/9/segment/1/segment/1> ;
    st:hasText "ألا وجه لقوله : وَلا الضَّالِّينَ إلا العطف عَلَى غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
