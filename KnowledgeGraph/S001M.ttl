<http://www.semantictafsir.com/resource/hadith/130> a hadith:Hadith ;
    rdfs:label "Hadith 130" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L692" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.15/8> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/130/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/130/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L3260> ;
    st:hasHadithNo 130 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/198> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/130/note/1> ;
    st:hasText "حَدَّثَنَا بِهِ إِسْمَاعِيلُ بْنُ الْفَضْلِ ، قَالَ : حَدَّثَنَا إِبْرَاهِيمُ بْنُ الْعَلاءِ ، قَالَ : حَدَّثَنَا إِسْمَاعِيلُ بْنُ عَيَّاشٍ ، عَنْ إِسْمَاعِيلَ بْنِ يَحْيَى ، عَنِ ابْنِ أَبِي مُلَيْكَةَ ، عَمَّنْ حَدَّثَهُ ، عَنِ ابْنِ مَسْعُودٍ ، وَمِسْعَرِ بْنِ كِدَامٍ ، عَنْ عَطِيَّةَ الْعَوْفِيِّ ، عَنْ أَبِي سَعِيدٍ ، قَالَ : قَالَ رَسُولُ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" إِنَّ عِيسَى أَسْلَمَتْهُ أُمُّهُ إِلَى الْكُتَّابِ لِيُعَلِّمَهُ ، فَقَالَ لَهُ الْمُعَلِّمُ : اكْتُبِ اللَّهَ ، فَقَالَ لَهُ عِيسَى : أَتَدْرِي مَا اللَّهُ ؟ اللَّهُ إِلَهُ الآلِهَةِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam> .

<http://www.semantictafsir.com/resource/hadith/130/chain/1/link/10> a hadith:NarratorChainSegment,
