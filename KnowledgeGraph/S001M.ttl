<http://www.semantictafsir.com/resource/hadith/144> a hadith:Hadith ;
    rdfs:label "Hadith 144" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L355" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/143> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/144/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/144/chain/1/link/4/narrator> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/144/segment/1> ;
    st:hasHadithNo 144 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/221> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/144/note/1> ;
    st:hasText "حَدَّثَنِي مُحَمَّدُ بْنُ حُمَيْدٍ ، قَالَ : حَدَّثَنَا مِهْرَانُ ، عَنْ سُفْيَانَ ، عَنْ مُجَاهِدٍ : \" الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ ، قَالَ : الْجِنُّ وَالإِنْسُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2> .

<http://www.semantictafsir.com/resource/hadith/158> a hadith:Hadith ;
    rdfs:label "Hadith 158" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1343" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/157> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/158/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/158/chain/1>,
        <http://www.semantictafsir.com/resource/hadith/158/chain/2> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/158/chain/1/link/3/narrator>,
        <http://www.semantictafsir.com/resource/narrator/L5079> ;
    st:hasHadithNo 158 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/243> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/158/note/1> ;
    st:hasText "حَدَّثَنَا أَحْمَدُ بْنُ إِسْحَاقَ الأَهْوَازِيُّ ، قَالَ : حَدَّثَنَا أَبُو أَحْمَدَ الزُّبَيْرِيُّ ، قَالَ : حَدَّثَنَا سُفْيَانُ ، وَحَدَّثَنَا مُحَمَّدُ بْنُ حُمَيْدٍ الرَّازِيُّ ، قَالَ : حَدَّثَنَا مِهْرَانُ ، عَنْ سُفْيَانَ ، عَنْ مَنْصُورٍ ، عَنْ أَبِي وَائِلٍ ، قَالَ : قَالَ عَبْدُ اللَّهِ : \" الصِّرَاطُ الْمُسْتَقِيمُ كِتَابُ اللَّهِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/167> a hadith:Hadith ;
    rdfs:label "Hadith 167" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1453" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.10/19> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/167/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/167/chain/1>,
        <http://www.semantictafsir.com/resource/hadith/167/chain/2> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1745> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/176> ;
    st:hasHadithNo 167 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/255> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/167/note/1> ;
    st:hasText "حَدَّثَنَا الْمُثَنَّى ، قَالَ : حَدَّثَنَا أَبُو صَالِحٍ ، قَالَ : حَدَّثَنِي مُعَاوِيَةُ بْنُ صَالِحٍ ، أَنَّ عَبْدَ الرَّحْمَنِ بْنَ جُبَيْرٍ حَدَّثَهُ ، عَنْ أَبِيهِ ، عَنْ نَوَّاسِ بْنِ سِمْعَانَ الأَنْصَارِيِّ ، عَنْ رَسُولِ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، قَالَ : \" ضَرَبَ اللَّهُ مَثَلا صِرَاطًا مُسْتَقِيمًا ، وَالصِّرَاطُ الإِسْلامُ \" . حَدَّثَنَا الْمُثَنَّى ، قَالَ : حَدَّثَنَا آدَمَ الْعَسْقَلانِيُّ ، قَالَ : حَدَّثَنَا اللَّيْثُ ، عَنْ مُعَاوِيَةَ بْنِ صَالِحٍ ، عَنْ عَبْدِ الرَّحْمَنِ بْنِ جُبَيْرِ بْنِ نُفَيْرٍ ، عَنْ أَبِيهِ ، عَنِ النَّوَّاسِ بْنِ سِمْعَانَ الأَنْصَارِيِّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

<http://www.semantictafsir.com/resource/hadith/176> a hadith:Hadith ;
    rdfs:label "Hadith 176" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1860" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.12/19> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/176/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/176/chain/1>,
        <http://www.semantictafsir.com/resource/hadith/176/chain/2> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4861> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/176/segment/1> ;
    st:hasHadithNo 176 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/269> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/176/note/1> ;
    st:hasText "حَدَّثَنَا حُمَيْدُ بْنُ مَسْعَدَةَ السَّامِيُّ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، قَالَ : حَدَّثَنَا الْجُرَيْرِيُّ ، عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ ، أَنَّ رَجُلا أَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحَاصِرٌ وَادِي الْقُرَى ، فَقَالَ : مَنْ هَؤُلاءِ الَّذِينَ تُحَاصِرُ يَا رَسُولَ اللَّهِ ؟ قَالَ : \" هَؤُلاءِ الْمَغْضُوبُ عَلَيْهِمُ الْيَهُودُ \" . حَدَّثَنِي يَعْقُوبُ بْنُ إِبْرَاهِيمَ ، قَالَ : حَدَّثَنَا ابْنُ عُلَيَّةَ ، عَنْ سَعِيدٍ الْجُرَيْرِيِّ ، عَنْ عُرْوَةَ ، عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ ، أَنَّ رَجُلا أَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ نَحْوَهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/sirah> .

<http://www.semantictafsir.com/resource/hadith/177> a hadith:Hadith ;
    rdfs:label "Hadith 177" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1879" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.12/21> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/177/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/177/chain/1>,
        <http://www.semantictafsir.com/resource/hadith/177/chain/2> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1131>,
        <http://www.semantictafsir.com/resource/narrator/L4861> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/177/segment/1> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/188> ;
    st:hasHadithNo 177 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/271> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/177/note/1> ;
    st:hasText "حَدَّثَنَا الْحَسَنُ بْنُ يَحْيَى ، قَالَ : أَنْبَأَنَا عَبْدُ الرَّزَّاقِ ، قَالَ : أَخْبَرَنَا مَعْمَرٌ ، عَنْ بُدَيْلٍ الْعُقَيْلِيِّ ، قَالَ : أَخْبَرَنِي عَبْدُ اللَّهِ بْنُ شَقِيقٍ ، أَنَّهُ أَخْبَرَهُ مَنْ سَمِعَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ بِوَادِي الْقُرَى ، وَهُوَ عَلَى فَرَسِهِ ، وَسَأَلَهُ رَجُلٌ مِنْ بَنِي الْقَيْنِ ، فَقَالَ : يَا رَسُولَ اللَّهِ ، مَنْ هَؤُلاءِ ؟ قَالَ : \" الْمَغْضُوبُ عَلَيْهِمْ \" ، وَأَشَارَ إِلَى الْيَهُودِ . حَدَّثَنَا الْقَاسِمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ ، قَالَ : حَدَّثَنَا خَالِدٌ الْوَاسِطِيُّ ، عَنْ خَالِدٍ الْحَذَّاءِ ، عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ ، أَنَّ رَجُلا سَأَلَ النَّبِيَّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، فَذَكَرَ نَحْوَهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/sirah> .

<http://www.semantictafsir.com/resource/hadith/188> a hadith:Hadith ;
    rdfs:label "Hadith 188" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2157" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/187> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/188/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/188/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4861> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/188/segment/1> ;
    st:hasHadithNo 188 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/285> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/188/note/1> ;
    st:hasText "حَدَّثَنَا حُمَيْدُ بْنُ مَسْعَدَةَ السَّامِيُّ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ الْمُفَضَّلِ ، قَالَ : حَدَّثَنَا الْجُرَيْرِيُّ ، عَنْ عَبْدِ اللَّهِ بْنِ شَقِيقٍ ، أَنَّ رَجُلا أَتَى رَسُولَ اللَّهِ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ وَهُوَ مُحَاصِرٌ وَادِي الْقُرَى ، قَالَ : قُلْتُ : مَنْ هَؤُلاءِ ؟ قَالَ : \" هَؤُلاءِ الضَّالُّونَ النَّصَارَى \" ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/kalam> .

