<http://www.semantictafsir.com/resource/hadith/182> a hadith:Hadith ;
    rdfs:label "Hadith 182" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1945" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/181> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/182/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/182/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 182 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/278> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/182/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ ، قَالَ : حَدَّثَنِي حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ : \" غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ ، قَالَ : الْيَهُودُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

