<http://www.semantictafsir.com/resource/hadith/160/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1375" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/160/text/1/segment/1>,
