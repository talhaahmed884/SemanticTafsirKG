<http://www.semantictafsir.com/resource/commentary/1.5/22/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L745" ;
    st:hasText """يَا لَهْفَ نَفْسِي كَانَ جِدَّةُ خَالِدٍ
وَبَيَاضُ وَجْهِكَ لِلتُّرَابِ الأَعْفَرِ"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/ef465afa1b3f> .

<http://www.semantictafsir.com/resource/commentary/1.5/23/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L756" ;
    st:hasText """بَاتَتْ تَشَكَّى إِلَيَّ النَّفْسُ مُجْهَشَةً
وَقَدْ حَمَلْتُكِ سَبْعًا بَعْدَ سَبْعِينَا"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.5/25> a st:Commentary ;
    rdfs:label "Commentary 25" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L769" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.5/24> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.5/25/segment/1> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/157> ;
    st:hasCommentaryNo 25 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/52261> ;
    st:hasText "فَقِرَاءَةُ : مَالِكِ يَوْمِ الدِّينِ مَحْظُورَةٌ غَيْرُ جَائِزَةٍ ؛ لإِجْمَاعِ الْحُجَّةِ مِنَ الْقَرَأَةِ ، وَعُلَمَاءِ الأُمَّةِ عَلَى رَفْضِ الْقِرَاءَةِ بِهَا ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/qiraat>,
        <http://www.semantictafsir.com/resource/theme/rajeh> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/time/d535fd10832b> ;
    st:references <http://www.semantictafsir.com/resource/commentary/1.5/25/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/commentary/1.5/25/thematic-reference/2> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/2ece56e0ebe7> .

<http://www.semantictafsir.com/resource/commentary/1.5/25/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L774" ;
    st:hasText "مَحْظُورَةٌ غَيْرُ جَائِزَةٍ"@ar ;
