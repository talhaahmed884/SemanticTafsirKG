<http://www.semantictafsir.com/resource/hadith/146> a hadith:Hadith ;
    rdfs:label "Hadith 146" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L372" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/145> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/146/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/146/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/146/chain/1/link/5/narrator> ;
    st:hasHadithNo 146 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/223> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/146/note/1> ;
    st:hasText "حَدَّثَنِي أَحْمَدُ بْنُ حَازِمٍ الْغِفَارِيُّ ، قَالَ : حَدَّثَنَا عُبَيْدُ اللَّهِ بْنُ مُوسَى ، عَنْ أَبِي جَعْفَرٍ ، عَنِ الرَّبِيعِ بْنِ أَنَسٍ ، عَنْ أَبِي الْعَالِيَةِ ، فِي قَوْلِهِ : رَبِّ الْعَالَمِينَ ، قَالَ : \" الإِنْسُ عَالَمٌ ، وَالْجِنُّ عَالَمٌ ، وَمَا سِوَى ذَلِكَ ثَمَانِيَةَ عَشَرَ أَلْفَ عَالَمٍ ، أَوْ أَرْبَعَةَ عَشَرَ أَلْفَ عالم ، هُوَ يَشُكُّ ، مِنَ الْمَلائِكَةِ عَلَى الأَرْضِ ، وَلِلأَرْضِ أَرْبَعُ زَوَايَا ، فِي كُلِّ زَاوِيَةٍ ثَلاثَةُ آلافِ عَالَمٍ وَخَمْسُ مِائَةِ عَالِمٍ ، خَلَقَهُمْ لِعِبَادَتِهِ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/science> .

