<http://www.semantictafsir.com/resource/hadith/156> a hadith:Hadith ;
    rdfs:label "Hadith 156" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1308" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.10/4> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/156/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/156/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1200> ;
    st:hasHadithNo 156 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/240> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/156/note/1> ;
    st:hasText "وَمِمَّا قَالَتْهُ فِي ذَلِكَ مَا رُوِيَ عَنْ عَلِيِّ بْنِ أَبِي طَالِبٍ ، رَضِيَ اللَّهُ عَنْهُ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، أَنَّهُ قَالَ ، وَذَكَرَ الْقُرْآنَ ، فَقَالَ : \" هُوَ الصِّرَاطُ الْمُسْتَقِيمُ \" . حَدَّثَنَا بِذَلِكَ ، مُوسَى بْنُ عَبْدِ الرَّحْمَنِ الْمَسْرُوقِيُّ ، قَالَ : حَدَّثَنَا حُسَيْنٌ الْجُعْفِيُّ ، عَنْ حَمْزَةَ الزَّيَّاتِ ، عَنْ أَبِي الْمُخْتَارِ الطَّائِيِّ ، عَنِ ابْنِ أَخِي الْحَارِثِ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ . وَحُدِّثْتُ عَنْ إِسْمَاعِيلَ بْنِ أَبِي كَرِيمَةَ ، قَالَ : حَدَّثَنَا مُحَمَّدُ بْنُ سَلَمَةَ ، عَنْ أَبِي سِنَانٍ ، عَنْ عَمْرِو بْنِ مُرَّةَ ، عَنْ أَبِي الْبَخْتَرِيِّ ، عَنِ الْحَارِثِ ، عَنْ عَلِيٍّ ، عَنِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ ، مِثْلَهُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/3b926d422bf8>,
        <http://www.semantictafsir.com/resource/entity/person/fafb4eb71063> .

