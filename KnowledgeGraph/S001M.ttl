<http://www.semantictafsir.com/resource/commentary/0.14/10/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L520" ;
    st:hasText "ثُمَّ اسْمُ السَّلامِ عَلَيْكُمَا"@ar .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L500" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.14/10/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.14/10/segment/1/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/118> ;
    st:hasText "أَرَادَ : ثُمَّ السَّلامُ عَلَيْكُمَا وَادِّعَائِهِ أَنَّ إِدْخَالَ الاسْمِ فِي ذَلِكَ ، وَإِضَافَتَهُ إِلَى السَّلامِ ، إِنَّمَا جَازَ ، إِذَا كَانَ اسْمُ الْمُسَمَّى هُوَ الْمُسَمَّى بِعَيْنِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L501" ;
    st:hasText "إِضَافَتَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L503" ;
    st:hasText "اسْمُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L517" ;
    st:hasText "السَّلامَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sifatilahi> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L518" ;
    st:hasText "اسْمٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L522" ;
    st:hasText "مَّ الْزَمَا اسْمَ اللَّهِ وَذِكْرَهُ بَعْدَ ذَلِكَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L523" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.14/10/segment/5/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/0.14/10/segment/5/segment/2> ;
    st:hasText "وَدَعَا ذِكْرِيَ وَالْبُكَاءَ عَلَيَّ ، عَلَى وَجْهِ الإِغْرَاءِ ، فَرُفِعَ الاسْمُ ، إِذْ أُخِّرَ الْحَرْفُ الَّذِي يَأْتِي بِمَعْنَى الإِغْرَاءِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/5/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L525" ;
    st:hasText "الاسْمُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/5/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L526" ;
    st:hasText "الْحَرْفُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/10/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L527" ;
    st:hasText "قَدْ تَفْعَلُ الْعَرَبُ ذَلِكَ إِذَا أَخَّرَتِ الإِغْرَاءَ وَقَدَّمَتَ الْمُغْرَى بِهِ ، وَإِنْ كَانَتْ قَدْ تَنْصِبُ بِهِ وَهُوَ مُؤَخَّرٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> .

<http://www.semantictafsir.com/resource/commentary/0.14/11/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L532" ;
    st:hasText """يَأَيُّهَا الْمَائِحُ دَلْوِي دُونَكَا
إِنِّي رَأَيْتُ النَّاسَ يَحْمَدُونَكَا"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.14/11/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L537" ;
    st:hasText "إِلَى الْحَوْلِ ثُمَّ اسْمُ السَّلامِ عَلَيْكُمَا"@ar .

<http://www.semantictafsir.com/resource/commentary/0.14/11/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L535" ;
    st:hasText "أَغْرَى بـ ( دُونَكَ ) ، وَهِيَ مُؤْخِرَةٌ ، وَإِنَّمَا مَعْنَاهُ : دُونَكَ دَلْوِي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/0.14/11/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L539" ;
    st:hasText "يَعْنِي : ثُمَّ عَلَيْكُمَا اسْمُ السَّلامِ ، أَيِ : الْزَمَا ذِكْرَ اللَّهُ ، وَدَعَا ذِكْرِيَ ، وَالْوَجْدَ بِي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/0.14/11/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L542" ;
    st:hasText "الْوَجْهُ الآخَرُ مِنْهُمَا : ثُمَّ تَسْمِيَتِي اللَّهَ عَلَيْكُمَا ، كَمَا يَقُولُ الْقَائِلُ لِلشَّيْءِ يَرَاهُ فَيُعْجِبُهُ : اسْمُ اللَّهِ عَلَيْكَ ، يَعُوذُهُ بِذَلِكَ مِنَ السُّوءِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/0.14/11/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L546" ;
    st:hasText "كَأَنَّهُ قَالَ : ثُمَّ اسْمُ اللَّهِ عَلَيْكُمَا مِنَ السُّوءِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/0.14/13> a st:Commentary ;
    rdfs:label "Commentary 13" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L580" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/125> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.14/13/segment/1> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/121> ;
    st:hasCommentaryNo 13 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/64283> ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/190> ;
    st:hasText "فَأَخْشَى أَنْ يَكُونَ غَلَطًا مِنَ الْمُحَدِّثِ ، وَأَنْ يَكُونَ أَرَادَ : ( ب س م ) ، عَلَى سَبِيلِ مَا يُعَلَّمُ الْمُبْتَدِئُ مِنَ الصِّبْيَانِ فِي الْكُتَّابِ ، حُرُوفَ أَبِي جَادٌ ، فَغَلِطَ بِذَلِكَ فَوَصَلَهُ ، فَقَالَ : \" بِاسْمِ \" ؛ لأَنَّهُ لا مَعْنَى لِهَذَا التَّأْوِيلِ إِذَا تُلِيَ : بِسْمِ اللَّهِ الرَّحْمَنِ الرَّحِيمِ . عَلَى مَا يَتْلُوهُ الْقَارِئُ فِي كِتَابِ اللَّهِ تعالى ؛ لاسْتِحَالَةِ مَعْنَاهُ عَنِ الْمَفْهُومِ بِهِ عِنْدَ جَمِيعِ الْعَرَبِ ، وَأَهْلِ لِسَانِهَا ، إِذَا حُمِلَ تَأْوِيلُهُ عَلَى ذَلِكَ ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091> ;
    st:references <http://www.semantictafsir.com/resource/commentary/0.14/13/thematic-reference/1>,
        <http://www.semantictafsir.com/resource/commentary/0.14/13/thematic-reference/2> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/1> .

<http://www.semantictafsir.com/resource/commentary/0.14/13/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L583" ;
    st:hasText "حُرُوفَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/0.14/13/thematic-reference/1> a st:ThematicVerseReference ;
    rdfs:label "Thematic Verse Reference 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L586" ;
