<http://www.semantictafsir.com/resource/hadith/139> a hadith:Hadith ;
    rdfs:label "Hadith 139" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L304" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.3/3> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/139/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/139/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 139 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/215> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/139/note/1> ;
    st:hasText "حَدَّثَنَا أَبُو كُرَيْبٍ ، قَالَ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنِ ابْنِ عَبَّاسٍ : \" الْحَمْدُ لِلَّهِ رَبِّ الْعَالَمِينَ . الْحَمْدُ لِلَّهِ الَّذِي لَهُ الْخَلْقُ كُلُّهُ ، السَّمَوَاتُ وَالأَرْضُونَ ، وَمَنْ فِيهِنَّ ، وَمَا بَيْنَهُنَّ ، مِمَّا يُعْلَمُ وَمِمَّا لا يُعْلَمُ \""@ar .

<http://www.semantictafsir.com/resource/hadith/139/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
