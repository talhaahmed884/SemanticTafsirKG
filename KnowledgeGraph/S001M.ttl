<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1780" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/3/segment/1> ;
    st:hasText "فِي الجحد : ما قام أخوك وَلا أبوك"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1781" ;
    st:hasText "الجحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1785" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/4/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/4/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/4/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/4/segment/4> ;
    st:hasText "وَلا الضَّالِّينَ معطوفا عَلَى قوله : غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ وَلا الضَّالِّينَ . أن : غَيْرِ بمعنى الجحد لا بمعنى الاستثناء ، وأن تأويل من وجهها إلى الاستثناء خطأ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/0a35d7b453b3>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/515b0665ed65>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/c0ead6c821a0> .

