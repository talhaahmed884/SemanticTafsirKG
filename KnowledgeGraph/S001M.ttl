<http://www.semantictafsir.com/resource/hadith/164> a hadith:Hadith ;
    rdfs:label "Hadith 164" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1421" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.10/15> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/164/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/164/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 164 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/251> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/164/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ بْنُ دَاوُدَ ، قَالَ : حَدَّثَنِي حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، قَالَ : قَالَ ابْنُ عَبَّاسٍ فِي قَوْلِهِ : \" اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ ، قَالَ : الطَّرِيقُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/israeliyat>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> .

