<http://www.semantictafsir.com/resource/commentary/0.11/3/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L41" ;
    st:hasText """وَأَسْمَرَ قَوَّامٍ إِذَا نَامَ صُحْبَتِي
خَفِيفَ الثِّيَابِ لا تُوَارِي لَهُ أَزْرَا
عَلَى رَأْسِهِ أُمٌّ لَنَا نَقْتَدِي بِهَا
جِمَاعُ أُمُورٍ لا نُعَاصِي لَهَا أَمْرَا
إِذَا نَزَلَتْ قِيلَ انْزِلُوا ، وَإِذَا غَدَتْ
غَدَتْ ذَاتَ بِرْزِيقٍ تَخَالُ بِهَا فَخْرَا"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.11/3/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L64" ;
    st:hasText """إِذَا كَانَتِ الْخَمْسُونَ أُمُّكَ لَمْ يَكُنْ
لِدَائِكَ إِلا أَنْ تَمُوتَ طَبِيبُ"""@ar .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L22" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/0.11/3/segment/1/segment/1> ;
    st:hasText "سُمِّيَتْ فَاتِحَةَ الْكِتَابِ ؛ لأَنَّهُ يُفْتَتَحُ بِكِتَابَتِهَا الْمَصَاحِفُ ، وَبِقِرَاءَتِهَا الصَّلَوَاتُ ، فَهِيَ فَوَاتِحُ لِمَا يَتْلُوهَا مِنْ سُوَرِ الْقُرْآنِ فِي الْكِتَابِ ، وَالْقِرَاءَةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2>,
        <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L24" ;
    st:hasText "الصَّلَوَاتُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/salat> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L26" ;
    st:hasText "سُمِّيَتْ أُمَّ الْقُرْآنِ ، لِتَقَدُّمِهَا عَلَى سَائِرِ سُوَرِ الْقُرْآنِ غَيْرِهَا ، وَتَأَخُّرِ مَا سِوَاهَا خَلْفَهَا ، فِي الْقِرَاءَةِ وَالْكِتَابَةِ ، وَذَلِكَ مِنْ مَعْنَاهَا شَبِيهٌ بِمَعْنَى فَاتِحَةِ الْكِتَابِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2>,
        <http://www.semantictafsir.com/resource/entity/other/371cbc5ccb8b> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L31" ;
    st:hasText "قِيلَ لَهَا ، لِكَوْنِهَا كَذَلِكَ : أُمُّ الْقُرْآنِ ؛ لِتَسْمِيَةِ الْعَرَبِ كُلَّ جَامِعٍ أَمْرًا ، أَوْ مُقَدَّمٍ لأَمْرٍ ، إِذَا كَانَتْ لَهُ تَوَابِعُ تَتْبَعُهُ ، هُوَ لَهَا إِمَامٌ جَامِعٌ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091>,
        <http://www.semantictafsir.com/resource/entity/other/1449aec26bf2> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L36" ;
    st:hasText "جِلْدَةِ الَّتِي تَجْمَعُ الدِّمَاغَ : أُمَّ الرَّأْسِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L38" ;
    st:hasText "تُسَمِّي لِوَاءَ الْجَيْشِ وَرَايَتَهُمُ الَّتِي يَجْتَمِعُونَ تَحْتَهَا لِلْجَيْشِ أُمًّا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L55" ;
    st:hasText "يَعْنِي بِقَوْلِهِ : عَلَى رَأْسِهِ أُمٌّ لَنَا ، أَيْ : عَلَى رَأْسِ الرُّمْحِ رَايَةٌ يَجْتَمِعُونَ لَهَا فِي النُّزُولِ وَالرَّحِيلِ ، وَعِنْدَ لِقَاءِ الْعَدُوِّ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/7> a st:Segment ;
    rdfs:label "Segment 7" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L58" ;
    st:hasText "قَدْ قِيلَ : إِنَّ مَكَّةَ سُمِّيَتْ أُمَّ الْقُرَى ، لِتَقَدُّمِهَا أَمَامَ جَمِيعِهَا ، وَجَمْعِهَا مَا سِوَاهَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/351b0d714170>,
        <http://www.semantictafsir.com/resource/entity/location/82b138c31c62> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/8> a st:Segment ;
    rdfs:label "Segment 8" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L61" ;
    st:hasText "قِيلَ : إِنَّمَا سُمِّيَتْ بِذَلِكَ ؛ لأَنَّ الأَرْضَ دُحِيَتْ مِنْهَا ، فَصَارَتْ لِجَمِيعِهَا أُمًّا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.11/3/segment/9> a st:Segment ;
    rdfs:label "Segment 9" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L71" ;
    st:hasText "تَأْوِيلُ اسْمِهَا أَنَّهَا السَّبْعُ ، فَإِنَّهَا سَبْعُ آيَاتٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughawi> .

<http://www.semantictafsir.com/resource/commentary/0.11/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L88" ;
    st:hasText "أَهْلِ الْمَدِينَةِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/qmadina> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/75124a0090df> .

<http://www.semantictafsir.com/resource/commentary/0.11/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L100" ;
    st:hasText "صَلاةِ تَطَوُّعٍ وَمَكْتُوبَةٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/salat> .

