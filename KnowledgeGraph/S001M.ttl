    st:hasText "معرفة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
