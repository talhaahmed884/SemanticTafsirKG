<http://www.semantictafsir.com/resource/commentary/1.12/14/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1801" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/14/segment/6/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/14/segment/6/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/14/segment/6/segment/3> ;
    st:hasText "الصواب من القول فِي تأويله وقراءته عندنا القول الأول ، وَهُوَ قراءة : غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ بخفض الراء من غَيْرِ بتأويل أنها صفة الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ . ونعت لهم ، لما قد قدمنا من البيان ، إن شئت ، وإن شئت فبتأويل تكرير صِرَاطَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:references <http://www.semantictafsir.com/resource/commentary/1.12/14/segment/6/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/0a35d7b453b3>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/5dc689230521>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/9461b4987ce7> .

