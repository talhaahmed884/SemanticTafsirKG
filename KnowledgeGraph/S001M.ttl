<http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1627" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/10>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/11>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/4>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/5>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/6>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/7>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/8>,
        <http://www.semantictafsir.com/resource/commentary/1.12/2/segment/1/segment/9> ;
    st:hasText "صفة لـ : الَّذِينَ ونعتا لهم فتخفضها ، إذا كَانَ الَّذِينَ خفضا ، وهي لهم نعت وصفة . وإنما جاز أن يَكُون غَيْرِ نعتا لـ : الَّذِينَ ، و الَّذِينَ معرفة ، و غَيْرِ . نكرة ؛ لأن الَّذِينَ بصلتها ليست بالمعرفة المؤقتة ، كالأسماء التي هِيَ أمارات بين النّاس"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/0a35d7b453b3>,
        <http://www.semantictafsir.com/resource/quran/fragment/d21bd175cec8> .

