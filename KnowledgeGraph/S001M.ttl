    st:hasTheme <http://www.semantictafsir.com/resource/theme/usulfiqh> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/5/fragment/73b28f7d3913> .

<http://www.semantictafsir.com/resource/commentary/1.8/4/thematic-reference/6> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 6" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L965" ;
