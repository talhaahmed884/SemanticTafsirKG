<http://www.semantictafsir.com/resource/commentary/0.16/5/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L915" ;
    st:hasText "جَعَلَ مَعْنَى الرَّحْمَنِ ، بِمَعْنَى الرَّقِيقِ عَلَى مَنْ رَقَّ عَلَيْهِ ، وَمَعْنَى الرَّحِيمِ بِمَعْنَى الرَّفِيقِ بِمَنْ رَفَقَ بِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

