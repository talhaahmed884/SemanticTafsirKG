    st:hasText "نكرة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/11/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1747" ;
    st:hasText "نصبا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/11/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1747" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/11/segment/2/segment/1> ;
    st:hasText "اهدنا الصراط المستقيم ، صراط الَّذِين أنعمت عليهم ، إِلَّا المغضوب عليهم ، الَّذِين لَمْ تنعم عليهم فِي أديانهم وَلَم تهدهم للحق ، فلا تجعلنا منهم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.12/11/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1749" ;
    st:hasText "حق"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/11/thematic-reference/1> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1740" ;
    st:hasText "قَدْ كَانَ بعض نحويي البصريين يزعم أن قراءة من نَصَبِ ( غير ) فِي غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ عَلَى وجه استثناء : غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ من معاني صفة الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/98588a9a1330> .

<http://www.semantictafsir.com/resource/commentary/1.12/11/thematic-reference/2> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1741" ;
    st:hasText "نَصَبِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/98588a9a1330> .

<http://www.semantictafsir.com/resource/commentary/1.12/11/thematic-reference/3> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1743" ;
    st:hasText "استثناء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/98588a9a1330> .

<http://www.semantictafsir.com/resource/commentary/1.12/11/thematic-reference/4> a st:ThematicVerseFragmentReference ;
    rdfs:label "Thematic Verse Fragment Reference 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1745" ;
    st:hasText "صفة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/98588a9a1330> .

<http://www.semantictafsir.com/resource/commentary/1.12/12/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1752" ;
    st:hasText """وقفت فيها أصيلا لا أسائلها
عيت جوابا وما بالربع من أحد"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.12/12/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1757" ;
    st:hasText """إلا أواري لأيا ما أبينها
والنؤي كالحوض بالمظلومة الجلد"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.12/12/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1763" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/12/segment/1/segment/1> ;
    st:hasText "فكذلك عنده استثنى : غَيْرِ الْمَغْضُوبِ عَلَيْهِمْ من الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ . وإن لَمْ يكونوا من معانيهم فِي الدّين فِي شيء"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.12/12/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1765" ;
    st:hasText "الدّين"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1766" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1/segment/4> ;
    st:hasText "أمّا نحويو الكوفيين فأنكروا هَذَا التأويل واستخطئوه ، وزعموا أن ذَلِكَ لو كَانَ كَمَا قاله الزاعم ما زعم من أهل البصرة ، لكان خطأ أن يُقَالَ : وَلا الضَّالِّينَ ؛ لأن ( لا ) نفي وجحد ، وَلَا يعطف بجحد إلا عَلَى جحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/location/7dcf868fd74e>,
        <http://www.semantictafsir.com/resource/entity/organization/3f8e9a955cfa> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/c0ead6c821a0> .

<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1771" ;
    st:hasText "نفي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/13/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
