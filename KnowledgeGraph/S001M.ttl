<http://www.semantictafsir.com/resource/hadith/192/text/1> a hadith:HadithText ;
    rdfs:label "Hadith Text 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2220" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/192/text/1/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/192/text/1/segment/2>,
        <http://www.semantictafsir.com/resource/hadith/192/text/1/segment/3>,
        <http://www.semantictafsir.com/resource/hadith/192/text/1/segment/4>,
        <http://www.semantictafsir.com/resource/hadith/192/text/1/segment/5>,
        <http://www.semantictafsir.com/resource/hadith/192/text/1/segment/6> ;
    st:hasText "\" وَلا الضَّالِّينَ ، قَالَ : وَغَيْرِ طَرِيقِ النَّصَارَى ، الَّذِينَ أَضَلَّهُمُ اللَّهُ بِفِرْيَتِهِمْ عَلَيْهِ ، قَالَ : يَقُولُ : فَأَلْهِمْنَا دِينَكَ الْحَقَّ ، وَهُوَ لا إِلَهَ إِلا اللَّهُ وَحْدَهُ لا شَرِيكَ لَهُ ، حَتَّى لا تَغْضَبَ عَلَيْنَا كَمَا غَضِبْتَ عَلَى الْيَهُودِ ، وَلا تُضِلَّنَا كَمَا أَضْلَلْتَ النَّصَارَى ، فَتُعَذِّبَنَا بِمَا تُعَذِّبُهُمْ بِهِ ، يَقُولُ : امْنَعْنَا مِنْ ذَلِكَ بِرِفْقِكَ ، وَرَحْمَتِكَ وَقُدْرَتِكَ \""@ar ;
    st:references <http://www.semantictafsir.com/resource/hadith/192/text/1/thematic-reference/1> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/c0ead6c821a0> .

<http://www.semantictafsir.com/resource/hadith/192/text/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2222" ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/192/text/1/segment/1/segment/1> ;
    st:hasText "وَغَيْرِ طَرِيقِ النَّصَارَى ، الَّذِينَ أَضَلَّهُمُ اللَّهُ بِفِرْيَتِهِمْ عَلَيْهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/nasraniya> .

