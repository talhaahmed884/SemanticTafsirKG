    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.11/12/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1591" ;
    st:hasText """كَأَنَّكَ مِنْ جِمَالِ بَنِي أُقَيْشٍ
يُقَعْقِعُ خَلْفَ رِجْلَيْهِ بِشَنِّ"""@ar ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/152c34162aaf> .

<http://www.semantictafsir.com/resource/commentary/1.11/12/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1599" ;
    st:hasText "يُرِيدُ : كَأَنَّكَ مِنْ جِمَالِ بَنِي أُقَيْشٍ ، جَمَلٌ يُقَعْقِعُ خَلْفَ رِجْلَيْهِ بِشَنٍّ ، فَاكْتَفَى بِمَا ظَهَرَ مِنْ ذِكْرِ الْجِمَالِ الدَّالِّ عَلَى الْمَحْذُوفِ مِنْ إِظْهَارِ مَا حُذِفَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/152c34162aaf> .

<http://www.semantictafsir.com/resource/commentary/1.11/13> a st:Commentary ;
    rdfs:label "Commentary 13" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1603" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.11/12> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.11/13/segment/1> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/180> ;
    st:hasCommentaryNo 13 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/42523> ;
    st:hasPart <http://www.semantictafsir.com/resource/commentary/1.11/13/poetry/1> ;
    st:hasText "وَكَمَا قَالَ الْفَرَزْدَقُ بْنُ غَالِبٍ : تَرَى أَرْبَاقَهُمْ مُتَقَلِّدِيهَا إِذَا صَدِئَ الْحَدِيدُ عَلَى الْكُمَاةِ يُرِيدُ : مُتَقَلِّدِيهَا هُمْ ، فَحَذَفَ ( هُمْ ) إِذَا كَانَ الظَّاهِرُ مِنْ قَوْلِهِ : أَرْبَاقَهُمْ ، دَالا عَلَيْهَا . وَالشَّوَاهِدُ عَلَى ذَلِكَ مِنْ شِعْرِ الْعَرَبِ وَكَلامِهَا أَكْثَرُ مِنْ أَنْ تُحْصَى ، فَكَذَلِكَ ذَلِكَ فِي قَوْلِهِ : صِرَاطَ الَّذِينَ أَنْعَمْتَ عَلَيْهِمْ ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/a5288bb10091>,
        <http://www.semantictafsir.com/resource/entity/person/c1af3d07cfda> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/4314d74e46ad> .

<http://www.semantictafsir.com/resource/commentary/1.11/13/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1604" ;
    st:hasText """تَرَى أَرْبَاقَهُمْ مُتَقَلِّدِيهَا
إِذَا صَدِئَ الْحَدِيدُ عَلَى الْكُمَاةِ"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.11/13/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1610" ;
    st:hasText "يُرِيدُ : مُتَقَلِّدِيهَا هُمْ ، فَحَذَفَ ( هُمْ ) إِذَا كَانَ الظَّاهِرُ مِنْ قَوْلِهِ : أَرْبَاقَهُمْ ، دَالا عَلَيْهَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad>,
        <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.11/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1505" ;
    st:hasText "الهداية"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.11/2/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1505" ;
    st:hasText "طريق المستقيم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.11/2/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1506" ;
    st:hasText "الهداية"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.11/2/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1508" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.11/2/segment/4/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.11/2/segment/4/segment/2> ;
    st:hasText "وعد من سلكه فاستقام فِيهِ طائعا للَّه ولرسوله صلّى الله عَلَيْه وَسَلَّمَ ، أن يورده مواردهم ، والله لا يخلف الميعاد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/targhibtarhib> .

<http://www.semantictafsir.com/resource/commentary/1.11/2/segment/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1508" ;
    st:hasText "من سلكه"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/fazail> .

<http://www.semantictafsir.com/resource/commentary/1.11/2/segment/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1509" ;
    st:hasText "فاستقام فِيهِ طائعا للَّه ولرسوله"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/fazail> .

