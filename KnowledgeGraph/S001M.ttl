<http://www.semantictafsir.com/resource/hadith/126> a hadith:Hadith ;
    rdfs:label "Hadith 126" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L604" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.15/1> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/126/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/126/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasHadithNo 126 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/191> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/126/note/1> ;
    st:hasText "أَبَا كُرَيْبٍ حَدَّثَنَا ، قَالُ : حَدَّثَنَا عُثْمَانُ بْنُ سَعِيدٍ ، قَالَ : حَدَّثَنَا بِشْرُ بْنُ عُمَارَةَ ، قَالَ : حَدَّثَنَا أَبُو رَوْقٍ ، عَنِ الضَّحَّاكِ ، عَنْ عَبْدِ اللَّهِ بْنِ عَبَّاسٍ ، قَالَ : \" اللَّهُ ذُو الأُلُوهِيَّةِ ، وَالْعُبُودِيَّةِ عَلَى خَلْقِهِ أَجْمَعِينَ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam> .

<http://www.semantictafsir.com/resource/hadith/126/chain/1/link/6> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 6" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/127> a hadith:Hadith ;
    rdfs:label "Hadith 127" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L637" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.15/3> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/127/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/127/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/127/segment/1> ;
    st:hasHadithNo 127 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/193> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/127/note/1> ;
    st:hasText "وَذَلِكَ مَا حَدَّثَنَا بِهِ سُفْيَانُ بْنُ وَكِيعٍ ، قَالَ : حَدَّثَنَا أَبِي ، عَنْ نَافِعِ بْنِ عُمَرَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنِ ابْنِ عَبَّاسٍ أَنَّهُ قَرَأَ : \" وَيَذَرَكَ وَإِلاهَتَكَ \" . قَالَ : عِبَادَتَكَ ، وَيَقُولُ : \" إِنَّهُ كَانَ يُعْبَدُ وَلا يَعْبُدُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha>,
        <http://www.semantictafsir.com/resource/theme/qiraat> .

<http://www.semantictafsir.com/resource/hadith/127/chain/1/link/5> a hadith:NarratorChainSegment,
        hadith:RootNarratorChainSegment ;
    rdfs:label "Chain Link 5" ;
    hadith:refersToNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:hasType "sahabi" .

<http://www.semantictafsir.com/resource/hadith/128> a hadith:Hadith ;
    rdfs:label "Hadith 128" ;
    dcterms:source "S001M/sure_1_section_0.11-0.16.xml#L652" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/0.15/5> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/128/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/128/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L4883> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/128/segment/1>,
        <http://www.semantictafsir.com/resource/hadith/128/segment/2>,
        <http://www.semantictafsir.com/resource/hadith/128/segment/3> ;
    st:hasHadithNo 128 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/195> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/128/note/1> ;
    st:hasText "وَحَدَّثَنَا سُفْيَانُ ، قَالَ : حَدَّثَنَا ابْنُ عُيَيْنَةَ ، عَنْ عَمْرِو بْنِ دِينَارٍ ، عَنْ مُحَمَّدِ بْنِ عَمْرِو بْنِ الْحَسَنِ ، عَنِ ابْنِ عَبَّاسٍ : \" وَيَذَرَكَ وَإِلاهَتَكَ ، قَالَ : \" إِنَّمَا كَانَ فِرْعَوْنُ يُعْبَدُ وَلا يَعْبُدُ ، وَكَذَلِكَ كَانَ ابْنُ عَبَّاسٍ يَقْرَؤُهَا وَمُجَاهِدٌ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/adyan>,
        <http://www.semantictafsir.com/resource/theme/qiraat> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/8cc2d1f25465> .

<http://www.semantictafsir.com/resource/hadith/128/chain/1/link/5> a hadith:NarratorChainSegment,
