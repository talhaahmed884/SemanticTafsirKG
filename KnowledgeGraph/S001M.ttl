    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1723" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/10/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/10/segment/1/segment/2> ;
    st:hasBookLocation <http://www.semantictafsir.com/resource/location/book/turki/1/183> ;
    st:hasText "تأويل وجه صوابه إذا نصبت أن يوجه إلى أن يَكُون صفة للهاء والميم اللتين فِي عَلَيْهِمْ العائدة عَلَى : الَّذِينَ ؛ لأنها وإن كَانَتْ مخفوضة بـ ( عَلَى ) ، فهي فِي محل نَصْبٍ بقوله : أَنْعَمْتَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/05fae33bd3c3> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1726" ;
    st:hasText "مخفوضة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1727" ;
    st:hasText "نَصْبٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1728" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/10/segment/2/segment/1> ;
    st:hasText "تأويل الكلام ، إذا نصبت ( غَيْر ) التي مَعَ الْمَغْضُوبِ عَلَيْهِمْ صراط الَّذِين هديتهم إنعاما منك عليهم ، غَيْر مغضوب عليهم"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/2/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1728" ;
    st:hasText "إذا نصبت ( غَيْر ) التي مَعَ الْمَغْضُوبِ عَلَيْهِمْ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1730" ;
    st:hasText "أَيْ : لا مغضوبا عليهم ، وَلا ضالين"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1731" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4/segment/4> ;
    st:hasText "فيكون النصب فِي ذَلِكَ حينئذ كالنصب فِي ( غير ) ، فِي قولك : مررت بعبد الله غَيْر الكريم ، وَلا الرشيد . فتقطع غير الكريم من عَبْد الله ، إذ كَانَ عَبْد الله معرفة مؤقتة ، وغير الكريم نكرة مجهولة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/person/cab33c7d10ae> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1732" ;
    st:hasText "النصب"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

<http://www.semantictafsir.com/resource/commentary/1.12/10/segment/4/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1733" ;
    st:hasText "النصب"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lughaterm> .

