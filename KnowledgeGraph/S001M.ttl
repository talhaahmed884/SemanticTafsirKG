<http://www.semantictafsir.com/resource/hadith/163> a hadith:Hadith ;
    rdfs:label "Hadith 163" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1404" ;
    hadith:follows <http://www.semantictafsir.com/resource/hadith/162> ;
    hadith:hasHadithText <http://www.semantictafsir.com/resource/hadith/163/text/1> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/163/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/narrator/L1131> ;
    st:hasHadithNo 163 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/249> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/163/note/1> ;
    st:hasText "حَدَّثَنَا مُوسَى بْنُ هَارُونَ الْهَمْدَانِيُّ ، قَالَ : حَدَّثَنَا عَمْرُو بْنُ طَلْحَةَ الْقَنَّادُ ، قَالَ : حَدَّثَنَا أَسْبَاطٌ ، عَنِ السُّدِّيِّ ، فِي خَبَرٍ ذَكَرَهُ عَنْ أَبِي مَالِكٍ ، وَعَنْ أَبِي صَالِحٍ ، عَنِ ابْنِ عَبَّاسٍ ، وَعَنْ مُرَّةَ الْهَمْدَانِيِّ ، عَنِ ابْنِ مَسْعُودٍ ، وَعَنْ نَاسٍ مِنْ أَصْحَابِ النَّبِيِّ صَلَّى اللَّهُ عَلَيْهِ وَسَلَّمَ : \" اهْدِنَا الصِّرَاطَ الْمُسْتَقِيمَ : هُوَ الإِسْلامُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/israeliyat>,
        <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/5466e6a00d41> .

