    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/6> .

<http://www.semantictafsir.com/resource/commentary/1.9/10> a st:Commentary ;
    rdfs:label "Commentary 10" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1249" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.9/9> ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.9/10/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.9/10/segment/2> ;
    st:hasCommentaryNo 10 ;
    st:hasDatasetLocation <http://www.semantictafsir.com/resource/location/dataset/GK/44578> ;
    st:hasPart <http://www.semantictafsir.com/resource/commentary/1.9/10/poetry/1> ;
    st:hasText "يُرِيدُ : أَسْتَغْفِرُ اللَّهَ لِذَنْبٍ ، كَمَا قَالَ جَلَّ ثَنَاؤُهُ : وَاسْتَغْفِرْ لِذَنْبِكَ ، وَمِنْهُ قَوْلُ نَابِغَةَ بَنِي ذُبْيَانَ : فَيَصِيدُنَا الْعِيرَ الْمُدِلَّ بِحُضْرِهِ قَبْلَ الْوَنَى وَالأَشْعَبِ النَّبَّاحَا يُرِيدُ : فَيَصِيدُ لَنَا ، وَذَلِكَ كَثِيرٌ فِي أَشْعَارِهِمْ وَكَلامِهِمْ ، وَفِيمَا ذَكَرْنَا مِنْهُ كِفَايَةٌ ، واللَّهُ الْمُوَفِّقُ ."@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:mentions <http://www.semantictafsir.com/resource/entity/organization/625a4ef648d4> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/40/55/fragment/936dd3ad50e6> .

<http://www.semantictafsir.com/resource/commentary/1.9/10/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1252" ;
    st:hasText """فَيَصِيدُنَا الْعِيرَ الْمُدِلَّ بِحُضْرِهِ
قَبْلَ الْوَنَى وَالأَشْعَبِ النَّبَّاحَا"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.9/10/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1249" ;
    st:hasText "أَسْتَغْفِرُ اللَّهَ لِذَنْبٍ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/10/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1257" ;
    st:hasText "فَيَصِيدُ لَنَا"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/poetry/1> a st:Poetry ;
    rdfs:label "Poetry 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1128" ;
    st:hasText """لا تَحْرِمَنِّي هَدَاكَ اللَّهُ مَسْأَلَتِي
وَلا أَكُونَنَّ كَمَنْ أَوْدَى بِهِ السَّفَرُ"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.9/3/poetry/2> a st:Poetry ;
    rdfs:label "Poetry 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1135" ;
    st:hasText """وَلا تُعْجِلَنِّي هَدَاكَ الْمَلِيكُ
فَإِنَّ لِكُلِّ مَقَامٍ مَقَالا"""@ar .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1109" ;
    st:hasText "تَوْفِيقُ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1112" ;
    st:hasText "التَّوْفِيقَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1113" ;
    st:hasText "الْحَقِّ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/4> a st:Segment ;
    rdfs:label "Segment 4" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1117" ;
    st:hasText "مَسْأَلَةٌ مِنْهُ رَبَّهُ الْمَعُونَةَ عَلَى أَدَاءِ مَا قَدْ كَلَّفَهُ مِنْ طَاعَتِهِ فِيمَا بَقِيَ مِنْ عُمْرِهِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/5> a st:Segment ;
    rdfs:label "Segment 5" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1119" ;
    st:hasText "مَعْنَى الْكَلامِ : اللَّهُمَّ إِيَّاكَ نَعْبُدُ وَحْدَكَ لا شَرِيكَ لَكَ ، مُخْلِصِينَ لَكَ الْعِبَادَةَ دُونَ مَا سِوَاكَ مِنَ الآلِهَةِ وَالأَوْثَانِ ، فَأَعِنَّا عَلَى عِبَادَتِكَ ، وَوَفِّقْنَا لِمَا وَفَّقْتَ لَهُ مَنْ أَنْعَمْتَ عَلَيْهِ مِنْ أَنْبِيَائِكَ ، وَأَهْلِ طَاعَتِكَ مِنَ السُّبُلِ وَالْمِنْهَاجِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/6> a st:Segment ;
    rdfs:label "Segment 6" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1124" ;
    st:hasText "الْهِدَايَةَ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/7> a st:Segment ;
    rdfs:label "Segment 7" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1126" ;
    st:hasText "التَّوْفِيقِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalamterm> .

<http://www.semantictafsir.com/resource/commentary/1.9/3/segment/8> a st:Segment ;
    rdfs:label "Segment 8" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1134" ;
    st:hasText "بِمَعْنَى : وَفَّقَكَ اللَّهُ لِقَضَاءِ حَاجَتِي"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.9/4/segment/1> a st:Segment ;
