<http://www.semantictafsir.com/resource/commentary/1.13/4/segment/3> a st:Segment ;
    rdfs:label "Segment 3" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L2040" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.13/4/segment/3/segment/1> ;
    st:hasText "غَيْرِ مَعَ الْمَغْضُوبِ عَلَيْهِمْ بمعنى : سوى المغضوب عليهم خطأ ، إذ كَانَ قَدْ كر عَلَيْه الكلام بـ ( لا ) ، وكان يزعم أن غَيْرِ هنالك إِنَّمَا هِيَ بمعنى الجحد"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/sarfnahw> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/fragment/0a35d7b453b3>,
        <http://www.semantictafsir.com/resource/quran/verse/1/7/fragment/46cbac6c92de> .

<http://www.semantictafsir.com/resource/commentary/1.13/4/segment/3/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
