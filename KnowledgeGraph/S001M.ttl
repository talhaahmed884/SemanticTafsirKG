<http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1621" ;
    st:containsSegment <http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/1>,
        <http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/2>,
        <http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/3>,
        <http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/4> ;
    st:hasText "القرأة مجمعة عَلَى قراءة : غَيْرِ بجر الراء منها ، والخفض يأتيها من وجهين : أَحَدهمَا ، أن يَكُون : غَيْرِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/murad> .

<http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/1> a st:Segment ;
    rdfs:label "Segment 1" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1621" ;
    st:hasText "القرأة مجمعة"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/qmajority> .

<http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/2> a st:Segment ;
    rdfs:label "Segment 2" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L1622" ;
    st:hasText "غَيْرِ"@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/qiraat> .

<http://www.semantictafsir.com/resource/commentary/1.12/1/segment/1/segment/3> a st:Segment ;
