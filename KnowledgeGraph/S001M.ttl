<http://www.semantictafsir.com/resource/hadith/147> a hadith:Hadith ;
    rdfs:label "Hadith 147" ;
    dcterms:source "S001M/sure_1_section_1.1-1.14.xml#L390" ;
    hadith:follows <http://www.semantictafsir.com/resource/commentary/1.3/14> ;
    hadith:hasNarratorChain <http://www.semantictafsir.com/resource/hadith/147/chain/1> ;
    hadith:hasRootNarrator <http://www.semantictafsir.com/resource/hadith/147/chain/1/link/4/narrator> ;
    st:containsSegment <http://www.semantictafsir.com/resource/hadith/147/segment/1> ;
    st:hasHadithNo 147 ;
    st:hasLineBeginning <http://www.semantictafsir.com/resource/location/line/225> ;
    st:hasNote <http://www.semantictafsir.com/resource/hadith/147/note/1> ;
    st:hasText "حَدَّثَنَا الْقَاسِمُ بْنُ الْحَسَنِ ، قَالَ : حَدَّثَنَا الْحُسَيْنُ بْنُ دَاوُدَ ، قَالَ : حَدَّثَنَا حَجَّاجٌ ، عَنِ ابْنِ جُرَيْجٍ ، فِي قَوْلِهِ : \" رَبِّ الْعَالَمِينَ ، قَالَ : الْجِنُّ وَالإِنْسُ \""@ar ;
    st:hasTheme <http://www.semantictafsir.com/resource/theme/kalam>,
        <http://www.semantictafsir.com/resource/theme/lugha> ;
    st:refersTo <http://www.semantictafsir.com/resource/quran/verse/1/2/fragment/8cc50c90f535> .

