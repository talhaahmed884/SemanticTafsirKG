    <!-- http://www.semantictafsir.com/ontology/qari -->

    <owl:NamedIndividual rdf:about="http://www.semantictafsir.com/ontology/qari">
        <rdf:type rdf:resource="http://www.semantictafsir.com/ontology/NarratorType"/>
        <rdfs:comment xml:lang="en">A Qur&apos;an reciter (Qari) whose reading (qira&apos;a) is reported in the chain of transmission, e.g. one of the reciters whose variant readings Tabari cites.</rdfs:comment>
        <rdfs:label xml:lang="en">Qari</rdfs:label>
        <rdfs:label xml:lang="ar">قارئ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semantictafsir.com/ontology/rawi -->

    <owl:NamedIndividual rdf:about="http://www.semantictafsir.com/ontology/rawi">
        <rdf:type rdf:resource="http://www.semantictafsir.com/ontology/NarratorType"/>
        <rdfs:comment xml:lang="en">A transmitter of hadith, often from later generations.</rdfs:comment>
        <rdfs:label xml:lang="en">Rawi</rdfs:label>
        <rdfs:label xml:lang="ar">راوي</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q17638669"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semantictafsir.com/ontology/sahabi -->

    <owl:NamedIndividual rdf:about="http://www.semantictafsir.com/ontology/sahabi">
        <rdf:type rdf:resource="http://www.semantictafsir.com/ontology/NarratorType"/>
        <rdfs:comment xml:lang="en">A companion of the Prophet Muhammad.</rdfs:comment>
        <rdfs:label xml:lang="en">Sahabi</rdfs:label>
        <rdfs:label xml:lang="ar">صحابي</rdfs:label>
        <skos:closeMatch rdf:resource="http://www.wikidata.org/entity/Q188711"/>
    </owl:NamedIndividual>
    


    <!-- http://www.semantictafsir.com/ontology/shaykh -->

    <owl:NamedIndividual rdf:about="http://www.semantictafsir.com/ontology/shaykh">
        <rdf:type rdf:resource="http://www.semantictafsir.com/ontology/NarratorType"/>
        <rdfs:comment xml:lang="en">A scholar or teacher of hadith.</rdfs:comment>
        <rdfs:label xml:lang="en">Shaykh</rdfs:label>
        <rdfs:label xml:lang="ar">شيخ</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semantictafsir.com/ontology/unknown_rawi -->

    <owl:NamedIndividual rdf:about="http://www.semantictafsir.com/ontology/unknown_rawi">
        <rdf:type rdf:resource="http://www.semantictafsir.com/ontology/NarratorType"/>
        <rdfs:comment xml:lang="en">A hadith transmitter whose identity is uncertain.</rdfs:comment>
        <rdfs:label xml:lang="en">Unknown Rawi</rdfs:label>
    </owl:NamedIndividual>
    


    <!-- http://www.semantictafsir.com/ontology/unknown_sahabi -->

    <owl:NamedIndividual rdf:about="http://www.semantictafsir.com/ontology/unknown_sahabi">
        <rdf:type rdf:resource="http://www.semantictafsir.com/ontology/NarratorType"/>
        <rdfs:comment xml:lang="en">A companion of the Prophet whose identity is unknown.</rdfs:comment>
        <rdfs:label xml:lang="en">Unknown Sahabi</rdfs:label>
    </owl:NamedIndividual>
    


